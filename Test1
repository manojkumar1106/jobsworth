import { httpClient } from "../../utils/http/httpClient";

async function postPromotionData(method: string, endpoint: string, request: any, token: string, logger: any) {
  const sessionKey = getSessionKeyFromToken(token);
  const baseUrl = process.env.SPRINGBOOT_PROMOTION_BASE_ENDPOINT;
  const url = `${baseUrl}/api/promotions/${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      headers: { "Content-Type": "application/json" },
      body: method === "GET" ? undefined : { ...request, sessionKey },
    },
    logger
  );
}

