@Transactional
public UpdateSystemDiscountResponse updateSystemDiscount(UpdateSystemDiscountRequest request) {

    convertDatesToUtcIfPresent(request);
    Map<String, Object> systemDiscount = null;
    ObjectMapper objectMapper = new ObjectMapper();
    objectMapper.registerModule(new JavaTimeModule());
    SystemDiscount sdObj = new SystemDiscount();
    boolean needsApproval = Boolean.TRUE.equals(request.getManagerApprovalRequired());

    if (needsApproval) {
        CreateSystemDiscountRequest create = new CreateSystemDiscountRequest();
        BeanUtils.copyProperties(request, create);
        systemDiscount = systemDiscountDao.createSystemDiscount(create);
        if (systemDiscount == null) {
            throw new IllegalArgumentException("System discount not found for id=" + request.getSystemDiscountId());
        }
        sdObj = objectMapper.convertValue(systemDiscount, SystemDiscount.class);
        log.info("Created pending child {} for discount {}. Original UNTOUCHED.", sdObj.getParentId(), sdObj.getId());
        return new UpdateSystemDiscountResponse(sdObj.getId(), sdObj.getParentId(), status: "PENDING_APPROVAL");

    } else {
        systemDiscount = systemDiscountDao.updateSystemDiscount(request);
        if (systemDiscount == null) {
            throw new IllegalArgumentException("System discount not found for id=" + request.getSystemDiscountId());
        }
        sdObj = objectMapper.convertValue(systemDiscount, SystemDiscount.class);
        log.info("System discount updated id={} location={} amenity={}", request.getSystemDiscountId(), request.getLocationId(), request.getAmenityId());

        if (DiscountStatus.INACTIVE.name().equalsIgnoreCase(sdObj.getSystemDiscountStatus())) {
            // New status is INACTIVE — deactivate the associated rule instead of regenerating it
            Long ruleDefinitionId = ruleDefinitionDao.findByRuleTypeAndReferenceIdAndActiveTrue(
                    "SYSTEM_DISCOUNT", sdObj.getId()).get("rule_definition_id") != null
                    ? Long.valueOf(ruleDefinitionDao.findByRuleTypeAndReferenceIdAndActiveTrue(
                        "SYSTEM_DISCOUNT", sdObj.getId()).get("rule_definition_id").toString())
                    : null;

            if (ruleDefinitionId != null) {
                ruleDefinitionDao.deactivateRuleDefinition(ruleDefinitionId, request.getSessionKey());
                getEngineService().reloadRules();
                log.info("Rule deactivated for system discount id={}", sdObj.getId());
            } else {
                log.warn("No active rule found to deactivate for system discount id={}", sdObj.getId());
            }
        } else {
            droolsRuleService.generateSystemDiscountRule(sdObj, changedBy: "ADMIN", request.getSessionKey());
        }

        return new UpdateSystemDiscountResponse(sdObj.getId(), sdObj.getParentId(), sdObj.getSystemDiscountStatus());
    }
}
