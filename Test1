package hlt.promo.engine.dto;

import hlt.promo.engine.enums.DiscountType;
import jakarta.validation.constraints.*;
import lombok.Data;

import java.math.BigDecimal;
import java.time.LocalDateTime;

@Data
public class CreateSystemDiscountRequest {

    private String sessionKey;   // set by controller from JWT, not sent by client

    @NotNull
    private Long locationId;

    @NotNull
    private Long amenityId;

    @NotBlank @Size(max = 254)
    private String title;

    @Size(max = 254)
    private String displayName;

    @Size(max = 254)
    private String discountDescription;

    @NotNull
    private DiscountType discountType;

    @NotNull @DecimalMin("0.01")
    private BigDecimal amount;

    private Integer minQuantity;
    private String userType;
    private Boolean channelPos;
    private Boolean channelWeb;

    @NotNull
    private LocalDateTime startDate;

    @NotNull
    private LocalDateTime endDate;

    private Boolean stackable;

    @Size(max = 254)
    private String stackGroup;

    private Integer priority;
    private Boolean managerApprovalRequired;

    @Size(max = 254)
    private String icon;

    private String systemDiscountStatus;
}
