package com.hlt.api.service.impl;

import com.hlt.api.dao.SalesFunnelDao;
import com.hlt.api.dtos.request.TicketRequest;
import com.hlt.api.service.ISalesFunnelService;
import com.hlt.api.util.TimezoneConverter;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.OffsetDateTime;
import java.time.ZoneId;
import java.util.List;
import java.util.Map;

@Slf4j
@Service
public class SalesFunnelServiceImpl implements ISalesFunnelService {

    @Autowired
    private SalesFunnelDao salesFunnelDao;

    @Override
    public List<Map<String, Object>> getFunnelAmenities(TicketRequest req) {
        log.info("Fetching funnel amenities for locationId: {}", req.getLocationId());
        return salesFunnelDao.getFunnelAmenities(req);
    }

    @Override
    @Transactional
    public Integer createSalesFunnel(TicketRequest req) {
        log.info("Creating Sales Funnel: {}", req.getSalesFunnelName());

        normalizeCutoffToUtc(req);

        Integer newId = salesFunnelDao.createSalesFunnel(req);
        req.setSalesFunnelId(newId);

        insertAmenities(req);

        return newId;
    }

    @Override
    @Transactional
    public Integer updateSalesFunnel(TicketRequest req) {
        log.info("Updating Sales Funnel: {}", req.getSalesFunnelId());

        normalizeCutoffToUtc(req);

        Integer result = salesFunnelDao.updateSalesFunnel(req);

        // Clear + re-insert keeps funnelOrder in sync with the incoming amenityIds list.
        salesFunnelDao.clearSalesFunnelAmenities(req);
        insertAmenities(req);

        return result;
    }

    @Override
    @Transactional
    public void deleteSalesFunnel(TicketRequest req) {
        log.info("Soft-deleting Sales Funnel: {}", req.getSalesFunnelId());
        salesFunnelDao.deleteSalesFunnel(req);
    }

    private void insertAmenities(TicketRequest req) {
        List<Long> amenityIds = req.getAmenityIds();
        if (amenityIds == null || amenityIds.isEmpty()) {
            return;
        }
        for (int i = 0; i < amenityIds.size(); i++) {
            // List index becomes funnelOrder, per spec.
            salesFunnelDao.addSalesFunnelAmenity(req, amenityIds.get(i), i);
        }
    }

    /**
     * Converts salesCutoffLocalTime into salesCutoffUtc using the timezone of the
     * funnel's own location (looked up from Physical_Address via
     * SalesFunnelDao.getTimezoneByLocation, same as SystemDiscountDao does),
     * rather than trusting the client to send an offset. Skipped if the client
     * already sent salesCutoffUtc directly.
     *
     * Note: because a recurring daily cutoff can straddle a DST transition later
     * in the year, this resolves the offset against "today" at write time. If
     * the business wants a cutoff whose local wall-clock time never drifts
     * across DST boundaries, this is the right approach; if it should instead
     * pin to a fixed UTC offset forever, that needs a different rule - flag this
     * with the team if it matters for sales_cutoff semantics.
     */
    private void normalizeCutoffToUtc(TicketRequest req) {
        if (req.getSalesCutoffUtc() != null) {
            return;
        }
        if (req.getSalesCutoffLocalTime() == null) {
            return;
        }

        String timezone = salesFunnelDao.getTimezoneByLocation(req);
        TimezoneConverter.validateTimezone(timezone);

        LocalDateTime localDateTime = LocalDate.now(ZoneId.of(timezone)).atTime(req.getSalesCutoffLocalTime());
        OffsetDateTime utc = TimezoneConverter.toUtc(localDateTime, timezone);
        req.setSalesCutoffUtc(utc.toLocalTime());
    }
}



