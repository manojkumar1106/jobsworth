export async function verifyOtpAuth(
    userName: string,
    session: string,
    otp: string,
    logger: any,
    tenantId: string,
) {
    const clientId = process.env.AWS_CUST_CLIENT_ID;
    const region = process.env.AWS_REGION;
    const userPoolId = process.env.AWS_CUST_USERPOOL_ID;
    const secretHash = getSecretHash(userName);
    const client = new CognitoIdentityProviderClient(
        { region });

    try {
        // Respond to custom challenge with OTP
        const initCommand = new 
            AdminRespondToAuthChallengeCommand({
                UserPoolId: userPoolId,
                ClientId: clientId,
                ChallengeName: "CUSTOM_CHALLENGE",
                Session: session,
                ChallengeResponses: {
                    USERNAME: userName,
                    ANSWER: otp,
                    SECRET_HASH: secretHash,
                },
                ClientMetadata: {
                    tenantId: tenantId,
                },
            });

        const response = await client.send(initCommand);

        if (response.AuthenticationResult?.AccessToken) {
            const accessToken = 
                response.AuthenticationResult.AccessToken;
            const idToken = 
                response.AuthenticationResult.IdToken || "";
            const refreshToken = 
                response.AuthenticationResult.RefreshToken;
            
            // Extract cognitoUserId
            const cognitoUserId = 
                jwtDecode(idToken)?.sub;

            logger.info("Token successfully cached in Redis");

            // Check new vs existing user
            const isNewUser = await checkIsNewUser(
                userName, tenantId);

            let sessionKey = "";

            if (isNewUser) {
                // NEW USER → UUID guest session
                const guestKey = crypto.randomUUID();
                await startGuestSession(guestKey, logger);
                sessionKey = guestKey;
            } else {
                // EXISTING USER → JWT stable key
                const sessionResponse = 
                    await startSession(
                        { type: "customer" },
                        accessToken,
                        logger
                    );
                sessionKey = 
                    sessionResponse?.data || "";
            }

            return { 
                cognitoUserId,
                accessToken,
                idToken,
                refreshToken,
                sessionKey,
                isNewUser  // ← frontend routing
            };
        }

        throw new Error(
            "AWS did not return a OTP Session.");

    } catch (error: any) {
        console.log(
            `Error: ${JSON.stringify(error)}`);
        throw new Error(
            `AWS Error: ${error.message}`);
    }
}





async function checkIsNewUser(
    email: string,
    tenantId: string
): Promise<boolean> {
    try {
        // Call Java API to check DB
        const response = await fetch(
            `${process.env.API_URL}/api/v1/customer/exists`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-tenant-id': tenantId
                },
                body: JSON.stringify({ email })
            }
        );
        const data = await response.json();
        return !data.exists; // true = new user
    } catch (error) {
