   public List<PromotionResponse> getAllPromotions(String sessionKey) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", sessionKey);
        List<Map<String, Object>> rows = executeList("usp_Get_Promotions", params);
        return rows.stream().map(this::mapRow).collect(Collectors.toList());
    }


