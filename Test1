package hlt.promo.engine.controller;

import hlt.promo.engine.service.DateTimeConverter;
import hlt.promo.engine.service.TimeZoneService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

import java.time.Instant;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.time.ZonedDateTime;

@RestController
@RequestMapping("/test")
@RequiredArgsConstructor
public class TestTimeZoneController {

    private final TimeZoneService timeZoneService;
    private final DateTimeConverter dateTimeConverter;

    @GetMapping("/convert")
    public String testConvert(
            @RequestParam Integer locationId,
            @RequestParam String localDateTime) {

        ZoneId zoneId = timeZoneService.getLocationZone(locationId);
        LocalDateTime ldt = LocalDateTime.parse(localDateTime);

        Instant utc = dateTimeConverter.toUtc(ldt, zoneId);
        ZonedDateTime backToLocal = dateTimeConverter.toLocal(utc, zoneId);

        return "Zone: " + zoneId
                + " | UTC: " + utc
                + " | Back to local: " + backToLocal;
    }
}




package hlt.promo.engine.config;

import hlt.promo.engine.model.Location;
import hlt.promo.engine.repository.LocationRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.boot.CommandLineRunner;
import org.springframework.stereotype.Component;

@Component
@RequiredArgsConstructor
public class LocationSeeder implements CommandLineRunner {

    private final LocationRepository locationRepository;

    @Override
    public void run(String... args) {
        if (locationRepository.count() == 0) {
            locationRepository.save(buildLocation("New York Store", "America/New_York"));
            locationRepository.save(buildLocation("Chicago Store", "America/Chicago"));
            locationRepository.save(buildLocation("Los Angeles Store", "America/Los_Angeles"));
            locationRepository.save(buildLocation("Phoenix Store", "America/Phoenix"));
            locationRepository.save(buildLocation("London Store", "Europe/London"));
        }
    }

    private Location buildLocation(String name, String tz) {
        Location loc = new Location();
        loc.setLocationName(name);
        loc.setRemoved(false);
        loc.setTimeZone(tz);
        return loc;
    }
}
