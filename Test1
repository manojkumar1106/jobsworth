if (Boolean.TRUE.equals(updated.getManagerApprovalRequired())
        && existing.getApprovalStatus() == ApprovalStatus.APPROVED) {
    updated.setApprovalStatus(ApprovalStatus.PENDING);
    updated.setActive(false); // pull it from active rotation until re-approved
}




@Transactional
public SystemDiscount approve(Long id, String approvedBy) {
    SystemDiscount discount = systemDiscountRepository.findById(id)
            .orElseThrow(() -> new RuntimeException("SystemDiscount not found: " + id));

    if (!Boolean.TRUE.equals(discount.getManagerApprovalRequired())) {
        throw new RuntimeException("SystemDiscount [" + id + "] does not require approval.");
    }
    if (discount.getApprovalStatus() == ApprovalStatus.APPROVED) {
        throw new RuntimeException("SystemDiscount [" + id + "] is already approved.");
    }

    discount.setApprovalStatus(ApprovalStatus.APPROVED);
    SystemDiscount saved = systemDiscountRepository.save(discount);

    log.info("SystemDiscount id={} approved by={}", saved.getId(), approvedBy);

    if (saved.getStatus() == DiscountStatus.PUBLISHED) {
        droolsRuleService.generateSystemDiscountRule(saved, approvedBy);
    }

    return saved;
}

@Transactional
public SystemDiscount reject(Long id, String rejectedBy) {
    SystemDiscount discount = systemDiscountRepository.findById(id)
            .orElseThrow(() -> new RuntimeException("SystemDiscount not found: " + id));

    discount.setApprovalStatus(ApprovalStatus.REJECTED);
    discount.setActive(false);

    SystemDiscount saved = systemDiscountRepository.save(discount);
    log.info("SystemDiscount id={} rejected by={}", saved.getId(), rejectedBy);

    return saved;
}




@Transactional
public SystemDiscount create(SystemDiscount discount, String createdBy) {

    if (discount.getStatus() == null) {
        discount.setStatus(DiscountStatus.DRAFT);
    }

    // NEW: set approval status based on whether approval is required
    // (prePersist() also defaults this, but setting it here keeps the
    // in-memory object consistent before save() triggers prePersist)
    if (Boolean.TRUE.equals(discount.getManagerApprovalRequired())) {
        discount.setApprovalStatus(ApprovalStatus.PENDING);
    } else {
        discount.setApprovalStatus(ApprovalStatus.APPROVED);
    }

    discount.setActive(discount.getStatus() == DiscountStatus.PUBLISHED);
    discount.setCreatedBy(createdBy);

    SystemDiscount saved = systemDiscountRepository.save(discount);
    log.info("SystemDiscount created id={} status={} approvalStatus={}",
            saved.getId(), saved.getStatus(), saved.getApprovalStatus());

    // CHANGED: only generate the rule if published AND approved
    if (saved.getStatus() == DiscountStatus.PUBLISHED
            && saved.getApprovalStatus() == ApprovalStatus.APPROVED) {
        droolsRuleService.generateSystemDiscountRule(saved, createdBy);
    } else if (saved.getStatus() == DiscountStatus.PUBLISHED) {
        log.info("SystemDiscount id={} published but awaiting manager approval — rule not generated",
                saved.getId());
    }

    return saved;
}


@PostMapping("/system-discounts/{id}/reject")
public ResponseEntity<SystemDiscount> reject(@PathVariable Long id,
                                              @RequestParam String rejectedBy) {
    return ResponseEntity.ok(systemDiscountService.reject(id, rejectedBy));
}

