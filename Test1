input CreatePhysicalAddress {
  type: String!
  locationId: Int!
  streetNumber: String!
  streetName: String!
  city: String!
  state: String!
  postalCode: String!
  countryCode: String!
  latitude: Float
  longitude: Float
  timezone: String
}

type Mutation {
  createPhysicalAddress(request: CreatePhysicalAddress): SessionResponse
}



import {
  createPhysicalAddress
} from "../../service/location/physicalAddressService";

export const physicalAddressResolvers = {
  Mutation: {
    createPhysicalAddress: async (_: any, { request }: any, ctx: any) => {
      ctx.logger.info("Create Physical Address", { request });
      return await createPhysicalAddress(request, ctx.token, ctx.logger);
    },
  },
};



import { httpClient } from "../../utils/http/httpClient";

async function postAddressData(method: string, endpoint: string, request: any, token: string, logger: any) {
  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/physicaladdress${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`,
      },
      body: method === "GET" ? undefined : request,
      logger,
    },
  );
}

export async function createPhysicalAddress(request: any, token: string, logger: any) {
  return await postAddressData("POST", "/create", request, token, logger);
}




