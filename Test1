@Slf4j
@Service
public class OtpAuthService {

    private final JavaMailSender mailSender;
    private final CognitoIdentityProviderClient cognitoClient;
    private final IAdminService adminService;
    private final AuthDao authDao;
    private final AdminDao adminDao;

    private final SecureRandom secureRandom = new SecureRandom();

    @Value("${cognito.user-pool-id}")
    private String userPoolId;

    @Value("${cognito.client-id}")
    private String clientId;

    @Value("${cognito.client-secret}")
    private String clientSecret;

    @Value("${cognito.hosted-ui-url}")
    private String hostedUiUrl;

    @Value("${cognito.admin-client-id}")
    private String adminClientId;

    @Value("${cognito.redirect-uri}")
    private String redirectUri;

    @Value("${spring.mail.fromEmail}")
    private String fromMail;

    public OtpAuthService(
            JavaMailSender mailSender,
            @Qualifier("customerCognitoClient") CognitoIdentityProviderClient cognitoClient,
            IAdminService adminService,
            AuthDao authDao,
            AdminDao adminDao
    ) {
        this.mailSender = mailSender;
        this.cognitoClient = cognitoClient;
        this.adminService = adminService;
        this.authDao = authDao;
        this.adminDao = adminDao;
    }

    /*
     * ===============================================================
     * STEP 1: INITIATE OTP (Cognito CUSTOM_AUTH, tenantId mandatory)
     * ===============================================================
     */
    public Map<String, Object> initiateOtpAuth(SendEmailOtp request, String tenantId) {

        validateEmail(request.getEmail());
        if (tenantId == null || tenantId.isBlank()) {
            throw new BadRequestException("x-tenant-id header is required");
        }
        String email = request.getEmail().trim().toLowerCase();

        ensureCognitoIdentityExistsAndTenantMatches(email, tenantId);

        String secretHash = calculateSecretHash(email);
        Map<String, String> authParams = new HashMap<>();
        authParams.put("USERNAME", email);
        authParams.put("SECRET_HASH", secretHash);

        try {
            log.info("Initiating CUSTOM_AUTH flow for {}", sanitizeForLog(email));

            AdminInitiateAuthResponse response = cognitoClient.adminInitiateAuth(
                    AdminInitiateAuthRequest.builder()
                            .userPoolId(userPoolId)
                            .clientId(clientId)
                            .authFlow(AuthFlowType.CUSTOM_AUTH)
                            .authParameters(authParams)
                            .clientMetadata(Map.of("tenantId", tenantId))
                            .build()
            );

            if (response.challengeName() != null) {
                return Map.of(
                        "challengeName", response.challengeNameAsString(),
                        "session", response.session(),
                        "userName", email
                );
            }

            throw new BadRequestException("AWS did not return an OTP session");

        } catch (BadRequestException ex) {
            throw ex;
        } catch (Exception ex) {
            log.error("Failed to initiate OTP for {}", sanitizeForLog(email), ex);
            throw new BadRequestException("Failed to initiate OTP: " + ex.getMessage());
        }
    }

    /*
     * ===============================================================
     * STEP 2: VERIFY OTP + LOGIN + SESSION START
     * ===============================================================
     */
    @Transactional
    public Map<String, Object> verifyOtpAndLogin(VerifyEmailOtp request, String tenantId) {

        validateVerifyRequest(request);
        if (tenantId == null || tenantId.isBlank()) {
            throw new BadRequestException("x-tenant-id header is required");
        }

        String email = request.getEmail().trim().toLowerCase();
        String otp = request.getOtp().trim();
        String session = request.getSession();
        String secretHash = calculateSecretHash(email);

        Map<String, String> challengeResponses = new HashMap<>();
        challengeResponses.put("USERNAME", email);
        challengeResponses.put("ANSWER", otp);
        challengeResponses.put("SECRET_HASH", secretHash);

        AdminRespondToAuthChallengeResponse response;
        try {
            response = cognitoClient.adminRespondToAuthChallenge(
                    AdminRespondToAuthChallengeRequest.builder()
                            .userPoolId(userPoolId)
                            .clientId(clientId)
                            .challengeName(ChallengeNameType.CUSTOM_CHALLENGE)
                            .session(session)
                            .challengeResponses(challengeResponses)
                            .clientMetadata(Map.of("tenantId", tenantId))
                            .build()
            );
        } catch (Exception ex) {
            log.error("OTP verification failed for {}", sanitizeForLog(email), ex);
            throw new IllegalArgumentException("Invalid or expired OTP");
        }

        if (response.authenticationResult() == null) {
            throw new IllegalArgumentException("Invalid or expired OTP");
        }

        AuthenticationResultType authResult = response.authenticationResult();

        cognitoClient.adminUpdateUserAttributes(
                AdminUpdateUserAttributesRequest.builder()
                        .userPoolId(userPoolId)
                        .username(email)
                        .userAttributes(
                                AttributeType.builder().name("email_verified").value("true").build()
                        )
                        .build()
        );

        AdminGetUserResponse userResponse = cognitoClient.adminGetUser(
                AdminGetUserRequest.builder().userPoolId(userPoolId).username(email).build()
        );
        String tenantAttr = getTenantAttribute(userResponse)
                .orElseThrow(() -> new BadRequestException("Tenant attribute missing for customer"));

        if (!tenantAttr.equalsIgnoreCase(tenantId)) {
            throw new BadRequestException("Customer is not registered for tenant: " + tenantId);
        }

        String jwtSessionKey = extractStableSessionKey(authResult.accessToken());

        boolean isNewUser = isNewCustomer(jwtSessionKey);

        String sessionKey = null;
        if (isNewUser) {
            sessionKey = UUID.randomUUID().toString();
            authDao.startGuestSession(sessionKey, "CUSTOMER_GUEST");

            TicketRequest upsertRequest = new TicketRequest();
            upsertRequest.setType("CUSTOMER");
            upsertRequest.setSessionKey(sessionKey);
            upsertRequest.setCognitoUserId(userResponse.username());
            upsertRequest.setEmail(email);
            upsertRequest.setPhone(null);
            upsertRequest.setFirstName(null);
            upsertRequest.setLastName(null);
            upsertRequest.setDateOfBirth(null);

            adminService.upsertUser(upsertRequest);
        }

        authDao.startClientCustomerSession(
                userResponse.username(), jwtSessionKey, "CUSTOMER_LOGIN", sessionKey
        );

        boolean isProfileComplete = checkProfileCompletion(jwtSessionKey);

        return Map.of(
                "status", "SUCCESS",
                "accessToken", authResult.accessToken(),
                "idToken", authResult.idToken(),
                "tokenType", authResult.tokenType(),
                "sessionKey", jwtSessionKey,
                "cognitoUserId", userResponse.username(),
                "isNewUser", isNewUser,
                "isProfileComplete", isProfileComplete
        );
    }

    /*
     * ===============================================================
     * ENSURE COGNITO IDENTITY EXISTS + TENANT MATCHES (fail fast)
     * ===============================================================
     */
    private void ensureCognitoIdentityExistsAndTenantMatches(String email, String tenantId) {
        try {
            AdminGetUserResponse existing = cognitoClient.adminGetUser(
                    AdminGetUserRequest.builder().userPoolId(userPoolId).username(email).build()
            );

            String existingTenant = getTenantAttribute(existing)
                    .orElseThrow(() -> new BadRequestException("Tenant attribute missing for customer"));

            if (!existingTenant.equalsIgnoreCase(tenantId)) {
                throw new BadRequestException("Customer is not registered for tenant: " + tenantId);
            }

            log.info("Existing Cognito user {} matches tenant {}, proceeding to CUSTOM_AUTH",
                    sanitizeForLog(email), tenantId);

        } catch (UserNotFoundException ex) {
            log.info("First-time user {}, creating minimal Cognito stub for tenant {}",
                    sanitizeForLog(email), tenantId);
            cognitoClient.adminCreateUser(
                    AdminCreateUserRequest.builder()
                            .userPoolId(userPoolId)
                            .username(email)
                            .userAttributes(
                                    AttributeType.builder().name("email").value(email).build(),
                                    AttributeType.builder().name("email_verified").value("false").build(),
                                    AttributeType.builder().name("custom:ActiveTenantId").value(tenantId).build()
                            )
                            .messageAction(MessageActionType.SUPPRESS)
                            .build()
            );
        }
    }

    private Optional<String> getTenantAttribute(AdminGetUserResponse response) {
        return response.userAttributes().stream()
                .filter(a -> "custom:ActiveTenantId".equalsIgnoreCase(a.name()))
                .map(AttributeType::value)
                .findFirst();
    }

    /*
     * ===============================================================
     * SESSION KEY / PROFILE HELPERS
     * ===============================================================
     */
    private String extractStableSessionKey(String accessToken) {
        try {
            String payload = accessToken.split("\\.")[1];
            String decoded = new String(Base64.getUrlDecoder().decode(payload), StandardCharsets.UTF_8);
            ObjectMapper mapper = new ObjectMapper();
            Map<?, ?> claims = mapper.readValue(decoded, Map.class);
            Object originJti = claims.get("origin_jti");
            if (originJti != null) return originJti.toString();
            return claims.get("jti").toString();
        } catch (Exception ex) {
            log.warn("Could not extract origin_jti, fallback to UUID");
            return UUID.randomUUID().toString();
        }
    }

    private boolean isNewCustomer(String sessionKey) {
        CustomerProfileResponseDTO customerProfile = adminDao.getCustomerProfile(sessionKey);
        return customerProfile == null || customerProfile.getCustomerProfileDTO() == null;
    }

    private boolean checkProfileCompletion(String sessionKey) {
        CustomerProfileResponseDTO customerProfile = adminDao.getCustomerProfile(sessionKey);
        if (customerProfile == null || customerProfile.getCustomerProfileDTO() == null) return false;
        return StringUtils.isNotBlank(customerProfile.getCustomerProfileDTO().getFirstName())
                && StringUtils.isNotBlank(customerProfile.getCustomerProfileDTO().getLastName());
    }

    /*
     * ===============================================================
     * OTP GENERATION (KEPT — used by CognitoAdminService for temp passwords)
     * ===============================================================
     */
    public String generateOtp() {
        String upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        String lower = "abcdefghijklmnopqrstuvwxyz";
        String digits = "0123456789";
        String special = "!@#$%";
        String all = upper + lower + digits + special;

        StringBuilder otp = new StringBuilder();
        otp.append(upper.charAt(secureRandom.nextInt(upper.length())));
        otp.append(lower.charAt(secureRandom.nextInt(lower.length())));
        otp.append(digits.charAt(secureRandom.nextInt(digits.length())));
        otp.append(special.charAt(secureRandom.nextInt(special.length())));

        for (int i = 0; i < 4; i++) {
            otp.append(all.charAt(secureRandom.nextInt(all.length())));
        }

        List<Character> chars = new ArrayList<>();
        for (char c : otp.toString().toCharArray()) {
            chars.add(c);
        }
        Collections.shuffle(chars, secureRandom);

        StringBuilder finalOtp = new StringBuilder();
        for (char c : chars) {
            finalOtp.append(c);
        }
        return finalOtp.toString();
    }

    /*
     * ===============================================================
     * EMAIL (KEPT — used by CognitoAdminService for temp password welcome email)
     * ===============================================================
     */
    public void sendEmail(String toEmail, String otp, String tempPassword) {
        String subject = "Your Login OTP";
        String bodyHtml;
        if (tempPassword != null && !tempPassword.isEmpty()) {
            subject = "Welcome - Your Account Details";
            String loginLink = hostedUiUrl + "?client_id=" + adminClientId + "&response_type=code"
                    + "&scope=email+openid+phone" + "&redirect_uri=" + redirectUri;
            bodyHtml = "<html><body>"
                    + "<h3>Welcome to Our Platform!</h3>"
                    + "<p>Your account has been created by an admin.<p>"
                    + "<p><b>Username:</b> " + toEmail + "</p>"
                    + "<p><b>Temporary Password:</b> " + tempPassword + "</p>"
                    + "<p>Please click the link below to login and set your new password:</p>"
                    + "<a href='" + loginLink + "' "
                    + "style='background:#007bff;color:white;padding:10px 20px;"
                    + "text-decoration:none;border-radius:5px;'>Login Here</a>"
                    + "<br><br><p>This temporary password will expire after first use.</p>"
                    + "</body></html>";
        } else {
            bodyHtml = "<html><body><h3>Your Login OTP</h3><p>Your One-Time Password (OTP) for login is: <b>"
                    + otp + "</b></p><p>This OTP will expire in 5 minutes.</p></body></html>";
        }
        try {
            MimeMessage message = mailSender.createMimeMessage();
            MimeMessageHelper helper = new MimeMessageHelper(message, true, "UTF-8");
            helper.setFrom(fromMail);
            helper.setTo(toEmail);
            helper.setSubject(subject);
            helper.setText(bodyHtml, true);
            mailSender.send(message);
        } catch (MessagingException e) {
            log.error("Failed to send email to {}", toEmail, e);
            throw new RuntimeException("Failed to send email", e);
        }
    }

    private String calculateSecretHash(String username) {
        try {
            String message = username + clientId;
            SecretKeySpec signingKey = new SecretKeySpec(
                    clientSecret.getBytes(StandardCharsets.UTF_8), "HmacSHA256"
            );
            Mac mac = Mac.getInstance("HmacSHA256");
            mac.init(signingKey);
            byte[] rawHmac = mac.doFinal(message.getBytes(StandardCharsets.UTF_8));
            return Base64.getEncoder().encodeToString(rawHmac);
        } catch (Exception ex) {
            throw new RuntimeException("Error calculating secret hash", ex);
        }
    }

    private void validateEmail(String email) {
        if (email == null || email.isBlank()) {
            throw new IllegalArgumentException("Email required");
        }
        if (!email.matches("^[\\w.-]+@[\\w.-]+\\.[a-zA-Z]{2,}$")) {
            throw new IllegalArgumentException("Invalid email");
        }
    }

    private void validateVerifyRequest(VerifyEmailOtp request) {
        validateEmail(request.getEmail());
        if (request.getOtp() == null || request.getOtp().isBlank()) {
            throw new IllegalArgumentException("OTP required");
        }
        if (request.getSession() == null || request.getSession().isBlank()) {
            throw new IllegalArgumentException("Session required");
        }
    }

    private String sanitizeForLog(String value) {
        return value == null ? "null" : value.replaceAll("[\r\n\t]", "_");
    }
}








