    /** Proc with an OUT param holding a generated id. */
    protected Integer executeReturnId(String procName, String outParamName,
                                      Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        Object value = out.get(outParamName);
        return value != null ? ((Number) value).intValue() : null;
    }

    /** Proc with a single OUT param returned as String. */
    protected String executeReturnType(String procName, String outParamName,
                                       Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        return String.valueOf(out.get(outParamName));
    }

    /** Proc returning an unnamed result set as raw maps. */
    @SuppressWarnings("unchecked")
    protected List<Map<String, Object>> executeList(String procName,
                                                    Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        List<Map<String, Object>> rows = (List<Map<String, Object>>) out.get("#result-set-1");
        return rows != null ? rows : Collections.emptyList();
    }
