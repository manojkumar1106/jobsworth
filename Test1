import { httpClient } from "../../utils/http/httpClient";

async function callAddressApi(method: string, endpoint: string, request: any, token: string, logger: any) {
  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/physicaladdress${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`,
      },
      // NOTE: unlike a typical REST client, this always sends the body —
      // even for GET — because the Java controller's /getbylocation is a
      // @GetMapping that still expects @RequestBody TicketRequest req.
      // Dropping the body on GET (as the old postAddressData did) would
      // silently send a null request to that endpoint.
      body: request,
    },
    logger,
  );
}

export async function createPhysicalAddress(request: any, token: string, logger: any) {
  return await callAddressApi("POST", "/create", request, token, logger);
}

export async function updatePhysicalAddress(request: any, token: string, logger: any) {
  return await callAddressApi("PUT", "/update", request, token, logger);
}

export async function getPhysicalAddress(request: any, token: string, logger: any) {
  return await callAddressApi("GET", "/getbylocation", request, token, logger);
}






import {
  createPhysicalAddress,
  updatePhysicalAddress,
  getPhysicalAddress,
} from "../../service/physicaladdress/physicalAddressService";

export const physicalAddressResolvers = {
  Mutation: {
    createPhysicalAddress: async (_: any, { request }: any, ctx: any) => {
      ctx.logger.info("Create Physical Address", { request });
      return await createPhysicalAddress(request, ctx.token, ctx.logger);
    },
    updatePhysicalAddress: async (_: any, { request }: any, ctx: any) => {
      ctx.logger.info("Update Physical Address", { request });
      return await updatePhysicalAddress(request, ctx.token, ctx.logger);
    },
  },
  Query: {
    physicalAddress: async (_: any, { request }: any, ctx: any) => {
      ctx.logger.info("Get Physical Address", { request });
      return await getPhysicalAddress(request, ctx.token, ctx.logger);
    },
  },
};



