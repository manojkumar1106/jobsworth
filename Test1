package hlt.promo.engine.service;

import hlt.promo.engine.dao.PromotionDao;
import hlt.promo.engine.dao.SystemDiscountDao;
import hlt.promo.engine.dto.CreatePromotionRequest;
import hlt.promo.engine.exception.ValidationException;
import hlt.promo.engine.util.TimezoneConverter;
import lombok.RequiredArgsConstructor;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
@RequiredArgsConstructor
public class PromotionServiceNew {

    private static final Logger log = LoggerFactory.getLogger(PromotionServiceNew.class);

    private final SystemDiscountDao systemDiscountDao;
    private final PromotionDao promotionDao;

    @Transactional
    public void createPromotion(CreatePromotionRequest request) {

        if (!request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        String timezone = systemDiscountDao.getTimezoneByLocation(
                request.getSessionKey(), request.getLocationId().intValue());

        request.setStartDate(
                TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
        request.setEndDate(
                TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());

        promotionDao.createPromotion(request);

        log.info("Promotion created location={} amenity={} promoCode={}",
                request.getLocationId(), request.getAmenityId(), request.getPromoCode());
    }

    @Transactional
    public void updatePromotion(CreatePromotionRequest request) {

        // Bean Validation (OnUpdate group) already guarantees promotionId is present here.
        // Everything else is optional — only validate ordering if both dates were sent.
        if (request.getStartDate() != null && request.getEndDate() != null
                && !request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        // Only need timezone conversion if a date is actually being updated
        if (request.getStartDate() != null || request.getEndDate() != null) {

            if (request.getLocationId() == null) {
                throw new ValidationException(
                        "locationId is required to resolve timezone when updating start/end date");
            }

            String timezone = systemDiscountDao.getTimezoneByLocation(
                    request.getSessionKey(), request.getLocationId().intValue());

            if (request.getStartDate() != null) {
                request.setStartDate(
                        TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
            }
            if (request.getEndDate() != null) {
                request.setEndDate(
                        TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());
            }
        }

        promotionDao.updatePromotion(request);

        log.info("Promotion updated promotionId={} location={} amenity={} promoCode={}",
                request.getPromotionId(), request.getLocationId(),
                request.getAmenityId(), request.getPromoCode());
    }
}




