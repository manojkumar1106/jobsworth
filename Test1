CREATE TABLE IF NOT EXISTS client1.Rule_Definitions (
    Rule_Definition_Id  BIGINT NOT NULL AUTO_INCREMENT,
    Rule_Name            VARCHAR(255) NOT NULL,
    Rule_Type             VARCHAR(255) NOT NULL,
    Reference_Id           BIGINT NOT NULL,
    DRL_Content            LONGTEXT,
    Version                INT DEFAULT 1,
    Is_Active               BIT NOT NULL DEFAULT 1,
    Created_By              VARCHAR(255),
    Created_At               DATETIME,
    Updated_At                DATETIME,
    PRIMARY KEY (Rule_Definition_Id),
    KEY idx_rule_type_reference (Rule_Type, Reference_Id, Is_Active)
);
