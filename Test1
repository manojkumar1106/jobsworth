package hlt.promo.engine.controller;

import hlt.promo.engine.dto.ApiResponse;
import hlt.promo.engine.dto.CreatePromotionRequest;
import hlt.promo.engine.service.PromotionServiceNew;
import hlt.promo.engine.validation.OnCreate;
import hlt.promo.engine.validation.OnUpdate;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.validation.annotation.Validated;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/promotions")
public class PromotionController {

    @Autowired
    PromotionServiceNew promotionServiceNew;

    @PostMapping("/create")
    public ApiResponse<?> create(@RequestBody @Validated(OnCreate.class) CreatePromotionRequest promotion) {
        promotionServiceNew.createPromotion(promotion);
        return ApiResponse.success("Promotion Created", null);
    }

    @PutMapping("/update")
    public ApiResponse<?> update(@RequestBody @Validated(OnUpdate.class) CreatePromotionRequest promotion) {
        promotionServiceNew.updatePromotion(promotion);
        return ApiResponse.success("Promotion Updated", null);
    }
}

