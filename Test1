package hlt.promo.engine.controller;

import hlt.promo.engine.dto.AmenityResponse;
import hlt.promo.engine.dto.CreateAmenityRequest;
import hlt.promo.engine.service.AmenityService;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/api/amenity")
@RequiredArgsConstructor
public class AmenityController {

    private final AmenityService amenityService;

    @PostMapping
    public ResponseEntity<String> create(
            @RequestBody CreateAmenityRequest request) {

        amenityService.create(request);
        return ResponseEntity.ok("Amenity created successfully");
    }

    @GetMapping
    public ResponseEntity<List<AmenityResponse>> getAll() {
        return ResponseEntity.ok(amenityService.getAll());
    }
}



package hlt.promo.engine.service;

import hlt.promo.engine.dto.AmenityResponse;
import hlt.promo.engine.dto.CreateAmenityRequest;
import hlt.promo.engine.model.Amenity;
import hlt.promo.engine.repository.AmenityRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import java.time.ZoneId;
import java.time.ZonedDateTime;
import java.util.List;
import java.util.stream.Collectors;

@Service
@RequiredArgsConstructor
public class AmenityService {

    private final TimeZoneService timeZoneService;
    private final DateTimeConverter dateTimeConverter;
    private final AmenityRepository amenityRepository;

    public void create(CreateAmenityRequest request) {
        // ... existing create logic unchanged
    }

    public List<AmenityResponse> getAll() {

        List<Amenity> amenities = amenityRepository.findAll();

        return amenities.stream()
                .map(this::toResponse)
                .collect(Collectors.toList());
    }

    private AmenityResponse toResponse(Amenity amenity) {

        ZoneId zoneId = timeZoneService.getLocationZone(amenity.getLocationId());

        ZonedDateTime startLocal =
                dateTimeConverter.toLocal(amenity.getStartDateTimeUtc(), zoneId);

        ZonedDateTime endLocal =
                dateTimeConverter.toLocal(amenity.getEndDateTimeUtc(), zoneId);

        return new AmenityResponse(
                amenity.getAmenityId(),
                amenity.getAmenityName(),
                amenity.getLocationId(),
                zoneId.getId(),
                startLocal,
                endLocal
        );
    }
}




package hlt.promo.engine.dto;

import java.time.ZonedDateTime;

public record AmenityResponse(
        Integer amenityId,
        String amenityName,
        Integer locationId,
        String timeZone,
        ZonedDateTime startDateTimeLocal,
        ZonedDateTime endDateTimeLocal
) {
}

