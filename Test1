package hlt.promo.engine.service;

import hlt.promo.engine.dao.SystemDiscountDao;
import hlt.promo.engine.dto.CreateSystemDiscountRequest;
import hlt.promo.engine.exception.ValidationException;
import hlt.promo.engine.repository.TimezoneRepository;
import hlt.promo.engine.util.TimezoneConverter;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
public class SystemDiscountServiceNew {

    private static final Logger log = LoggerFactory.getLogger(SystemDiscountServiceNew.class);

    private final SystemDiscountDao systemDiscountDao;
    private final TimezoneRepository timezoneRepository;

    public SystemDiscountServiceNew(SystemDiscountDao systemDiscountDao,
                                    TimezoneRepository timezoneRepository) {
        this.systemDiscountDao = systemDiscountDao;
        this.timezoneRepository = timezoneRepository;
    }

    // ------------------------------------------------------------
    // CREATE SYSTEM DISCOUNT
    // ------------------------------------------------------------
    @Transactional
    public Integer createSystemDiscount(CreateSystemDiscountRequest request) {

        // Validate
        if (!request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        // Get timezone for this location
        String timezone = timezoneRepository.getTimezoneByLocation(request.getLocationId());

        // Convert local -> UTC (proc columns are plain DATETIME)
        request.setStartDate(
                TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
        request.setEndDate(
                TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());

        // Create
        Integer id = systemDiscountDao.createSystemDiscount(request);

        log.info("Created system discount id={} location={} amenity={}",
                id, request.getLocationId(), request.getAmenityId());

        return id;
    }
}
