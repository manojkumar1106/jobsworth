import { httpClient } from "../utils/http/httpClient";

async function postAmenityData(
  method: string,
  endpoint: string,
  request: any,
  token: string,
  logger: any
) {
  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/amenity${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      headers: {
        "Content-Type": "application/json",
        "Authorization": `Bearer ${token}`,
      },
      body: method === "GET" ? undefined : request,
    },
    logger
  );
}

export async function getAmenityType(request: any, token: string, logger: any) {
  return await postAmenityData("GET", "/type", request, token, logger);
}

export async function getLocationAmenity(request: any, token: string, logger: any) {
  return await postAmenityData("GET", "/location", request, token, logger);
}

export async function getAmenityDetail(request: any, token: string, logger: any) {
  return await postAmenityData("GET", "/detail", request, token, logger);
}

export async function getAmenitySchedule(request: any, token: string, logger: any) {
  return await postAmenityData("GET", "/schedule", request, token, logger);
}

export async function insertAmenity(request: any, token: string, logger: any) {
  return await postAmenityData("POST", "/insert", request, token, logger);
}

export async function upsertAmenitySchedule(request: any, token: string, logger: any) {
  return await postAmenityData("POST", "/schedule/upsert", request, token, logger);
}

export async function updateAmenity(request: any, token: string, logger: any) {
  return await postAmenityData("POST", "/update", request, token, logger);
}

export async function removeAmenity(request: any, token: string, logger: any) {
  return await postAmenityData("DELETE", "/remove", request, token, logger);
}





