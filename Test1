package hlt.promo.engine.dao;

import org.springframework.stereotype.Repository;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Repository
public class PromotionDao extends BaseDao {

    public List<Map<String, Object>> getAllPromotions(String sessionKey) {
        return executeList("usp_Get_Promotions", Map.of("p_Session_Key", sessionKey));
    }

    public Map<String, Object> getPromotionByCode(String sessionKey, String promoCode) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", sessionKey);
        params.put("p_Promo_Code", promoCode);
        return executeSingle("usp_Get_Promotion_By_Code", params);
    }
}




package hlt.promo.engine.service;

import hlt.promo.engine.dao.PromotionDao;
import lombok.RequiredArgsConstructor;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;

import java.util.List;
import java.util.Map;

@Service
@RequiredArgsConstructor
public class PromotionServiceNew {

    private static final Logger log = LoggerFactory.getLogger(PromotionServiceNew.class);

    private final PromotionDao promotionDao;

    public List<Map<String, Object>> getAllPromotions(String sessionKey) {
        log.info("Fetching promotions for session: {}", sessionKey);
        return promotionDao.getAllPromotions(sessionKey);
    }

    public Map<String, Object> getPromotionByCode(String sessionKey, String promoCode) {
        log.info("Fetching promotion by code: {}", promoCode);
        return promotionDao.getPromotionByCode(sessionKey, promoCode);
    }
}


package hlt.promo.engine.controller;

import hlt.promo.engine.dto.ApiResponse;
import hlt.promo.engine.service.PromotionServiceNew;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/promotions")
public class PromotionController {

    @Autowired
    PromotionServiceNew promotionServiceNew;

    @GetMapping
    public ApiResponse<?> getAll(@RequestParam String sessionKey) {
        List<Map<String, Object>> promotions = promotionServiceNew.getAllPromotions(sessionKey);
        return ApiResponse.success("Promotions Fetched", promotions);
    }

    @GetMapping("/code/{promoCode}")
    public ApiResponse<?> getByCode(@PathVariable String promoCode, @RequestParam String sessionKey) {
        Map<String, Object> promotion = promotionServiceNew.getPromotionByCode(sessionKey, promoCode);
        return ApiResponse.success("Promotion Fetched", promotion);
    }
}

