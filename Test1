// ADD to com.hlt.api.controller.PhysicalAddressController,
// alongside createPhysicalAddress / getPhysicalAddress.
// Same JWT session-key pattern already used by those two.

@Operation(summary = "Update Physical Address")
@PutMapping("/update")
public ApiResponse<String> updatePhysicalAddress(@RequestBody TicketRequest req, @AuthenticationPrincipal Jwt jwt) {
    if (jwt != null) {
        req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
    }
    physicalAddressService.updatePhysicalAddress(req);
    return ApiResponse.success("Physical Address Updated", null);
}
