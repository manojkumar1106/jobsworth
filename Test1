        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Sales_Funnel_Id", req.getSalesFunnelId());
        params.put("p_Amenity_Id", amenityId);
        params.put("p_Funnel_Order", funnelOrder);

        executeVoid("usp_Add_Sales_Funnel_Amenity", params);
    }

    /**
     * Retrieves selectable amenities for a location by walking its ancestor/descendant
     * hierarchy. Per the spec, until the recursive-CTE proc (usp_Get_Funnel_Amenities)
     * ships, this proxies the standard usp_Get_Amenities as a temporary mock -
     * swap the procName below once the real proc is available.
     */
    public List<FunnelAmenityOption> getFunnelAmenities(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Location_Id", req.getLocationId());

        // TODO: swap to "usp_Get_Funnel_Amenities" once the recursive CTE proc lands.
        List<Map<String, Object>> rows = executeList("usp_Get_Amenities", params);
        return mapToFunnelAmenityOptions(rows);
    }

    /**
     * Looks up the IANA timezone for a location via its physical address,
     * same pattern as SystemDiscountDao.getTimezoneByLocation.
     */
    public String getTimezoneByLocation(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Location_Id", req.getLocationId());

        return executeReturnType("usp_Get_Timezone_By_Location", "p_Timezone", params);
    }

    private List<FunnelAmenityOption> mapToFunnelAmenityOptions(List<Map<String, Object>> rows) {
        List<FunnelAmenityOption> options = new ArrayList<>();
        for (Map<String, Object> row : rows) {
            FunnelAmenityOption option = new FunnelAmenityOption();
            option.setLocationId((Integer) row.get("locationId"));
            option.setLocationName((String) row.get("locationName"));
            option.setAmenityId((Integer) row.get("amenityId"));
            option.setAmenityName((String) row.get("amenityName"));
            options.add(option);
        }
        return options;
    }
