// Get token directly from tokenRequest
String token = tokenRequest.toSignedRequestUri(
        awsCredentialsProvider.resolveCredentials()
);

RedisStandaloneConfiguration standaloneConfig =
        new RedisStandaloneConfiguration(redisHost, redisPort);
standaloneConfig.setUsername(userId);
standaloneConfig.setPassword(RedisPassword.of(token));

LettuceClientConfiguration clientConfig =
        LettuceClientConfiguration.builder()
                .useSsl()
                .disablePeerVerification()
                .build();

factory = new LettuceConnectionFactory(standaloneConfig, clientConfig);
factory.afterPropertiesSet();
return factory;




@Scheduled(fixedDelay = 600000)
public void refreshRedisToken() {
    if (factory != null) {
        String newToken = tokenRequest.toSignedRequestUri(
                DefaultCredentialsProvider.create().resolveCredentials()
        );
        factory.getStandaloneConfiguration()
                .setPassword(RedisPassword.of(newToken));
    }
}


