    guestSessionKey: string,
    logger: any
): Promise<any> {
    try {
        const response = await fetch(
            `${process.env.API_URL}/api/v1/auth/guest-session`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    sessionKey: guestSessionKey,
                    type: "guest"
                })
            }
        );
        return await response.json();
    } catch (error: any) {
        logger.error(
            `Guest session failed: ${error.message}`
        );
        return { success: false, data: "" };
    }
}





