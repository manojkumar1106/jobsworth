package hlt.promo.engine.dao;

import hlt.promo.engine.dto.CreateRuleDefinitionRequest;
import org.springframework.stereotype.Repository;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Repository
public class RuleDefinitionDao extends BaseDao {

    public List<Map<String, Object>> getAllRuleDefinitions(String sessionKey) {
        return executeList("usp_Get_Rule_Definitions", Map.of("p_Session_Key", sessionKey));
    }

    // Proc does SELECT * ... WHERE Rule_Definitions_Id = LAST_INSERT_VALUE()
    // after the insert, so this needs executeSingle (like PromotionDao.createPromotion),
    // not executeVoid — the created row comes back as a result set, not just an OUT param.
    public Map<String, Object> createRuleDefinition(CreateRuleDefinitionRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Reference_Id", req.getReferenceId());
        params.put("p_Rule_Name", req.getRuleName());
        params.put("p_Rule_Type", req.getRuleType());
        params.put("p_DRL_Content", req.getDrlContent());
        return executeSingle("usp_Create_Rule_Definitions", params);
    }
}




package hlt.promo.engine.service;

