package hlt.promo.engine.dao;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.core.simple.SimpleJdbcCall;

import java.sql.Connection;
import java.util.Collections;
import java.util.List;
import java.util.Map;

public abstract class BaseDao {

    @Autowired
    protected JdbcTemplate jdbcTemplate;

    protected SimpleJdbcCall call(String procName) {
        String schemaName = jdbcTemplate.execute((Connection conn) -> conn.getCatalog());
        return new SimpleJdbcCall(jdbcTemplate)
                .withCatalogName(schemaName)
                .withProcedureName(procName);
    }

    protected void executeVoid(String procName, Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        validateResultCode(out, procName);
    }

    protected Integer executeReturnId(String procName, String outParamName, Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        validateResultCode(out, procName);
        Object value = out.get(outParamName);
        return value != null ? ((Number) value).intValue() : null;
    }

    protected String executeReturnType(String procName, String outParamName, Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        validateResultCode(out, procName);
        Object value = out.get(outParamName);
        return value != null ? value.toString() : null;
    }

    @SuppressWarnings("unchecked")
    protected List<Map<String, Object>> executeList(String procName, Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        validateResultCode(out, procName);
        List<Map<String, Object>> rows = (List<Map<String, Object>>) out.get("#result-set-1");
        return rows != null ? rows : Collections.emptyList();
    }

    /** Result-code convention used by the promo procs. */
    protected void validateResultCode(Map<String, Object> out, String procName) {
        Object raw = out.get("p_Result_Code");
        int code = raw != null ? ((Number) raw).intValue() : 0;

        switch (code) {
            case 1:  return;
            case -2: throw new SecurityException("Invalid session in " + procName);
            case -3: throw new SecurityException("Permission denied in " + procName);
            case -4: throw new IllegalArgumentException("Validation failed in " + procName);
            default: throw new RuntimeException("DB Error (" + code + ") in " + procName);
        }
    }
}



package hlt.promo.engine.dao;

import hlt.promo.engine.dto.CreateSystemDiscountRequest;
import org.springframework.stereotype.Repository;

import java.sql.Timestamp;
import java.util.HashMap;
import java.util.Map;

@Repository
public class SystemDiscountDao extends BaseDao {

    public String getTimezoneByLocation(String sessionKey, Integer locationId) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", sessionKey);
        params.put("p_Location_Id", locationId);
        return executeReturnType("usp_Get_Timezone_By_Location", "p_Timezone", params);
    }

    public Integer createSystemDiscount(CreateSystemDiscountRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Location_Id", req.getLocationId());
        params.put("p_Amenity_Id", req.getAmenityId());
        params.put("p_Title", req.getTitle());
        params.put("p_Display_Name", req.getDisplayName());
        params.put("p_Discount_Description", req.getDiscountDescription());
        params.put("p_Discount_Type", req.getDiscountType() != null ? req.getDiscountType().name() : null);
        params.put("p_Amount", req.getAmount());
        params.put("p_Min_Quantity", req.getMinQuantity());
        params.put("p_User_Type", req.getUserType());
        params.put("p_Channel_POS", req.getChannelPos());
        params.put("p_Channel_Web", req.getChannelWeb());
        params.put("p_Start_Date", req.getStartDate() != null ? Timestamp.valueOf(req.getStartDate()) : null);
        params.put("p_End_Date", req.getEndDate() != null ? Timestamp.valueOf(req.getEndDate()) : null);
        params.put("p_Stackable", req.getStackable());
        params.put("p_Stack_Group", req.getStackGroup());
        params.put("p_Priority", req.getPriority());
        params.put("p_Manager_Approval_Required", req.getManagerApprovalRequired());
        params.put("p_Icon", req.getIcon());
        params.put("p_System_Discount_Status", req.getSystemDiscountStatus());

        return executeReturnId("usp_Create_System_Discount", "p_System_Discount_Id", params);
    }
}



package hlt.promo.engine.service;

import hlt.promo.engine.dao.SystemDiscountDao;
import hlt.promo.engine.dto.CreateSystemDiscountRequest;
import hlt.promo.engine.exception.ValidationException;
import hlt.promo.engine.util.TimezoneConverter;
import lombok.RequiredArgsConstructor;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
@RequiredArgsConstructor
public class SystemDiscountServiceNew {

    private static final Logger log = LoggerFactory.getLogger(SystemDiscountServiceNew.class);

    private final SystemDiscountDao systemDiscountDao;

    @Transactional
    public Integer createSystemDiscount(CreateSystemDiscountRequest request) {

        if (!request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        String timezone = systemDiscountDao.getTimezoneByLocation(
                request.getSessionKey(), request.getLocationId().intValue());

        request.setStartDate(
                TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
        request.setEndDate(
                TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());

        Integer id = systemDiscountDao.createSystemDiscount(request);

        log.info("Created system discount id={} location={} amenity={}",
                id, request.getLocationId(), request.getAmenityId());

        return id;
    }
}



package hlt.promo.engine.exception;

public class ValidationException extends RuntimeException {
    public ValidationException(String message) { super(message); }
    public ValidationException(String message, Throwable cause) { super(message, cause); }
}


