package hlt.promo.engine.model;

import jakarta.persistence.*;
import lombok.Getter;
import lombok.Setter;

import java.time.Instant;

@Entity
@Table(name = "General_Admission", schema = "C1")
@Getter
@Setter
public class GeneralAdmission {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "GA_Id")
    private Integer gaId;

    @Column(name = "Location_Id", nullable = false)
    private Integer locationId;

    @Column(name = "Start_Date_Time_Utc", nullable = false)
    private Instant startDateTimeUtc;

    @Column(name = "End_Date_Time_Utc", nullable = false)
    private Instant endDateTimeUtc;
}




package hlt.promo.engine.repository;

import hlt.promo.engine.model.GeneralAdmission;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.stereotype.Repository;

@Repository
public interface GeneralAdmissionRepository extends JpaRepository<GeneralAdmission, Integer> {
}





package hlt.promo.engine.service;

import hlt.promo.engine.dto.CreateGeneralAdmissionRequest;
import hlt.promo.engine.model.GeneralAdmission;
import hlt.promo.engine.repository.GeneralAdmissionRepository;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;

import java.time.Instant;
import java.time.ZoneId;

@Service
@RequiredArgsConstructor
public class GeneralAdmissionService {

    private final TimeZoneService timeZoneService;
    private final DateTimeConverter dateTimeConverter;
    private final GeneralAdmissionRepository generalAdmissionRepository;

    public void create(CreateGeneralAdmissionRequest request) {

        ZoneId zoneId =
                timeZoneService.getLocationZone(
                        request.locationId());

        Instant startUtc =
                dateTimeConverter.toUtc(
                        request.startDateTime(),
                        zoneId);

        Instant endUtc =
                dateTimeConverter.toUtc(
                        request.endDateTime(),
                        zoneId);

        GeneralAdmission ga = new GeneralAdmission();
        ga.setLocationId(request.locationId());
        ga.setStartDateTimeUtc(startUtc);
        ga.setEndDateTimeUtc(endUtc);

        generalAdmissionRepository.save(ga);
    }
}


package hlt.promo.engine.controller;

import hlt.promo.engine.dto.CreateGeneralAdmissionRequest;
import hlt.promo.engine.service.GeneralAdmissionService;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

@RestController
@RequestMapping("/api/general-admission")
@RequiredArgsConstructor
public class GeneralAdmissionController {

    private final GeneralAdmissionService generalAdmissionService;

    @PostMapping
    public ResponseEntity<String> create(
            @RequestBody CreateGeneralAdmissionRequest request) {

        generalAdmissionService.create(request);
        return ResponseEntity.ok("General admission created successfully");
    }
}


