@Bean
public static BeanDefinitionRegistryPostProcessor redisAutoConfigDisabler() {
    return registry -> {
        String[] beansToRemove = {
            "redisConnectionFactory",
            "redisTemplate",
            "stringRedisTemplate",
            "redisHealthContributor",
            "springDataWebConfiguration"
        };
        for (String beanName : beansToRemove) {
            try {
                registry.removeBeanDefinition(beanName);
                System.out.println("=== Removed: " + beanName);
            } catch (Exception e) {
                System.out.println("=== Not found: " + beanName);
            }
        }
    };
}
