@Configuration
public class RedisConfig {

    @Value("${aws.elasticache.host}")
    private String redisHost;

    public String generateIamAuthToken() {
        // Use serverless-cache-name instead of replication-group-id
        String cacheName = "snd-ticketing-valkey-x4ubek"; // your serverless cache name
        String region = "us-east-1";
        
        ElastiCacheAuthTokenRequest request = ElastiCacheAuthTokenRequest.builder()
            .cacheName(cacheName)          // replaces replicationGroupId
            .userName("hl-snd-ticketing-v1-AnywhereRole")
            .isServerless(true)            // ← KEY FLAG for serverless
            .build();

        ElastiCacheAuthTokenGenerator tokenGenerator = 
            ElastiCacheAuthTokenGenerator.builder()
                .region(Region.of(region))
                .build();

        return tokenGenerator.generateAuthToken(request);
    }

    @Bean
    public RedisConnectionFactory redisConnectionFactory() {
        String token = generateIamAuthToken();
        
        RedisStandaloneConfiguration config = new RedisStandaloneConfiguration();
        config.setHostName(redisHost);
        config.setPort(6379);
        config.setUsername("hl-snd-ticketing-v1-AnywhereRole");
        config.setPassword(token);  // IAM token as password

        LettuceClientConfiguration clientConfig = LettuceClientConfiguration.builder()
            .useSsl()
            .build();

        return new LettuceConnectionFactory(config, clientConfig);
    }
}
