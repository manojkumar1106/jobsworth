    params.put("p_Session_Key", sessionKey);
    params.put("p_Promo_Code", promoCode);
    params.put("p_Customer_Id", customerId);
    params.put("p_Usage_Limit", usageLimit);
    params.put("p_Max_Usage_Per_Customer", maxUsagePerCustomer);
    executeVoid("usp_Use_Promo", @Transactional
public void incrementUsage(String sessionKey, Promotion promo, String customerId) {
    try {
        promoUsageDao.usePromo(
                sessionKey,
                promo.getPromoCode(),
                customerId,
                promo.getUsageLimit(),
                promo.getMaxUsagePerCustomer()
