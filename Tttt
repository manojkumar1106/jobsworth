// =====================================================================
//  1. updateSystemDiscount  -- REPLACE
//
//  The only real change is the log line. The proc now decides internally
//  whether to write live or stage, and the existing
//  "PUBLISHED && !needsApproval" guard already prevented the Drools call
//  in the approval case - that was always right, it just had nothing to
//  protect before.
//
//  When staging happens, the map the proc returns holds the OLD live
//  values. That is correct: those are the values actually in effect.
// =====================================================================

    @Transactional
    public void updateSystemDiscount(CreateSystemDiscountRequest request) {

        convertDatesToUtcIfPresent(request);

        Map<String, Object> systemDiscount =
                systemDiscountDao.updateSystemDiscount(request);

        if (systemDiscount == null) {
            throw new IllegalArgumentException(
                    "System discount not found for id=" + request.getSystemDiscountId());
        }

        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.registerModule(new JavaTimeModule());
        SystemDiscount sdObj =
                objectMapper.convertValue(systemDiscount, SystemDiscount.class);

        boolean needsApproval =
                Boolean.TRUE.equals(request.getManagerApprovalRequired());

        if (needsApproval) {
            log.info("System discount update staged for approval id={} location={} amenity={}",
                    request.getSystemDiscountId(),
                    request.getLocationId(),
                    request.getAmenityId());
        } else {
            log.info("System discount updated id={} location={} amenity={}",
                    request.getSystemDiscountId(),
                    request.getLocationId(),
                    request.getAmenityId());
        }

        // Only touch the rule engine when the live row actually changed.
        if (DiscountStatus.PUBLISHED.name().equals(request.getSystemDiscountStatus())
                && !needsApproval) {
            droolsRuleService.generateSystemDiscountRule(
                    sdObj, "ADMIN", request.getSessionKey());
        }
    }


// =====================================================================
//  2. approveSystemDiscount  -- REPLACE
//
//  This is the required change. The current version calls
//  deactivateRuleDefinition on EVERY rejection. Now that a rejected edit
//  leaves the old discount live and untouched, deactivating its rule
//  would pull a perfectly valid discount off the website.
//
//  Was_Pending_Update comes from the proc and separates the two cases:
//    1  -> this was an EDIT awaiting sign-off
//    0  -> this was a newly created discount awaiting sign-off
//
//  Signature unchanged, so PromotionController needs no change.
// =====================================================================

    @Transactional
    public SystemDiscount approveSystemDiscount(String sessionKey,
                                                Integer id,
                                                String decision) {

        Map<String, Object> row =
                systemDiscountDao.approveSystemDiscount(sessionKey, id, decision);

        if (row == null) {
            throw new IllegalArgumentException("System discount not found for id=" + id);
        }

        // The proc CASTs this to UNSIGNED, so it always arrives as a Number.
        Object flag = row.get("Was_Pending_Update");
        boolean wasPendingUpdate = flag != null && ((Number) flag).intValue() == 1;

        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.registerModule(new JavaTimeModule());
        SystemDiscount sdObj = objectMapper.convertValue(row, SystemDiscount.class);

        log.info("System discount {} for id={} pendingUpdate={}",
                decision, id, wasPendingUpdate);

        if ("APPROVED".equals(decision)) {
            // Live columns now hold the approved values. Covers both an
            // approved edit and an approved first-time create.
            droolsRuleService.generateSystemDiscountRule(sdObj, "ADMIN", sessionKey);

        } else if (wasPendingUpdate) {
            // Rejected EDIT of an already-live discount. The live row was
            // never modified, so its existing rule is still correct and
            // still active. Doing nothing is the whole point.
            log.info("Rejected update id={} - existing rule left active", id);

        } else {
            // Rejected CREATE: this discount was never approved, so make
            // sure nothing is live for it.
            droolsRuleService.deactivateRuleDefinition(
                    "SYSTEM_DISCOUNT", sdObj.getId(), "ADMIN", sessionKey);
        }

        return sdObj;
    }


