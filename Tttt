@Repository
public class SystemDiscountDao extends BaseDao {

    public Integer deactivateSystemDiscount(Long systemDiscountId, String sessionKey) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", sessionKey);
        params.put("p_System_Discount_Id", systemDiscountId);
        return executeSingle(procName: "usp_Deactivate_System_Discount", params);
    }
}


