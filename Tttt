DELIMITER $$

DROP PROCEDURE IF EXISTS client1.usp_Update_System_Discount$$

CREATE DEFINER=`snd-tkts-bi-v1-AnywhereRole`@`%` PROCEDURE client1.usp_Update_System_Discount (
    IN  p_Session_Key               VARCHAR(36)
,   IN  p_Location_Id               INT
,   IN  p_Amenity_Id                INT
,   IN  p_System_Discount_Id        INT
,   IN  p_Title                     VARCHAR(254)
,   IN  p_Display_Name              VARCHAR(254)
,   IN  p_Discount_Description      VARCHAR(254)
,   IN  p_Discount_Type             VARCHAR(20)
,   IN  p_Amount                    DECIMAL(10,2)
,   IN  p_Min_Quantity              INT
,   IN  p_User_Type                 VARCHAR(20)
,   IN  p_Channel_POS               BIT
,   IN  p_Channel_Web               BIT
,   IN  p_Start_Date                DATETIME
,   IN  p_End_Date                  DATETIME
,   IN  p_Stackable                 BIT
,   IN  p_Stack_Group               VARCHAR(254)
,   IN  p_Priority                  INT
,   IN  p_Manager_Approval_Required BIT
,   IN  p_Icon                      VARCHAR(254)
,   IN  p_System_Discount_Status    VARCHAR(20)
,   OUT p_Result_Code               INT
)
BEGIN
    DECLARE Log_Details VARCHAR(4000) DEFAULT '';
    SET p_Result_Code = -1;

    SELECT GloLocFun.Global_Location_Function_Id
    INTO @Location_Function_Id
      FROM Shared.Global_Location_Function GloLocFun
      JOIN Shared.Function_Type_Permission FunTypPer
        ON GloLocFun.Function_Type_Id = FunTypPer.Function_Type_Id
     WHERE FunTypPer.Proc_Name = 'usp_Update_System_Discount'
     LIMIT 1;

    TRY_PROC: BEGIN
        DECLARE EXIT HANDLER FOR SQLEXCEPTION
            BEGIN GET DIAGNOSTICS CONDITION 1 Log_Details = message_text; ROLLBACK; END;

        SET p_Result_Code = -2;
        CALL client1.sys_Validate_Session(p_Session_Key, @Valid);
        IF @Valid = FALSE THEN LEAVE TRY_PROC; END IF;

        SET p_Result_Code = -3;
        CALL client1.sys_Check_Session_Permission(
                 p_Session_Key, @Location_Function_Id,
                 'usp_Update_System_Discount', @Granted);
        IF @Granted = FALSE THEN LEAVE TRY_PROC; END IF;

        SET p_Result_Code = -4;

        -- =============================================================
        --  VALIDATION - UNCHANGED FROM YOUR EXISTING PROC
        -- =============================================================

        IF p_System_Discount_Id IS NULL THEN
            SET Log_Details = 'p_System_Discount_Id'; LEAVE TRY_PROC;
        END IF;

        IF p_Title IS NULL OR TRIM(p_Title) = '' THEN
            SET Log_Details = 'p_Title'; LEAVE TRY_PROC;
        END IF;

        IF EXISTS (
            SELECT 1
              FROM client1.System_Discount
             WHERE Title = TRIM(p_Title)
               AND System_Discount_Id <> p_System_Discount_Id
             LIMIT 1
        ) THEN
            SET Log_Details = 'p_Title : Duplicate Title'; LEAVE TRY_PROC;
        END IF;

        IF p_Discount_Type IS NULL OR p_Discount_Type NOT IN ('FLAT','PERCENTAGE')
            THEN SET Log_Details = 'p_Discount_Type: Must be Flat or Percentage'; LEAVE TRY_PROC; END IF;

        IF p_Amount IS NULL OR p_Amount <= 0
            THEN SET Log_Details = 'p_Amount'; LEAVE TRY_PROC; END IF;

        IF p_Discount_Type = 'PERCENTAGE' AND p_Amount > 100
            THEN SET Log_Details = 'p_Amount : Cannot exceed 100'; LEAVE TRY_PROC; END IF;

        IF p_User_Type IS NOT NULL AND p_User_Type NOT IN ('ALL_USERS','MEMBERS','NON_MEMBERS')
            THEN SET Log_Details = 'p_User_Type'; LEAVE TRY_PROC; END IF;

        IF IFNULL(p_Channel_POS, 0) = 0 AND IFNULL(p_Channel_Web, 0) = 0
            THEN SET Log_Details = 'p_Channel_Web/p_Channel_POS'; LEAVE TRY_PROC; END IF;

        IF p_Start_Date IS NOT NULL AND p_End_Date IS NOT NULL AND p_End_Date <= p_Start_Date
            THEN SET Log_Details = 'p_End_Date must be later than p_Start_Date'; LEAVE TRY_PROC; END IF;

        IF p_End_Date IS NOT NULL AND p_Start_Date IS NULL
            THEN SET Log_Details = 'p_Start_Date: Required when p_End_Date is supplied'; LEAVE TRY_PROC; END IF;

        IF p_Min_Quantity IS NOT NULL AND p_Min_Quantity < 1
            THEN SET Log_Details = 'p_Min_Quantity'; LEAVE TRY_PROC; END IF;

        IF IFNULL(p_Stackable, 0) = 1 AND (p_Stack_Group IS NULL OR TRIM(p_Stack_Group) = '')
            THEN SET Log_Details = 'p_Stack_Group required when stackable enabled'; LEAVE TRY_PROC; END IF;

        IF IFNULL(p_Stackable, 0) = 0 AND p_Stack_Group IS NOT NULL AND TRIM(p_Stack_Group) <> ''
            THEN SET Log_Details = 'p_Stack_Group must be empty when stackable is disabled'; LEAVE TRY_PROC; END IF;

        IF p_Priority IS NOT NULL AND p_Priority < 0
            THEN SET Log_Details = 'p_Priority'; LEAVE TRY_PROC; END IF;

        IF p_System_Discount_Status IS NULL
           OR p_System_Discount_Status NOT IN ('DRAFT','PENDING','PUBLISHED')
            THEN SET Log_Details = 'p_System_Discount_Status'; LEAVE TRY_PROC; END IF;

        IF p_Location_Id IS NOT NULL
           AND NOT EXISTS (
               SELECT 1 FROM client1.Location
                WHERE Location_Id = p_Location_Id
                LIMIT 1
           )
        THEN
            SET Log_Details = 'p_Location_Id : Not Found'; LEAVE TRY_PROC;
        END IF;

        IF p_Amenity_Id IS NOT NULL
           AND NOT EXISTS (
               SELECT 1 FROM client1.Amenity
                WHERE Amenity_Id = p_Amenity_Id
                LIMIT 1
           )
        THEN
            SET Log_Details = 'p_Amenity_Id: Not Found'; LEAVE TRY_PROC;
        END IF;


        -- =============================================================
        --  NEW: decide whether to write live or stage
        -- =============================================================

        SELECT CAST(Is_Active AS UNSIGNED), Pending_Update_Json
          INTO @Is_Live, @Existing_Pending
          FROM client1.System_Discount
         WHERE System_Discount_Id = p_System_Discount_Id
         LIMIT 1;

        IF @Is_Live IS NULL THEN
            SET Log_Details = 'p_System_Discount_Id : Not Found'; LEAVE TRY_PROC;
        END IF;

        IF IFNULL(p_Manager_Approval_Required, 1) = 1 AND @Is_Live = 1 THEN

            -- =========================================================
            --  STAGE  -- live columns are NOT touched
            --
            --  The discount is live and this edit needs sign-off, so the
            --  new values are parked as JSON. Customers keep transacting
            --  on the current values and the active Rule_Definitions row
            --  stays exactly as it is.
            -- =========================================================

            -- One pending edit at a time.
            IF @Existing_Pending IS NOT NULL THEN
                SET Log_Details = 'Changes already awaiting approval';
                LEAVE TRY_PROC;
            END IF;

            -- Same expressions as the live UPDATE below, so approving
            -- writes byte-for-byte what a direct update would have.
            -- BIT columns are CAST to UNSIGNED because JSON_OBJECT()
            -- encodes BIT as base64 ("AQ==") rather than 1/0.
            SET @Pending_Json = JSON_OBJECT(
                'Location_Id',          p_Location_Id,
                'Amenity_Id',           p_Amenity_Id,
                'Title',                TRIM(p_Title),
                'Display_Name',         NULLIF(TRIM(IFNULL(p_Display_Name, '')), ''),
                'Discount_Description', NULLIF(TRIM(IFNULL(p_Discount_Description, '')), ''),
                'Discount_Type',        p_Discount_Type,
                'Amount',               p_Amount,
                'Min_Quantity',         p_Min_Quantity,
                'User_Type',            IFNULL(p_User_Type, 'ALL_USERS'),
                'Channel_POS',          CAST(IFNULL(p_Channel_POS, 0) AS UNSIGNED),
                'Channel_Web',          CAST(IFNULL(p_Channel_Web, 0) AS UNSIGNED),
                'Start_Date',           DATE_FORMAT(p_Start_Date, '%Y-%m-%d %H:%i:%s'),
                'End_Date',             DATE_FORMAT(p_End_Date,   '%Y-%m-%d %H:%i:%s'),
                'Stackable',            CAST(IFNULL(p_Stackable, 0) AS UNSIGNED),
                'Stack_Group',          CASE WHEN IFNULL(p_Stackable, 0) = 1
                                             THEN TRIM(p_Stack_Group) ELSE NULL END,
                'Priority',             IFNULL(p_Priority, 0),
                'Icon',                 NULLIF(TRIM(IFNULL(p_Icon, '')), ''),
                -- the status the admin wants once this is approved
                'System_Discount_Status', p_System_Discount_Status
            );

            UPDATE client1.System_Discount
               SET Pending_Update_Json       = @Pending_Json
            ,      Manager_Approval_Required = 1
            ,      Approval_Status           = 'PENDING'
            ,      Updated_At                = UTC_TIMESTAMP()
            ,      Updated_By                = p_Session_Key
             WHERE System_Discount_Id = p_System_Discount_Id;

            -- Is_Active and System_Discount_Status deliberately untouched.

        ELSE

            -- =========================================================
            --  LIVE WRITE  -- unchanged from your existing proc
            --  Reached when approval is not required, or when the
            --  discount is not live yet (a draft nobody can see).
            -- =========================================================

            UPDATE client1.System_Discount
               SET Location_Id               = p_Location_Id
            ,      Amenity_Id                = p_Amenity_Id
            ,      Title                     = TRIM(p_Title)
            ,      Display_Name              = NULLIF(TRIM(IFNULL(p_Display_Name, '')), '')
            ,      Discount_Description      = NULLIF(TRIM(IFNULL(p_Discount_Description, '')), '')
            ,      Discount_Type             = p_Discount_Type
            ,      Amount                    = p_Amount
            ,      Min_Quantity              = p_Min_Quantity
            ,      User_Type                 = IFNULL(p_User_Type, 'ALL_USERS')
            ,      Channel_POS               = IFNULL(p_Channel_POS, 0)
            ,      Channel_Web               = IFNULL(p_Channel_Web, 0)
            ,      Start_Date                = p_Start_Date
            ,      End_Date                  = p_End_Date
            ,      Stackable                 = IFNULL(p_Stackable, 0)
            ,      Stack_Group               = CASE WHEN IFNULL(p_Stackable, 0) = 1
                                                    THEN TRIM(p_Stack_Group) ELSE NULL END
            ,      Priority                  = IFNULL(p_Priority, 0)
            ,      Manager_Approval_Required = IFNULL(p_Manager_Approval_Required, 1)
            ,      Approval_Status           = CASE WHEN IFNULL(p_Manager_Approval_Required, 1) = 1
                                                    THEN 'PENDING' ELSE 'APPROVED' END
            ,      System_Discount_Status    = CASE WHEN IFNULL(p_Manager_Approval_Required, 1) = 1
                                                    THEN 'DRAFT' ELSE p_System_Discount_Status END
            ,      Is_Active                 = CASE WHEN IFNULL(p_Manager_Approval_Required, 1) = 0
                                                     AND p_System_Discount_Status = 'PUBLISHED'
                                                    THEN 1 ELSE 0 END
            ,      Icon                      = NULLIF(TRIM(IFNULL(p_Icon, '')), '')
            ,      Updated_At                = UTC_TIMESTAMP()
            ,      Updated_By                = p_Session_Key
             WHERE System_Discount_Id = p_System_Discount_Id;

        END IF;


        -- =============================================================
        --  RESULT SET - unchanged column list
        -- =============================================================
        SELECT
            System_Discount_Id
        ,   Location_Id
        ,   Amenity_Id
        ,   Is_Active
        ,   Amount
        ,   Approval_Status
        ,   Channel_POS
        ,   Channel_Web
        ,   Created_At
        ,   Created_By
        ,   Discount_Description
        ,   Discount_Type
        ,   Display_Name
        ,   End_Date
        ,   Icon
        ,   Manager_Approval_Required
        ,   Min_Quantity
        ,   Priority
        ,   Stack_Group
        ,   Stackable
        ,   Start_Date
        ,   System_Discount_Status
        ,   Title
        ,   Updated_At
        ,   Updated_By
        ,   User_Type
          FROM client1.System_Discount
         WHERE System_Discount_Id = p_System_Discount_Id;

        SET p_Result_Code = 1;
    END TRY_PROC;

    CALL client1.usp_Insert_User_Session_Log(
             p_Session_Key, 'usp_Update_System_Discount',
             p_Result_Code, Log_Details);
END$$

DELIMITER ;






