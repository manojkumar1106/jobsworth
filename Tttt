import org.kie.api.KieServices;
import org.kie.api.builder.KieBuilder;
import org.kie.api.builder.KieFileSystem;
import org.kie.api.builder.Message;
import org.kie.api.runtime.KieContainer;
import org.kie.api.runtime.KieSession;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.io.StringReader;
import java.math.BigDecimal;
import java.sql.Timestamp;
import java.time.LocalDateTime;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.concurrent.CompletableFuture;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicReference;
import java.util.stream.Collectors;

@Slf4j
@Service
@RequiredArgsConstructor
public class DroolsEngineService {

    // Used when reloadRules() runs with no logged-in user (e.g. @PostConstruct
    // startup, or internal reloads triggered by rule-generation flows).
    // CONFIRM this is an accepted value for sys_Validate_Session before relying
    // on it — if not, this whole method needs a different session strategy.
    private static final String SYSTEM_SESSION_KEY = "SYSTEM_ENGINE_RELOAD";

    private final RuleDefinitionDao ruleDefinitionDao;
    private final PromotionDao promotionDao;
    private final PromoUsageDao promoUsageDao;
    private final DiscountAuditLogDao discountAuditLogDao;
    private final EngineConfigService engineConfigService;

    ObjectMapper objectMapper = new ObjectMapper();

    private final AtomicReference<KieContainer> kieContainerRef = new AtomicReference<>();
    private final AtomicInteger activeSessions = new AtomicInteger(0);

    // ==========================
    // STARTUP - load existing rules from DB
    // ==========================
    @PostConstruct
    public void init() {
        try {
            reloadRules();
        } catch (Exception e) {
            log.warn("Startup rule load - no rules yet or compile warning: {}", e.getMessage());
            buildEmptyContainer();
        }
    }

    // ==========================
    // RELOAD RULES FROM DB
    // ==========================
    public synchronized void reloadRules() {

        List<Map<String, Object>> rows = ruleDefinitionDao.getAllRuleDefinitions(SYSTEM_SESSION_KEY);

        List<RuleDefinition> activeRules = rows.stream()
                .filter(row -> asBoolean(row.get("Is_Active")))
                .map(this::mapToRuleDefinition)
                .collect(Collectors.toList());

        log.info("Reloading {} active rules...", activeRules.size());

        // If no rules, build empty container instead of crashing
        if (activeRules.isEmpty()) {
            buildEmptyContainer();
            return;
        }

        KieServices ks = KieServices.Factory.get();
        KieFileSystem kfs = ks.newKieFileSystem();

        for (RuleDefinition rule : activeRules) {
            String path = "src/main/resources/rules/" + rule.getRuleName() + ".drl";
            kfs.write(path, ks.getResources().newReaderResource(new StringReader(rule.getDrlContent())).setResourceType(org.kie.api.io.ResourceType.DRL));
        }

        KieBuilder kb = ks.newKieBuilder(kfs).buildAll();

        if (kb.getResults().hasMessages(Message.Level.ERROR)) {
            String errors = kb.getResults().getMessages(Message.Level.ERROR).stream().map(Message::getText).collect(Collectors.joining(", "));
            log.error("DRL compile errors: {}", errors);
            throw new RuntimeException("DRL compile error: " + errors);
        }

        KieContainer newContainer = ks.newKieContainer(ks.getRepository().getDefaultReleaseId());

        KieContainer old = kieContainerRef.getAndSet(newContainer);
        if (old != null) {
            disposeOldContainerSafely(old);
        }

        log.info("KieContainer reloaded - {} rules", activeRules.size());
    }

    private void buildEmptyContainer() {
        KieServices ks = KieServices.Factory.get();
        KieFileSystem kfs = ks.newKieFileSystem();
        kfs.write("src/main/resources/rules/empty.drl", ks.getResources().newReaderResource(new StringReader("package com.promotionengine.rules;\n")).setResourceType(org.kie.api.io.ResourceType.DRL));

        KieBuilder kb = ks.newKieBuilder(kfs).buildAll();
        KieContainer container = ks.newKieContainer(ks.getRepository().getDefaultReleaseId());
        KieContainer old = kieContainerRef.getAndSet(container);
        if (old != null) {
            disposeOldContainerSafely(old);
        }
        log.info("Empty KieContainer initialized");
    }

    // ==========================
    // APPLY RULES - MAIN ENTRY POINT
    // ==========================
    @Transactional
    public DiscountResult applyRules(String sessionKey, Cart cart) {

        cart.setCurrentDateTime(LocalDateTime.now());

        // STEP 1: Validate promo codes
        Map<String, Promotion> validatedPromos = new HashMap<>();
        if (cart.getPromoCodes() != null && !cart.getPromoCodes().isEmpty()) {
            validatedPromos = validatePromoCodes(sessionKey, cart.getPromoCodes(), cart.getCustomerId());
        }

        // STEP 2: Fire Drools
        DiscountResult result = fireRules(cart);

        // STEP 3: Increment usage
        if (cart.getPromoCodes() != null) {
            Map<String, Promotion> promosForIncrement = validatedPromos;
            cart.getPromoCodes().forEach(code -> {
                boolean applied = result.getAppliedDiscounts().stream()
                        .anyMatch(d -> d.getRuleName().equals("PROMO_" + code));
                if (applied) {
                    Promotion promo = promosForIncrement.get(code);
                    if (promo != null) {
                        incrementUsage(sessionKey, promo, cart.getCustomerId());
                    } else {
                        log.error("Promo [{}] applied by rules but not found in validated set - skipping usage increment", code);
                    }
                }
            });
        }

        // STEP 4: Audit log async
        saveAuditLogAsync(sessionKey, cart, result);

        return result;
    }

    // ==========================
    // VALIDATE PROMO CODES
    // ==========================
    private Map<String, Promotion> validatePromoCodes(String sessionKey, List<String> promoCodes, String customerId) {

        int maxAllowed = engineConfigService.getMaxPromosPerCart();
        if (promoCodes.size() > maxAllowed) {
            throw new RuntimeException("You can select maximum " + maxAllowed + " promotions per cart. You selected: " + promoCodes.size());
        }

        long distinct = promoCodes.stream().distinct().count();
        if (distinct < promoCodes.size()) {
            throw new RuntimeException("Duplicate promo codes are not allowed.");
        }

        List<Promotion> selectedPromos = promoCodes.stream()
                .map(code -> {
                    Map<String, Object> row = promotionDao.getPromotionByCode(sessionKey, code);
                    if (row == null) {
                        throw new RuntimeException("Promo [" + code + "] not found");
                    }
                    return mapToPromotion(row);
                })
                .collect(Collectors.toList());

        if (promoCodes.size() > 1) {
            selectedPromos.forEach(promo -> {
                if (!Boolean.TRUE.equals(promo.getStackable())) {
                    throw new RuntimeException("Promo [" + promo.getPromoCode() + "] is not stackable. Please select it alone.");
                }
            });
        }

        Map<String, List<Promotion>> byGroup = selectedPromos.stream()
                .filter(p -> p.getSelectionGroup() != null)
                .collect(Collectors.groupingBy(Promotion::getSelectionGroup));

        byGroup.forEach((group, promosInGroup) -> {
            int maxSelectable = promosInGroup.get(0).getMaxSelectablePerGroup() != null
                    ? promosInGroup.get(0).getMaxSelectablePerGroup()
                    : Integer.MAX_VALUE;

            if (promosInGroup.size() > maxSelectable) {
                throw new RuntimeException("You can select maximum " + maxSelectable
                        + " promotions from group [" + group + "]. You selected: " + promosInGroup.size());
            }
        });

        selectedPromos.forEach(promo -> validateDateAndUsage(sessionKey, promo, customerId));

        return selectedPromos.stream().collect(Collectors.toMap(Promotion::getPromoCode, p -> p));
    }

    // ==========================
    // VALIDATE DATE AND USAGE
    // ==========================
    private void validateDateAndUsage(String sessionKey, Promotion promo, String customerId) {

        String promoCode = promo.getPromoCode();
        LocalDateTime now = LocalDateTime.now();

        if (promo.getStartDate() != null && now.isBefore(promo.getStartDate())) {
            throw new RuntimeException("Promo [" + promoCode + "] not yet active. Starts: " + promo.getStartDate());
        }

        if (promo.getEndDate() != null && now.isAfter(promo.getEndDate())) {
            throw new RuntimeException("Promo [" + promoCode + "] expired on: " + promo.getEndDate());
        }

        if (promo.getUsageLimit() != null || promo.getMaxUsagePerCustomer() != null) {
            PromoUsageSummary usage = promoUsageDao.getUsageSummary(sessionKey, promoCode, customerId);

            if (promo.getUsageLimit() != null && usage.getTotalUsage() >= promo.getUsageLimit()) {
                throw new RuntimeException("Promo [" + promoCode + "] reached global limit of " + promo.getUsageLimit());
            }

            if (promo.getMaxUsagePerCustomer() != null && usage.getCustomerUsage() >= promo.getMaxUsagePerCustomer()) {
                throw new RuntimeException("You have already used promo [" + promoCode + "] "
                        + usage.getCustomerUsage() + " time(s). Max allowed: " + promo.getMaxUsagePerCustomer());
            }
        }
    }

    // ==========================
    // FIRE RULES
    // ==========================
    private DiscountResult fireRules(Cart cart) {
        KieContainer container = kieContainerRef.get();

        if (container == null) {
            log.warn("KieContainer is null - reloading...");
            reloadRules();
            container = kieContainerRef.get();
        }

        DiscountResult result = new DiscountResult();
        result.setOriginalTotal(cart.getCartTotal());
        result.setTotalDiscount(0.0);
        result.setPromoStackLocked(false);
        result.setNonStackableLocked(false);

        KieSession kieSession = container.newKieSession();
        activeSessions.incrementAndGet();

        try {
            kieSession.insert(cart);
            kieSession.insert(result);

            int fired = kieSession.fireAllRules();
            log.info("fireAllRules() fired={} customer={} originalTotal={}", fired, cart.getCustomerId(), cart.getCartTotal());

            result.computeFinalTotal();
            log.info("Result: original={} discount={} final={}", result.getOriginalTotal(), result.getTotalDiscount(), result.getFinalTotal());

        } catch (Exception e) {
            log.error("Drools fireAllRules error: {}", e.getMessage(), e);
            result.setFinalTotal(cart.getCartTotal());
            result.setTotalDiscount(0.0);
            throw new RuntimeException("Rule engine error: " + e.getMessage());
        } finally {
            kieSession.dispose();
            activeSessions.decrementAndGet();
        }

        return result;
    }

    // ==========================
    // INCREMENT USAGE
    // ==========================
    @Transactional
    public void incrementUsage(String sessionKey, Promotion promo, String customerId) {
        try {
            promoUsageDao.usePromo(
                    sessionKey,
                    promo.getPromoCode(),
                    customerId,
                    promo.getUsageLimit(),
                    promo.getMaxUsagePerCustomer()
            );
            log.info("Usage incremented promo={} customer={}", promo.getPromoCode(), customerId);
        } catch (PromoLimitExceededException e) {
            log.error("Usage increment blocked - limit reached: {}", e.getMessage());
            throw e;
        } catch (Exception e) {
            log.error("Usage increment failed: {}", e.getMessage());
        }
    }

    // ==========================
    // AUDIT LOG ASYNC
    // ==========================
    @org.springframework.scheduling.annotation.Async
    public void saveAuditLogAsync(String sessionKey, Cart cart, DiscountResult result) {
        try {
            String promoCodesCsv = cart.getPromoCodes() != null
                    ? String.join(",", cart.getPromoCodes())
                    : "";
            String appliedDiscountsJson = objectMapper.writeValueAsString(result.getAppliedDiscounts());

            discountAuditLogDao.insertAuditLog(
                    sessionKey,
                    cart.getCustomerId(),
                    promoCodesCsv,
                    BigDecimal.valueOf(result.getOriginalTotal()),
                    BigDecimal.valueOf(result.getTotalDiscount()),
                    BigDecimal.valueOf(result.getFinalTotal()),
                    result.isManagerApprovalRequired(),
                    result.getAppliedDiscounts().size(),
                    appliedDiscountsJson
            );
        } catch (Exception e) {
            log.error("Audit log async failed: {}", e.getMessage());
        }
    }

    // ==========================
    // SAFE DISPOSE OLD CONTAINER
    // ==========================
    private void disposeOldContainerSafely(KieContainer old) {
        CompletableFuture.runAsync(() -> {
            int waited = 0;
            while (activeSessions.get() > 0 && waited < 30) {
                try {
                    Thread.sleep(1000);
                    waited++;
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    break;
                }
            }
            try {
                old.dispose();
                log.info("Old KieContainer disposed after {}s", waited);
            } catch (Exception e) {
                log.warn("Old container dispose failed: {}", e.getMessage());
            }
        });
    }

    // ==========================
    // ROW -> ENTITY MAPPING (DAOs return raw DB column names, not camelCase)
    // ==========================

    private RuleDefinition mapToRuleDefinition(Map<String, Object> row) {
        RuleDefinition rule = new RuleDefinition();
        rule.setId(asLong(row.get("Rule_Definitions_Id")));
        rule.setRuleName((String) row.get("Rule_Name"));
        rule.setRuleType((String) row.get("Rule_Type"));
        rule.setReferenceId(asLong(row.get("Reference_Id")));
        rule.setDrlContent((String) row.get("DRL_Content"));
        rule.setVersion(asInteger(row.get("Version")));
        rule.setActive(asBoolean(row.get("Is_Active")));
        rule.setCreatedBy((String) row.get("Created_By"));
        rule.setCreatedAt(asLocalDateTime(row.get("Created_At")));
        rule.setUpdatedAt(asLocalDateTime(row.get("Updated_At")));
        rule.setIsRemoved(asBoolean(row.get("Is_Removed")));
        return rule;
    }

    private Promotion mapToPromotion(Map<String, Object> row) {
        Promotion promo = new Promotion();
        promo.setId(asLong(row.get("Promotion_Id")));
        promo.setLocationId(asLong(row.get("Location_Id")));
        promo.setAmenityId(asLong(row.get("Amenity_Id")));
        promo.setAmount(asBigDecimal(row.get("Amount")));
        promo.setApplyFullCart(asBoolean(row.get("Apply_Full_Cart")));
        promo.setCategory((String) row.get("Category"));
        promo.setChannelPos(asBoolean(row.get("Channel_POS")));
        promo.setChannelWeb(asBoolean(row.get("Channel_Web")));
        promo.setDiscountType(row.get("Discount_Type") != null ? DiscountType.valueOf((String) row.get("Discount_Type")) : null);
        promo.setDisplayMessage((String) row.get("Display_Message"));
        promo.setEndDate(asLocalDateTime(row.get("End_Date")));
        promo.setMaxSelectablePerGroup(asInteger(row.get("Max_Selectable_Per_Group")));
        promo.setPriority(asInteger(row.get("Priority")));
        promo.setPromoCode((String) row.get("Promo_Code"));
        promo.setRedemptionMethod(row.get("Redemption_Method") != null ? RedemptionMethod.valueOf((String) row.get("Redemption_Method")) : null);
        promo.setSelectionGroup((String) row.get("Selection_Group"));
        promo.setStackGroup((String) row.get("Stack_Group"));
        promo.setStackable(asBoolean(row.get("Stackable")));
        promo.setStartDate(asLocalDateTime(row.get("Start_Date")));
        promo.setPromoStatus((String) row.get("Promo_Status"));
        promo.setTicketType((String) row.get("Ticket_Type"));
        promo.setUsageLimit(asInteger(row.get("Usage_Limit")));
        promo.setUserType(row.get("User_Type") != null ? UserType.valueOf((String) row.get("User_Type")) : null);
        promo.setMaxUsagePerCustomer(asInteger(row.get("Max_Usage_Per_Customer")));
        return promo;
    }

    private Long asLong(Object v) {
        return v != null ? ((Number) v).longValue() : null;
    }

    private Integer asInteger(Object v) {
        return v != null ? ((Number) v).intValue() : null;
    }

    private BigDecimal asBigDecimal(Object v) {
        if (v == null) return null;
        return v instanceof BigDecimal ? (BigDecimal) v : new BigDecimal(v.toString());
    }

    private Boolean asBoolean(Object v) {
        if (v == null) return false;
        if (v instanceof Boolean) return (Boolean) v;
        return ((Number) v).intValue() != 0;
    }

    private LocalDateTime asLocalDateTime(Object v) {
        if (v == null) return null;
        return v instanceof Timestamp ? ((Timestamp) v).toLocalDateTime() : null;
    }
}
