private Promotion findActivePromoByCode(String code, String sessionKey) {
    Map<String, Object> row = promotionDao.getPromotionByCode(sessionKey, code);
    if (row == null || row.isEmpty()) {
        throw new RuntimeException("Promo [" + code + "] not found");
    }

    ObjectMapper mapper = new ObjectMapper();
    mapper.registerModule(new JavaTimeModule());
    return mapper.convertValue(row, Promotion.class);
}
