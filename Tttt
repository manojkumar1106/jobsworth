import hlt.promo.engine.dao.PromoUsageDao;
import hlt.promo.engine.dao.PromotionDao;
import hlt.promo.engine.dao.RuleDefinitionDao;
import hlt.promo.engine.dto.Cart;
import hlt.promo.engine.dto.DiscountResult;
import hlt.promo.engine.dto.PromoUsageSummary;
import hlt.promo.engine.enums.DiscountType;
import hlt.promo.engine.enums.RedemptionMethod;
import hlt.promo.engine.enums.UserType;
import hlt.promo.engine.exception.PromoLimitExceededException;
import hlt.promo.engine.model.DiscountAuditLog;
import hlt.promo.engine.model.Promotion;
import hlt.promo.engine.model.RuleDefinition;
import jakarta.annotation.PostConstruct;
