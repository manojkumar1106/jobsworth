// Manager approves or rejects a discount awaiting approval
@PutMapping("/{id}/approve")
public ApiResponse<?> approve(@PathVariable Integer id,
                              @RequestParam String sessionKey,
                              @RequestParam String approvedBy,
                              @RequestParam String decision) {
    SystemDiscount updated = systemDiscountService.approveSystemDiscount(
            sessionKey, id, approvedBy, decision);
    return ApiResponse.success(message: "System Discount " + decision, updated);
}

// Approval queue — discounts waiting on a manager
@GetMapping("/pending-approval")
public ApiResponse<?> getPendingApproval(@RequestParam String sessionKey) {
    return ApiResponse.success(message: "Pending Approval Discounts Fetched",
            systemDiscountService.getPendingApprovalDiscounts(sessionKey));
}
