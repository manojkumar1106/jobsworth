DELIMITER $$

DROP PROCEDURE IF EXISTS client1.usp_Approve_System_Discount$$

CREATE DEFINER=`snd-tkts-bi-v1-AnywhereRole`@`%` PROCEDURE client1.usp_Approve_System_Discount (
    IN  p_Session_Key        VARCHAR(36)
,   IN  p_System_Discount_Id INT
,   IN  p_Approval_Decision  VARCHAR(20)
,   OUT p_Result_Code        INT
)
BEGIN
    DECLARE Log_Details VARCHAR(4000) DEFAULT '';
    SET p_Result_Code = -1;

    SELECT GloLocFun.Global_Location_Function_Id
    INTO @Location_Function_Id
      FROM Shared.Global_Location_Function GloLocFun
      JOIN Shared.Function_Type_Permission FunTypPer
        ON GloLocFun.Function_Type_Id = FunTypPer.Function_Type_Id
     WHERE FunTypPer.Proc_Name = 'usp_Approve_System_Discount'
     LIMIT 1;

    TRY_PROC: BEGIN
        DECLARE EXIT HANDLER FOR SQLEXCEPTION
            BEGIN GET DIAGNOSTICS CONDITION 1 Log_Details = message_text; ROLLBACK; END;

        SET p_Result_Code = -2;
        CALL client1.sys_Validate_Session(p_Session_Key, @Valid);
        IF @Valid = FALSE THEN LEAVE TRY_PROC; END IF;

        SET p_Result_Code = -3;
        CALL client1.sys_Check_Session_Permission(
                 p_Session_Key, @Location_Function_Id,
                 'usp_Approve_System_Discount', @Granted);
        IF @Granted = FALSE THEN LEAVE TRY_PROC; END IF;

        SET p_Result_Code = -4;

        IF p_System_Discount_Id IS NULL THEN
            SET Log_Details = 'p_System_Discount_Id'; LEAVE TRY_PROC;
        END IF;

        IF p_Approval_Decision IS NULL
           OR p_Approval_Decision NOT IN ('APPROVED','REJECTED') THEN
            SET Log_Details = 'p_Approval_Decision'; LEAVE TRY_PROC;
        END IF;

        SELECT Approval_Status
        ,      CASE WHEN Pending_Update_Json IS NOT NULL THEN 1 ELSE 0 END
        ,      Pending_Update_Json
        INTO   @Current_Approval, @Was_Pending, @Pending_Json
          FROM client1.System_Discount
         WHERE System_Discount_Id = p_System_Discount_Id
           AND IFNULL(Is_Removed, 0) = 0
         LIMIT 1;

        IF @Current_Approval IS NULL THEN
            SET Log_Details = '@Current_Approval'; LEAVE TRY_PROC;
        END IF;

        IF @Current_Approval <> 'PENDING' THEN
            SET Log_Details = '@Current_Approval <> PENDING'; LEAVE TRY_PROC;
        END IF;


        IF p_Approval_Decision = 'APPROVED' AND @Was_Pending = 1 THEN

            -- =========================================================
            --  APPROVED EDIT: apply the staged values, clear the staging
            --  area. The snapshot is complete and already carries the
            --  same transformations the live UPDATE would have applied,
            --  so this is a straight overwrite.
            --
            --  Dates were UTC-converted in Java before staging. Fixed
            --  format in, fixed format out - never reconvert here.
            -- =========================================================

            UPDATE client1.System_Discount
               SET Location_Id          = JSON_EXTRACT(@Pending_Json, '$.Location_Id')
            ,      Amenity_Id           = JSON_EXTRACT(@Pending_Json, '$.Amenity_Id')
            ,      Title                = JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.Title'))
            ,      Display_Name         = JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.Display_Name'))
            ,      Discount_Description = JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.Discount_Description'))
            ,      Discount_Type        = JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.Discount_Type'))
            ,      Amount               = JSON_EXTRACT(@Pending_Json, '$.Amount')
            ,      Min_Quantity         = JSON_EXTRACT(@Pending_Json, '$.Min_Quantity')
            ,      User_Type            = JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.User_Type'))

                   -- integer in JSON -> back into BIT columns
            ,      Channel_POS          = CAST(JSON_EXTRACT(@Pending_Json, '$.Channel_POS') AS UNSIGNED)
            ,      Channel_Web          = CAST(JSON_EXTRACT(@Pending_Json, '$.Channel_Web') AS UNSIGNED)
            ,      Stackable            = CAST(JSON_EXTRACT(@Pending_Json, '$.Stackable')   AS UNSIGNED)

            ,      Start_Date           = STR_TO_DATE(JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.Start_Date')), '%Y-%m-%d %H:%i:%s')
            ,      End_Date             = STR_TO_DATE(JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.End_Date')),   '%Y-%m-%d %H:%i:%s')

            ,      Stack_Group          = JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.Stack_Group'))
            ,      Priority             = JSON_EXTRACT(@Pending_Json, '$.Priority')
            ,      Icon                 = JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.Icon'))

                   -- the status the admin asked for when submitting
            ,      System_Discount_Status = JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.System_Discount_Status'))
            ,      Is_Active            = CASE WHEN JSON_UNQUOTE(JSON_EXTRACT(@Pending_Json, '$.System_Discount_Status')) = 'PUBLISHED'
                                               THEN 1 ELSE 0 END

            ,      Approval_Status      = 'APPROVED'
            ,      Pending_Update_Json  = NULL
            ,      Updated_At           = UTC_TIMESTAMP()
            ,      Updated_By           = p_Session_Key
             WHERE System_Discount_Id = p_System_Discount_Id;

        ELSEIF @Was_Pending = 1 THEN

            -- =========================================================
            --  REJECTED EDIT: throw the draft away, change nothing else.
            --  Is_Active and System_Discount_Status are deliberately NOT
            --  touched, so the already-approved discount keeps running
            --  and its Rule_Definitions row stays active. Zero downtime.
            -- =========================================================

            UPDATE client1.System_Discount
               SET Approval_Status     = 'REJECTED'
            ,      Pending_Update_Json = NULL
            ,      Updated_At          = UTC_TIMESTAMP()
            ,      Updated_By          = p_Session_Key
             WHERE System_Discount_Id = p_System_Discount_Id;

        ELSE

            -- =========================================================
            --  No staged snapshot: a newly created discount being
            --  approved or rejected. Your existing behaviour, unchanged.
            -- =========================================================

            UPDATE client1.System_Discount
               SET Approval_Status        = p_Approval_Decision
            ,      System_Discount_Status = CASE WHEN p_Approval_Decision = 'APPROVED'
                                                 THEN 'PUBLISHED' ELSE 'DRAFT' END
            ,      Is_Active              = CASE WHEN p_Approval_Decision = 'APPROVED'
                                                 THEN 1 ELSE 0 END
            ,      Updated_At             = UTC_TIMESTAMP()
            ,      Updated_By             = p_Session_Key
             WHERE System_Discount_Id = p_System_Discount_Id;

        END IF;


        -- =============================================================
        --  RESULT SET
        --  Was_Pending_Update is CAST so the JDBC driver returns a clean
        --  integer rather than a loosely typed user variable.
        -- =============================================================
        SELECT sd.*
        ,      CAST(@Was_Pending AS UNSIGNED) AS Was_Pending_Update
          FROM client1.System_Discount sd
         WHERE sd.System_Discount_Id = p_System_Discount_Id;

        SET p_Result_Code = 1;
    END TRY_PROC;

    CALL client1.usp_Insert_User_Session_Log(
             p_Session_Key, 'usp_Approve_System_Discount',
             p_Result_Code, Log_Details);
END$$

