@Transactional
public void updatePromotion(CreatePromotionRequest request) {

    // Everything else is optional — only validate ordering if both dates were sent.
    if (request.getStartDate() != null && request.getEndDate() != null
            && !request.getStartDate().isBefore(request.getEndDate())) {
        throw new ValidationException("Start date must be before end date");
    }

    // Only need timezone conversion if a date is actually being updated
    if (request.getStartDate() != null || request.getEndDate() != null) {

        if (request.getLocationId() == null) {
            throw new ValidationException(
                    "locationId is required to resolve timezone when updating start/end date");
        }

        String timezone = systemDiscountDao.getTimezoneByLocation(
                request.getSessionKey(), request.getLocationId().intValue());

        if (request.getStartDate() != null) {
            request.setStartDate(
                    TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
        }
        if (request.getEndDate() != null) {
            request.setEndDate(
                    TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());
        }
    }

    Map<String, Object> promotion = promotionDao.updatePromotion(request);

    ObjectMapper objectMapper = new ObjectMapper();
    objectMapper.registerModule(new JavaTimeModule());
    Promotion promotionObj = objectMapper.convertValue(promotion, Promotion.class);

    log.info("Promotion updated promotionId={} location={} amenity={} promoCode={}",
            request.getPromotionId(), request.getLocationId(),
            request.getAmenityId(), request.getPromoCode());

    if (PromotionStatus.PUBLISHED.name().equals(request.getPromoStatus())) {
        droolsRuleService.generatePromotionRule(promotionObj, "ADMIN", request.getSessionKey());
    }
}




@Transactional
public void updateSystemDiscount(CreateSystemDiscountRequest request) {
    // Unlike Promotion's update, this proc has no COALESCE fallback — every field
    // sent is written as-is, and locationId/amenityId being omitted will null those
    // columns. Bean Validation (OnUpdate group) only guarantees systemDiscountId,
    // title, discountType, amount and systemDiscountStatus are present.

    convertDatesToUtcIfPresent(request);

    systemDiscountDao.updateSystemDiscount(request);

    log.info("System discount updated id={} location={} amenity={}",
            request.getSystemDiscountId(), request.getLocationId(), request.getAmenityId());

    ObjectMapper objectMapper = new ObjectMapper();
    objectMapper.registerModule(new JavaTimeModule());
    SystemDiscount sdObj = objectMapper.convertValue(request, SystemDiscount.class);
    sdObj.setId(request.getSystemDiscountId());

    if (SystemDiscountStatus.PUBLISHED.name().equals(request.getSystemDiscountStatus())) {
        droolsRuleService.generateSystemDiscountRule(sdObj, "ADMIN", request.getSessionKey());
    }
}

private void convertDatesToUtcIfPresent(CreateSystemDiscountRequest request) {

    if (request.getStartDate() != null && request.getEndDate() != null
            && !request.getStartDate().isBefore(request.getEndDate())) {
        throw new ValidationException("Start date must be before end date");
    }

    if (request.getStartDate() != null || request.getEndDate() != null) {

        if (request.getLocationId() == null) {
            throw new ValidationException(
                    "locationId is required to resolve timezone when setting start/end date");
        }

        String timezone = systemDiscountDao.getTimezoneByLocation(
                request.getSessionKey(), request.getLocationId().intValue());

        if (request.getStartDate() != null) {
            request.setStartDate(
                    TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
        }
        if (request.getEndDate() != null) {
            request.setEndDate(
                    TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());
        }
    }
}




@Transactional
public Integer createSystemDiscount(CreateSystemDiscountRequest request) {

    if (!request.getStartDate().isBefore(request.getEndDate())) {
        throw new ValidationException("Start date must be before end date");
    }

    String timezone = systemDiscountDao.getTimezoneByLocation(
            request.getSessionKey(), request.getLocationId().intValue());

    request.setStartDate(
            TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
    request.setEndDate(
            TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());

    Integer id = systemDiscountDao.createSystemDiscount(request);

    log.info("Created system discount id={} location={} amenity={}",
            id, request.getLocationId(), request.getAmenityId());

    ObjectMapper objectMapper = new ObjectMapper();
    objectMapper.registerModule(new JavaTimeModule());
    SystemDiscount sdObj = objectMapper.convertValue(request, SystemDiscount.class);
    sdObj.setId(id);

    if (SystemDiscountStatus.PUBLISHED.name().equals(request.getSystemDiscountStatus())) {
        droolsRuleService.generateSystemDiscountRule(sdObj, "ADMIN", request.getSessionKey());
    }

    return id;
}

