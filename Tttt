public Map<String, Object> approveSystemDiscount(String sessionKey, Integer id,
                                                 String approvedBy, String decision) {
    Map<String, Object> params = new HashMap<>();
    params.put("p_Session_Key", sessionKey);
    params.put("p_System_Discount_Id", id);
    params.put("p_Approved_By", approvedBy);
    params.put("p_Approval_Decision", decision);
    return executeSingle(procName: "usp_Approve_System_Discount", params);
}



