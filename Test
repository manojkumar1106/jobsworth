package com.hlt.api.service.serviceimpl;

import com.hlt.api.dao.AuthDao;
import com.hlt.api.dtos.request.TicketRequest;
import com.hlt.api.dtos.response.LoginResponse;
import com.hlt.api.service.IAuthService;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.*;
import org.springframework.stereotype.Service;
import org.springframework.util.LinkedMultiValueMap;
import org.springframework.util.MultiValueMap;
import org.springframework.web.client.RestTemplate;

import java.util.Map;
import java.util.UUID;

@Slf4j
@Service
public class AuthService implements IAuthService {

    @Value("${cognito.admin-client-id}")
    private String clientId;

    @Value("${cognito.admin-client-Secret}")
    private String clientSecret;

    @Value("${cognito.hosted-ui-url}")
    private String hostedUiUrl;

    @Value("${cognito.redirect-uri}")
    private String redirectUri;

    private final AuthDao authDao;
    private final RestTemplate restTemplate;

    public AuthService(AuthDao authDao) {
        this.authDao = authDao;
        this.restTemplate = new RestTemplate();
    }

    // ─────────────────────────────────────────────
    // ALREADY EXISTS — keep exactly as is
    // ─────────────────────────────────────────────
    @Override
    public void startSession(TicketRequest req) {
        log.info("Starting {} session for identity: {}",
                req.getType(), req.getCognitoUserId());

        switch (req.getType().toUpperCase()) {
            case "CLIENT":
                authDao.startClientAdminSession(
                        req.getCognitoUserId(),
                        req.getSessionKey());
                break;
            case "CUSTOMER":
                authDao.startClientCustomerSession(
                        req.getCognitoUserId(),
                        req.getSessionKey());
                break;
            case "GUEST":
                authDao.startGuestSession(
                        req.getSessionKey(),
                        req.getQueryString());
                break;
            // add GLOBAL case if needed
        }
    }

    // ─────────────────────────────────────────────
    // NEW — called by /api/auth/callback
    // After user logs in via Cognito Hosted UI
    // Cognito redirects to /api/auth/callback?code=xxx
    // ─────────────────────────────────────────────
    @Override
    public LoginResponse handleCallback(String code) {

        // 1. Exchange authorization code for JWT tokens
        Map<String, Object> tokenResponse =
                exchangeCodeForTokens(code);

        String accessToken  = (String) tokenResponse.get("access_token");
        String idToken      = (String) tokenResponse.get("id_token");
        String refreshToken = (String) tokenResponse.get("refresh_token");
        String tokenType    = (String) tokenResponse.get("token_type");
        Integer expiresIn   = (Integer) tokenResponse.get("expires_in");

        // 2. Get user email from Cognito userInfo
        String email = getUserEmailFromToken(accessToken);

        // 3. Generate session key
        String sessionKey = UUID.randomUUID().toString();

        // 4. Start session using existing startSession method
        // exactly same pattern as rest of your code
        TicketRequest sessionReq = new TicketRequest();
        sessionReq.setType("CLIENT");
        sessionReq.setCognitoUserId(email);
        sessionReq.setSessionKey(sessionKey);
        startSession(sessionReq);
        // → calls authDao.startClientAdminSession()
        // → calls usp_Start_Client_Admin_Session
        // → stores sessionKey in User_Session table

        log.info("Login successful, session started for: {}", email);

        // 5. Return JWT + session key to frontend
        return new LoginResponse(
                sessionKey,
                accessToken,
                idToken,
                refreshToken,
                tokenType,
                expiresIn,
                "Login successful."
        );
    }

    // ─────────────────────────────────────────────
    // Exchange code for tokens
    // Calls Cognito /oauth2/token endpoint
    // ─────────────────────────────────────────────
    @SuppressWarnings("unchecked")
    private Map<String, Object> exchangeCodeForTokens(String code) {
        String tokenUrl = hostedUiUrl + "/oauth2/token";

        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_FORM_URLENCODED);

        MultiValueMap<String, String> body =
                new LinkedMultiValueMap<>();
        body.add("grant_type",    "authorization_code");
        body.add("client_id",     clientId);
        body.add("client_secret", clientSecret);
        body.add("code",          code);
        body.add("redirect_uri",  redirectUri);

        HttpEntity<MultiValueMap<String, String>> request =
                new HttpEntity<>(body, headers);

        ResponseEntity<Map> response = restTemplate.postForEntity(
                tokenUrl, request, Map.class);

        if (response.getStatusCode() != HttpStatus.OK
                || response.getBody() == null) {
            throw new RuntimeException(
                "Failed to exchange code for tokens");
        }

        return response.getBody();
    }

    // ─────────────────────────────────────────────
    // Get user email from Cognito userInfo endpoint
    // ─────────────────────────────────────────────
    @SuppressWarnings("unchecked")
    private String getUserEmailFromToken(String accessToken) {
        String userInfoUrl = hostedUiUrl + "/oauth2/userInfo";

        HttpHeaders headers = new HttpHeaders();
        headers.setBearerAuth(accessToken);

        HttpEntity<Void> request = new HttpEntity<>(headers);

        ResponseEntity<Map> response = restTemplate.exchange(
                userInfoUrl,
                HttpMethod.GET,
                request,
                Map.class);

        if (response.getStatusCode() != HttpStatus.OK
                || response.getBody() == null) {
            throw new RuntimeException(
                "Failed to get user info from Cognito");
        }

        String email = (String) response.getBody().get("email");
        if (email == null || email.isEmpty()) {
            throw new RuntimeException(
                "Email not found in Cognito user info");
        }

        return email.trim().toLowerCase();
    }
}



