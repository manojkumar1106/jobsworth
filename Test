package com.hlt.api.service.serviceimpl;

import com.hlt.api.dao.AdminDao;
import com.hlt.api.dtos.request.RegisterRequest;
import com.hlt.api.dtos.request.TicketRequest;
import com.hlt.api.dtos.response.RegisterResponse;
import com.hlt.api.service.IAdminService;
import lombok.extern.slf4j.Slf4j;
import org.springframework.context.annotation.Lazy;
import org.springframework.stereotype.Service;

import java.util.HashMap;
import java.util.Map;

@Slf4j
@Service
public class AdminService implements IAdminService {

    private final AdminDao adminDao;
    private final CognitoAdminService cognitoAdminService;

    public AdminService(
            AdminDao adminDao,
            @Lazy CognitoAdminService cognitoAdminService) {
        this.adminDao = adminDao;
        this.cognitoAdminService = cognitoAdminService;
    }

    // ─────────────────────────────────────────────
    // NEW — delegates to CognitoAdminService
    // ─────────────────────────────────────────────
    @Override
    public RegisterResponse createClientUser(
            RegisterRequest request) {
        return cognitoAdminService.createClientUser(request);
    }

    // ─────────────────────────────────────────────
    // ALREADY EXISTS — keep exactly as is
    // ─────────────────────────────────────────────
    @Override
    public void upsertUser(TicketRequest req) {
        log.info("Upserting {} User: {}",
                req.getType(), req.getEmail());

        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key",     req.getSessionKey());
        params.put("p_Cognito_User_Id", req.getCognitoUserId());

        if (!"GLOBAL".equalsIgnoreCase(
                req.getType().toUpperCase())) {
            params.put("p_Email_Address", req.getEmail());
            params.put("p_Phone_Number",  req.getPhone());
        }

        params.put("p_First_Name", req.getFirstName());
        params.put("p_Last_Name",  req.getLastName());

        if ("ADMIN".equalsIgnoreCase(req.getType())) {
            params.put("p_Cognito_User_Pool_Id",
                    req.getUserPoolId());
            adminDao.upsertClientAdmin(params);
        } else if ("CUSTOMER".equalsIgnoreCase(req.getType())) {
            params.put("p_Cognito_User_Pool_Id",
                    req.getUserPoolId());
            params.put("p_Email_Address", req.getEmail());
            adminDao.upsertClientCustomer(params);
        }
    }
}
