@Configuration
public class RedisConfig {

    @Value("${spring.data.redis.username}")
    private String redisUsername;

    @Bean
    public LettuceConnectionFactory redisConnectionFactory() {
        
        String iamToken = generateIamToken();
        
        // Use RedisURI directly — like Carl's example!
        RedisURI redisURI = RedisURI.builder()
            .withHost("snd-ticketing-valkey-x4ubek.serverless.use1.cache.amazonaws.com")
            .withPort(6379)
            .withSsl(true)
            .withAuthentication(redisUsername, iamToken.toCharArray())
            .build();

        LettuceClientConfiguration clientConfig = LettuceClientConfiguration
            .builder()
            .useSsl()
            .build();

        RedisStandaloneConfiguration redisConfig = 
            new RedisStandaloneConfiguration();
        redisConfig.setHostName(redisURI.getHost());
        redisConfig.setPort(redisURI.getPort());
        redisConfig.setUsername(redisUsername);
        redisConfig.setPassword(RedisPassword.of(iamToken));

        return new LettuceConnectionFactory(redisConfig, clientConfig);
    }

    private String generateIamToken() {
        return ElastiCacheAuthTokenGenerator.builder()
            .region(Region.US_EAST_1)
            .credentialsProvider(DefaultCredentialsProvider.create())
            .build()
            .generateAuthToken(
                GenerateAuthTokenRequest.builder()
                    .replicationGroupId("snd-ticketing-valkey-x4ubek")
                    .userName(redisUsername)
                    .build()
            );
    }
}
