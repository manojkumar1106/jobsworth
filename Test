package com.hlt.api.service.serviceimpl;

import com.hlt.api.dtos.request.RegisterRequest;
import com.hlt.api.dtos.request.TicketRequest;
import com.hlt.api.dtos.response.RegisterResponse;
import com.hlt.api.repository.ClientUserRepository;
import com.hlt.api.service.IAdminService;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Qualifier;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Lazy;
import org.springframework.stereotype.Service;
import software.amazon.awssdk.services.cognitoidentityprovider.CognitoIdentityProviderClient;
import software.amazon.awssdk.services.cognitoidentityprovider.model.*;

import java.util.ArrayList;
import java.util.List;

@Slf4j
@Service
public class CognitoAdminService {

    @Value("${cognito.admin-user-pool-id}")
    private String adminUserPoolId;

    @Value("${cognito.hosted-ui-url}")
    private String hostedUiUrl;

    @Value("${cognito.admin-client-id}")
    private String adminClientId;

    private final CognitoIdentityProviderClient cognitoClient;
    private final OtpAuthService otpAuthService;
    private final ClientUserRepository clientUserRepository;
    private final IAdminService adminService;

    public CognitoAdminService(
            @Qualifier("adminCognitoClient")
            CognitoIdentityProviderClient cognitoClient,
            OtpAuthService otpAuthService,
            ClientUserRepository clientUserRepository,
            @Lazy IAdminService adminService) {
        this.cognitoClient = cognitoClient;
        this.otpAuthService = otpAuthService;
        this.clientUserRepository = clientUserRepository;
        this.adminService = adminService;
    }

    // ─────────────────────────────────────────────
    // CREATE CLIENT USER
    // adminSessionKey = Create_Session_Key in DB
    // NO session started here
    // User gets session on login via /api/auth/callback
    // ─────────────────────────────────────────────
    public RegisterResponse createClientUser(
            RegisterRequest request) {

        String adminSessionKey = request.getAdminSessionKey();
        String email     = request.getEmail().trim().toLowerCase();
        String phone     = request.getPhone().trim();
        String firstName = request.getFirstName().trim();
        String lastName  = request.getLastName().trim();

        // 1. Validate
        validateProfileData(email, phone, firstName, lastName);

        // 2. Check duplicate
        if (clientUserRepository.existsByEmailAddress(email)) {
            throw new IllegalArgumentException(
                "A user with this email already exists.");
        }

        // 3. Build Cognito attributes
        List<AttributeType> userAttributes = new ArrayList<>();
        userAttributes.add(AttributeType.builder()
                .name("email").value(email).build());
        userAttributes.add(AttributeType.builder()
                .name("email_verified").value("true").build());
        if (!firstName.isEmpty()) {
            userAttributes.add(AttributeType.builder()
                    .name("given_name").value(firstName).build());
        }
        if (!lastName.isEmpty()) {
            userAttributes.add(AttributeType.builder()
                    .name("family_name").value(lastName).build());
        }
        if (!phone.isEmpty()) {
            userAttributes.add(AttributeType.builder()
                    .name("phone_number").value(phone).build());
        }

        // 4. Generate temp password
        String temporaryPassword = otpAuthService.generateOtp();

        // 5. Create in Cognito
        AdminCreateUserRequest cognitoRequest =
                AdminCreateUserRequest.builder()
                        .userPoolId(adminUserPoolId)
                        .username(email)
                        .temporaryPassword(temporaryPassword)
                        .userAttributes(userAttributes)
                        .messageAction(MessageActionType.SUPPRESS)
                        .build();

        AdminCreateUserResponse cognitoResponse =
                cognitoClient.adminCreateUser(cognitoRequest);

        // 6. Upsert in DB using existing upsertUser
        // adminSessionKey stored as Create_Session_Key
        TicketRequest upsertReq = new TicketRequest();
        upsertReq.setType("ADMIN");
        upsertReq.setSessionKey(adminSessionKey);
        upsertReq.setCognitoUserId(email);
        upsertReq.setUserPoolId(adminUserPoolId);
        upsertReq.setEmail(email);
        upsertReq.setPhone(phone);
        upsertReq.setFirstName(firstName);
        upsertReq.setLastName(lastName);
        adminService.upsertUser(upsertReq);

        // 7. Send welcome email with temp password + login link
        otpAuthService.sendEmail(email, null, temporaryPassword);

        log.info("Client user created by admin: {} for: {}",
                adminSessionKey, email);

        return new RegisterResponse(
                cognitoResponse.user().username(),
                cognitoResponse.user().userStatusAsString(),
                "User created. Temporary password sent to email."
        );
    }

    // ─────────────────────────────────────────────
    // VALIDATE
    // ─────────────────────────────────────────────
    private static void validateProfileData(
            String email, String phone,
            String firstName, String lastName) {

        if (email == null || email.isEmpty())
            throw new IllegalArgumentException(
                "Email is required.");
        if (!email.matches("^[A-Za-z0-9+_.-]+@(.+)$"))
            throw new IllegalArgumentException(
                "Invalid email format.");
        if (phone == null || phone.isEmpty())
            throw new IllegalArgumentException(
                "Phone is required.");
        if (!phone.replaceAll("[^0-9]", "")
                .matches("^\\+?[1-9]\\d{7,14}$"))
            throw new IllegalArgumentException(
                "Invalid phone format.");
        if (firstName == null || firstName.isEmpty())
            throw new IllegalArgumentException(
                "First name is required.");
        if (!firstName.matches("^[a-zA-Z\\s'\\-]{1,100}$"))
            throw new IllegalArgumentException(
                "Invalid first name.");
        if (lastName == null || lastName.isEmpty())
            throw new IllegalArgumentException(
                "Last name is required.");
        if (!lastName.matches("^[a-zA-Z\\s'\\-]{1,100}$"))
            throw new IllegalArgumentException(
                "Invalid last name.");
    }
}



