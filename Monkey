public List<Map<String, Object>> getRentalAmenities(TicketRequest req) {
    Map<String, Object> params = new HashMap<>();
    params.put("p_Session_Key", req.getSessionKey());
    params.put("p_Location_Function_Id", req.getLocationFunctionId());
    return executeList("usp_Get_Rental_Amenities", params);   // same list method used by getRentalAmenityDetails
}


