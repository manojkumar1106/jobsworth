package com.hlt.api.service.serviceimpl;

import com.hlt.api.dao.AmenityPriceTypeDao;
import com.hlt.api.dtos.request.TicketRequest;
import com.hlt.api.service.IAmenityPriceTypeService;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;

@Slf4j
@Service
public class AmenityPriceTypeService implements IAmenityPriceTypeService {

    @Autowired
    private AmenityPriceTypeDao amenityPriceTypeDao;

    @Override
    public List<Map<String, Object>> getAmenityPricing(TicketRequest req) {
        log.info("Fetching Amenity Pricing for amenityId: {}", req.getAmenityId());
        List<Map<String, Object>> flatRows = amenityPriceTypeDao.getAmenityPricing(req);
        return groupPricingByAmenity(flatRows);
    }

    // usp_Get_Amenity_Pricing returns one flat row per (Amenity_Id, Price_Type_Id):
    // amenityId, priceTypeId, amenityPriceTypeName, amenityBasePrice.
    // Frontend wants { amenityId, prices: [{ category, price }, ...] } -
    // group here the same way SalesFunnelService.groupAmenitiesByLocation does.
    private List<Map<String, Object>> groupPricingByAmenity(List<Map<String, Object>> flatRows) {
        Map<Object, Map<String, Object>> groupsByAmenityId = new LinkedHashMap<>();
        if (flatRows == null) {
            return List.of();
        }
        for (Map<String, Object> row : flatRows) {
            Object amenityId = row.get("amenityId");
            Map<String, Object> amenityGroup = groupsByAmenityId.computeIfAbsent(amenityId, id -> {
                Map<String, Object> group = new LinkedHashMap<>();
                group.put("amenityId", id);
                group.put("prices", new ArrayList<Map<String, Object>>());
                return group;
            });

            Map<String, Object> price = new LinkedHashMap<>();
            price.put("category", row.get("priceTypeId"));
            price.put("price", row.get("amenityBasePrice"));
            price.put("label", row.get("amenityPriceTypeName"));
            @SuppressWarnings("unchecked")
            List<Map<String, Object>> prices = (List<Map<String, Object>>) amenityGroup.get("prices");
            prices.add(price);
        }
        return new ArrayList<>(groupsByAmenityId.values());
    }

    @Override
    @Transactional
    public Integer createAmenityPriceType(TicketRequest req) {
        log.info("Creating Amenity Price Type: {}", req.getAmenityPriceTypeName());
        Integer newId = amenityPriceTypeDao.createAmenityPriceType(req);
        req.setAmenityPriceTypeId(newId);
        return newId;
    }

    @Override
    @Transactional
    public Integer updateAmenityPriceType(TicketRequest req) {
        log.info("Updating Amenity Price Type: {}", req.getAmenityPriceTypeId());
        return amenityPriceTypeDao.updateAmenityPriceType(req);
    }

    @Override
    @Transactional
    public String deleteAmenityPriceType(TicketRequest req) {
        log.info("Soft-deleting Amenity Price Type: {}", req.getAmenityPriceTypeId());
        return amenityPriceTypeDao.deleteAmenityPriceType(req);
    }
}


