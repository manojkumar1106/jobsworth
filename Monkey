@RestController
@RequestMapping("/api/v1/location-schedules")
@RequiredArgsConstructor
public class LocationScheduleController {

    private final ILocationScheduleService locationScheduleService;

    // usp_Get_Location_Schedule_Types
    @Operation(summary = "Get Location Schedule Types")
    @PostMapping("/types/get")
    public ApiResponse<List<Map<String, Object>>> getLocationScheduleTypes(@RequestBody TicketRequest req,
                                                                           @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        return ApiResponse.success("Location Schedule Types", locationScheduleService.getLocationScheduleTypes(req));
    }

    // usp_Upsert_Location_Schedule
    @Operation(summary = "Upsert Location Schedule (Hours of Operation)")
    @PostMapping("/upsert")
    public ApiResponse<Void> upsertLocationSchedule(@RequestBody TicketRequest req,
                                                    @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        locationScheduleService.upsertLocationSchedule(req);
        return ApiResponse.success("Hours of operation saved", null);
    }
}




