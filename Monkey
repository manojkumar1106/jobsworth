private List<Map<String, Object>> priceTypes;
// getter and setter if no Lombok


@Override
public Integer createAmenityPriceType(TicketRequest req) {
    List<Map<String, Object>> list = req.getPriceTypes();

    if (req.getAmenityId() == null || list == null || list.isEmpty() || list.size() > 15) {
        throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                "amenityId and 1 to 15 price types are required");
    }

    // [{name, price}, ...] -> 'adult,5.00|children,3.00'
    String priceTypeList = list.stream()
        .map(m -> m.get("amenityPriceTypeName").toString().replaceAll("[,|]", "").trim()
                + "," + new BigDecimal(m.get("amenityBasePrice").toString())
                        .setScale(2, RoundingMode.HALF_UP).toPlainString())
        .collect(Collectors.joining("|"));

    if (priceTypeList.length() > 1000) { // p_Amenity_Price_Type_List is VARCHAR(1000)
        throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Price type list too long");
    }

    return amenityPriceTypeDao.createAmenityPriceType(req, 
