// BaseDao.java: replace ONLY the validateResultCode method with this. Nothing else changes.
// Codes and names are exactly as on the Confluence page.

    private void validateResultCode(Map<String, Object> out, String procName) {
        int code = (int) out.getOrDefault("p_Result_Code", 0);

        if (code == 1) return;                                                                   //  1: Success
        if (code == -2) throw new SecurityException("Session Exception in " + procName);         // -2: Session Exception
        if (code == -3) throw new SecurityException("User/Permission Exception in " + procName); // -3: User/Permission Exception
        if (code == -4) throw new IllegalArgumentException("Parameter Exception in " + procName);// -4: Parameter Exception
        throw new RuntimeException("Unhandled Exception in " + procName);                        // -1: Unhandled Exception (and any other code)
    }
