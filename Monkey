// src/service/customer/rentalamenities/customerRentalAmenityService.ts
import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../../utils/commonValidator";
import { httpClient } from "../../../utils/http/httpClient";
import { createRentalInquiryRules } from "../../../schema/customer/rentalamenities/validator/customerRentalAmenityValidator";

async function callCustomerRentalAmenityData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/customer/rental-inquiries${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      body: method === "GET" ? undefined : request,
    },
    context.logger,
    context
  );
}

//------------Customer Rental Inquiry --------------

export async function createRentalInquiry(request: any, context: any) {
  return await callCustomerRentalAmenityData(
    "POST",
    "/create",
    request,
    context,
    createRentalInquiryRules
  );
}




