package hlt.promo.engine.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import hlt.promo.engine.client.PromotionApiClient;
import hlt.promo.engine.dto.*;
import hlt.promo.engine.exception.ValidationException;
import hlt.promo.engine.model.DiscountStatus;
import hlt.promo.engine.model.SystemDiscount;
import hlt.promo.engine.util.TimezoneConverter;
import lombok.RequiredArgsConstructor;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.BeanUtils;
import org.springframework.stereotype.Service;

import java.sql.Timestamp;
import java.time.LocalDateTime;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Service
@RequiredArgsConstructor
public class SystemDiscountServiceNew {

    private static final Logger log = LoggerFactory.getLogger(SystemDiscountServiceNew.class);

    private final PromotionApiClient promotionApiClient;
    private final DroolsRuleService droolsRuleService;
    private final DroolsEngineService droolsEngineService;

    @jakarta.transaction.Transactional
    public CreateSystemDiscountResponse createSystemDiscount(CreateSystemDiscountRequest request) {

        if (!request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        String timezone = promotionApiClient.getTimezone(
                request.getSessionKey(), request.getLocationId().intValue());

        request.setStartDate(TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
        request.setEndDate(TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());

        Map<String, Object> systemDiscount = promotionApiClient.createSystemDiscount(request.getSessionKey(), request);

        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.registerModule(new JavaTimeModule());
        SystemDiscount sdObj = objectMapper.convertValue(systemDiscount, SystemDiscount.class);

        log.info("Created system discount id={} location={} amenity={}",
                sdObj.getId(), request.getLocationId(), request.getAmenityId());

        boolean needsApproval = Boolean.TRUE.equals(request.getManagerApprovalRequired());
        if (needsApproval) {
            log.info("Created system discount id={} status=PENDING_APPROVAL. No Drools.", sdObj.getId());
            return new CreateSystemDiscountResponse(sdObj.getId(), "PENDING_APPROVAL");
        } else {
            // FALSE -> PUBLISHED, generate Drools
            droolsRuleService.generateSystemDiscountRule(sdObj, "ADMIN", request.getSessionKey());
            log.info("Created system discount id={} status=PUBLISHED. Drools generated.", sdObj.getId());
            return new CreateSystemDiscountResponse(sdObj.getId(), "PUBLISHED");
        }
    }

    @jakarta.transaction.Transactional
    public UpdateSystemDiscountResponse updateSystemDiscount(UpdateSystemDiscountRequest request) {

        convertDatesToUtcIfPresent(request);
        Map<String, Object> systemDiscount;
        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.registerModule(new JavaTimeModule());
        SystemDiscount sdObj = new SystemDiscount();
        boolean needsApproval = Boolean.TRUE.equals(request.getManagerApprovalRequired());

        if (needsApproval) {
            CreateSystemDiscountRequest create = new CreateSystemDiscountRequest();
            BeanUtils.copyProperties(request, create);
            systemDiscount = promotionApiClient.createSystemDiscount(request.getSessionKey(), create);
            if (systemDiscount == null) {
                throw new IllegalArgumentException("System discount not found for id=" + request.getSystemDiscountId());
            }
            sdObj = objectMapper.convertValue(systemDiscount, SystemDiscount.class);
            log.info("Created pending child {} for discount {}. Original UNTOUCHED.", sdObj.getParentId(), sdObj.getId());
            return new UpdateSystemDiscountResponse(sdObj.getId(), sdObj.getParentId(), "PENDING_APPROVAL");
        } else {
            systemDiscount = promotionApiClient.updateSystemDiscount(request.getSessionKey(), request);
            if (systemDiscount == null) {
                throw new IllegalArgumentException("System discount not found for id=" + request.getSystemDiscountId());
            }
            sdObj = objectMapper.convertValue(systemDiscount, SystemDiscount.class);
            log.info("System discount updated id={} location={} amenity={}",
                    request.getSystemDiscountId(), request.getLocationId(), request.getAmenityId());

            if (DiscountStatus.INACTIVE.equals(sdObj.getStatus())) {
                // deactivated - nothing further to publish
            } else {
                droolsRuleService.generateSystemDiscountRule(sdObj, "ADMIN", request.getSessionKey());
            }
            return new UpdateSystemDiscountResponse(sdObj.getId(), sdObj.getParentId(), DiscountStatus.PUBLISHED.name());
        }
    }

    private void convertDatesToUtcIfPresent(UpdateSystemDiscountRequest request) {
        if (request.getStartDate() != null && request.getEndDate() != null
                && !request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        if (request.getStartDate() != null || request.getEndDate() != null) {
            if (request.getLocationId() == null) {
                throw new ValidationException("locationId is required to resolve timezone when setting start/end date");
            }
            String timezone = promotionApiClient.getTimezone(
                    request.getSessionKey(), request.getLocationId().intValue());

            if (request.getStartDate() != null) {
                request.setStartDate(TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
            }
            if (request.getEndDate() != null) {
                request.setEndDate(TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());
            }
        }
    }

    public List<Map<String, Object>> getAllSystemDiscounts(String sessionKey) {
        log.info("Fetching system discounts for session: {}", sessionKey);
        List<Map<String, Object>> discounts = promotionApiClient.getAllSystemDiscounts(sessionKey);

        Map<Long, String> timezoneCache = new HashMap<>();
        for (Map<String, Object> discount : discounts) {
            Object locationIdObj = discount.get("locationId");
            if (locationIdObj == null) continue;
            Long locationId = ((Number) locationIdObj).longValue();

            String timezone = timezoneCache.computeIfAbsent(locationId,
                    id -> promotionApiClient.getTimezone(sessionKey, id.intValue()));

            if (discount.get("startDate") != null) {
                discount.put("startDate", TimezoneConverter.toLocal(asLocalDateTime(discount.get("startDate")), timezone));
            }
            if (discount.get("endDate") != null) {
                discount.put("endDate", TimezoneConverter.toLocal(asLocalDateTime(discount.get("endDate")), timezone));
            }
        }
        return discounts;
    }

    private LocalDateTime asLocalDateTime(Object value) {
        if (value == null) return null;
        if (value instanceof LocalDateTime) return (LocalDateTime) value;
        if (value instanceof Timestamp) return ((Timestamp) value).toLocalDateTime();
        if (value instanceof String) return LocalDateTime.parse((String) value);
        return null;
    }

    @jakarta.transaction.Transactional
    public SystemDiscount approveSystemDiscount(String sessionKey, Integer id, String decision, String rejectionReason) {

        Map<String, Object> row = promotionApiClient.approveSystemDiscount(sessionKey, id, decision, rejectionReason);

        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.registerModule(new JavaTimeModule());
        SystemDiscount sdObj = objectMapper.convertValue(row, SystemDiscount.class);

        log.info("System discount {} for id={}", decision, id);

        // Only generate the rule when approved - rejection leaves it unpublished
        if ("APPROVED".equals(decision)) {
            droolsRuleService.generateSystemDiscountRule(sdObj, "ADMIN", sessionKey);
        }
        return sdObj;
    }

    @jakarta.transaction.Transactional
    public ApiResponse<String> removeSystemDiscount(Integer systemDiscountId, String sessionKey) {

        // API side removes the discount row and its rule definitions atomically.
        Map<String, Object> result = promotionApiClient.removeSystemDiscount(systemDiscountId, sessionKey);
        log.info("System discount {} removed. Rule rows affected: {}", systemDiscountId, result.get("ruleResult"));

        droolsEngineService.reloadRules();
        log.info("Rules reloaded after removing system discount id={}", systemDiscountId);

        return ApiResponse.success("System discount removed", null);
    }
}

