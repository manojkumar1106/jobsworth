@PostMapping("/details")
public ApiResponse<List<Map<String, Object>>> getSalesFunnelDetails(@RequestBody TicketRequest req,
                                                                      @AuthenticationPrincipal Jwt jwt) {
    if (jwt != null) {
        req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
    }
    List<Map<String, Object>> funnel = salesFunnelService.getSalesFunnelDetails(req);
    return ApiResponse.success("Sales Funnel Details Retrieved", funnel);
}


