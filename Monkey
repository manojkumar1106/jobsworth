import { httpClient } from "../../../utils/http/httpClient";

async function callCustomerFunnelData(method: string, endpoint: string, request: any, context: any) {
  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/customer/funnels${endpoint}`;
  return await httpClient(
    url,
    { method, body: method === "GET" ? undefined : request },
    context.logger,
    context
  );
}

export async function getCustomerSalesFunnel(request: any, context: any) {
  return await callCustomerFunnelData("GET", "/get", request, context);
}
export async function getCustomerSalesFunnelDetails(request: any, context: any) {
  return await callCustomerFunnelData("POST", "/details", request, context);
}
export async function getCustomerSalesFunnelAmenities(request: any, context: any) {
  return await callCustomerFunnelData("POST", "/amenities", request, context);
}



