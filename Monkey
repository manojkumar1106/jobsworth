@Operation(summary = "Get Location Schedule (Hours of Operation)")
@PostMapping("/get")
public ApiResponse<Map<String, Object>> getLocationSchedule(@RequestBody TicketRequest req,
                                                            @AuthenticationPrincipal Jwt jwt) {
    if (jwt != null) {
        req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
    }
    return ApiResponse.success("Location Schedule", locationScheduleService.getLocationSchedule(req));
}

