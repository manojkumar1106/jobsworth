import {
  getCustomerSalesFunnel,
  getCustomerSalesFunnelDetails,
  getCustomerSalesFunnelAmenities,
} from "../../../service/customer/salesfunnel/customerSalesFunnelService";
import { getCustomerAmenityPricing } from "../../../service/customer/pricetypes/priceTypeService";

const unwrap = (res: any) => res?.data ?? null;

const loadFunnels = async (ctx: any) =>
  unwrap(await getCustomerSalesFunnel({}, ctx)) ?? [];
const loadDetails = async (salesFunnelId: number, ctx: any) =>
  unwrap(await getCustomerSalesFunnelDetails({ salesFunnelId }, ctx));
const loadAmenities = async (salesFunnelId: number, ctx: any) =>
  unwrap(await getCustomerSalesFunnelAmenities({ salesFunnelId }, ctx)) ?? [];
const loadPricing = async (amenityId: number, ctx: any) =>
  unwrap(await getCustomerAmenityPricing({ amenityId }, ctx)) ?? [];

// Looks up one funnel from the list. Cached on the parent so asking for
// salesFunnelName and urlSlug together only calls the list API once.
const findFunnel = async (p: any, ctx: any) => {
  p._funnel ??= loadFunnels(ctx).then(
    (list: any[]) =>
      list.find((f) => f.salesFunnelId === p.salesFunnelId) ?? null
  );
  return p._funnel;
};

export const customerSalesFunnelResolvers = {
  Query: {
    getCustomerSalesFunnel: (_: any, __: any, ctx: any) => loadFunnels(ctx),

    // returns only the id; the other fields resolve lazily below
    getCustomerSalesFunnelById: (_: any, { request }: any) => ({
      salesFunnelId: request.salesFunnelId,
    }),

    getCustomerSalesFunnelDetails: (_: any, { request }: any, ctx: any) =>
      loadDetails(request.salesFunnelId, ctx),

    getCustomerSalesFunnelAmenities: (_: any, { request }: any, ctx: any) =>
      loadAmenities(request.salesFunnelId, ctx),
  },

  CustomerSalesFunnel: {
    salesFunnelName: async (p: any, _: any, ctx: any) =>
      p.salesFunnelName !== undefined
        ? p.salesFunnelName
        : (await findFunnel(p, ctx))?.salesFunnelName ?? null,

    urlSlug: async (p: any, _: any, ctx: any) =>
      p.urlSlug !== undefined
        ? p.urlSlug
        : (await findFunnel(p, ctx))?.urlSlug ?? null,

    details: (p: any, _: any, ctx: any) => loadDetails(p.salesFunnelId, ctx),
    amenities: (p: any, _: any, ctx: any) =>
      loadAmenities(p.salesFunnelId, ctx),
  },

  CustomerFunnelAmenity: {
    pricing: (p: any, _: any, ctx: any) => loadPricing(p.amenityId, ctx),
  },
};
