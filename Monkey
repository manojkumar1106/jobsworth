    Map<String, Object> updatePromotion(PromoRequest body, String sessionKey);
    List<Map<String, Object>> getAllPromotions(String sessionKey);
    Map<String, Object> getPromotionByCode(String sessionKey, String promoCode);
    /** Removes the promotion and its rule definitions in one transaction. */
    Map<String, Object> removePromotion(Integer promotionId, String sessionKey);

    // system discounts
    String getTimezone(String sessionKey, Integer locationId);
    Map<String, Object> createSystemDiscount(PromoRequest body, String sessionKey);
    Map<String, Object> updateSystemDiscount(PromoRequest body, String sessionKey);
    List<Map<String, Object>> getAllSystemDiscounts(String sessionKey);
    Map<String, Object> approveSystemDiscount(String sessionKey, Integer id, String decision, String rejectionReason);
    /** Removes the system discount and its rule definitions in one transaction. */
    Map<String, Object> removeSystemDiscount(Integer id, String sessionKey);

    // rule definitions
    List<Map<String, Object>> getAllRuleDefinitions(String sessionKey);
    List<Map<String, Object>> getReloadRules(String sessionKey);
    Map<String, Object> createRuleDefinition(PromoRequest body, String sessionKey);
    Map<String, Object> updateRuleDefinition(PromoRequest body, String sessionKey);
    Map<String, Object> findActiveRule(String ruleType, Long referenceId, String sessionKey);
    Integer deactivateRuleDefinition(Long ruleDefinitionId, String sessionKey);

    // history / usage / audit
    Map<String, Object> createRuleHistory(PromoRequest body, String sessionKey);
    void usePromo(String sessionKey, PromoRequest body);
    Map<String, Object> getUsageSummary(String promoCode, Integer customerId);
    Map<String, Object> createDiscountAuditLog(PromoRequest body, String sessionKey);
    List<Map<String, Object>> getAuditLogsByCustomer(String sessionKey, String customerId);
}


package com.hlt.api.promotion.serviceimpl;

import com.hlt.api.promotion.dao.*;
import com.hlt.api.promotion.service.IPromotionApiService;
import com.hlt.api.promotion.dto.PromoRequest;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Service
@RequiredArgsConstructor
public class PromotionApiServiceImpl implements IPromotionApiService {

    private final PromotionDao promotionDao;
    private final SystemDiscountDao systemDiscountDao;
    private final RuleDefinitionDao ruleDefinitionDao;
    private final RuleHistoryDao ruleHistoryDao;
    private final PromoUsageDao promoUsageDao;
    private final DiscountAuditLogDao discountAuditLogDao;

    // ---------- promotions ----------
    @Override public Map<String, Object> createPromotion(PromoRequest body, String sk) { return promotionDao.createPromotion(body, sk); }
    @Override public Map<String, Object> updatePromotion(PromoRequest body, String sk) { return promotionDao.updatePromotion(body, sk); }
    @Override public List<Map<String, Object>> getAllPromotions(String sk) { return promotionDao.getAllPromotions(sk); }
    @Override public Map<String, Object> getPromotionByCode(String sk, String code) { return promotionDao.getPromotionByCode(sk, code); }

    @Override
    @Transactional
    public Map<String, Object> removePromotion(Integer promotionId, String sk) {
        Integer promoResult = promotionDao.removePromotion(promotionId, sk);
        if (promoResult == null || promoResult == 0) {
            throw new IllegalArgumentException("Promotion not found for id=" + promotionId);
        }
        Integer ruleResult = ruleDefinitionDao.removeRuleDefinitionByReference("PROMOTION", promotionId, sk);
        return removeResult(promoResult, ruleResult);
    }

    // ---------- system discounts ----------
    @Override public String getTimezone(String sk, Integer locationId) { return systemDiscountDao.getTimezoneByLocation(sk, locationId); }
    @Override public Map<String, Object> createSystemDiscount(PromoRequest body, String sk) { return systemDiscountDao.createSystemDiscount(body, sk); }
    @Override public Map<String, Object> updateSystemDiscount(PromoRequest body, String sk) { return systemDiscountDao.updateSystemDiscount(body, sk); }
    @Override public List<Map<String, Object>> getAllSystemDiscounts(String sk) { return systemDiscountDao.getAllSystemDiscounts(sk); }
    @Override public Map<String, Object> approveSystemDiscount(String sk, Integer id, String decision, String reason) { return systemDiscountDao.approveSystemDiscount(sk, id, decision, reason); }

    @Override
    @Transactional
    public Map<String, Object> removeSystemDiscount(Integer id, String sk) {
        Integer sdResult = systemDiscountDao.removeSystemDiscount(id, sk);
        if (sdResult == null || sdResult == 0) {
            throw new IllegalArgumentException("System discount not found for id=" + id);
        }
        Integer ruleResult = ruleDefinitionDao.removeRuleDefinitionByReference("SYSTEM_DISCOUNT", id, sk);
        return removeResult(sdResult, ruleResult);
    }

    // ---------- rule definitions ----------
    @Override public List<Map<String, Object>> getAllRuleDefinitions(String sk) { return ruleDefinitionDao.getAllRuleDefinitions(sk); }
    @Override public List<Map<String, Object>> getReloadRules(String sk) { return ruleDefinitionDao.getReloadRules(sk); }
    @Override public Map<String, Object> createRuleDefinition(PromoRequest body, String sk) { return ruleDefinitionDao.createRuleDefinition(body, sk); }
    @Override public Map<String, Object> updateRuleDefinition(PromoRequest body, String sk) { return ruleDefinitionDao.updateRuleDefinition(body, sk); }
    @Override public Map<String, Object> findActiveRule(String type, Long refId, String sk) { return ruleDefinitionDao.findByRuleTypeAndReferenceIdAndActiveTrue(type, refId, sk); }
    @Override public Integer deactivateRuleDefinition(Long id, String sk) { return ruleDefinitionDao.deactivateRuleDefinition(id, sk); }

    // ---------- history / usage / audit ----------
    @Override public Map<String, Object> createRuleHistory(PromoRequest body, String sk) { return ruleHistoryDao.createRuleHistory(body, sk); }

    @Override
    public void usePromo(String sk, PromoRequest body) {
        promoUsageDao.usePromo(sk, body.getPromoCode(), body.getCustomerId(),
                body.getUsageLimit(), body.getMaxUsagePerCustomer());
    }

    @Override public Map<String, Object> getUsageSummary(String code, Integer customerId) { return promoUsageDao.getUsageSummary(code, customerId); }
    @Override public Map<String, Object> createDiscountAuditLog(PromoRequest body, String sk) { return discountAuditLogDao.createDiscountAuditLog(body, sk); }
    @Override public List<Map<String, Object>> getAuditLogsByCustomer(String sk, String customerId) { return discountAuditLogDao.getAuditLogsByCustomer(sk, customerId); }

    private Map<String, Object> removeResult(Integer mainResult, Integer ruleResult) {
        Map<String, Object> res = new HashMap<>();
        res.put("result", mainResult);
        res.put("ruleResult", ruleResult);
        return res;
    }

}


