        String tz = req.getTimezone();
        TimezoneConverter.validateTimezone(tz);

        List<Map<String, Object>> rows = customerAmenityDao.getAvailableAmenityDates(req);

        // Non-rental amenities return occurrenceStartAt / occurrenceEndAt in UTC -> convert to the venue's local time.
        // Rental amenities return only scheduleDay (already a local date string), so these keys are absent and skipped.
        for (Map<String, Object> row : rows) {
            if (row.get("occurrenceStartAt") != null) {
                row.put("occurrenceStartAt", TimezoneConverter.toLocal((LocalDateTime) row.get("occurrenceStartAt"), tz));
            }
            if (row.get("occurrenceEndAt") != null) {
                row.put("occurrenceEndAt", TimezoneConverter.toLocal((LocalDateTime) row.get("occurrenceEndAt"), tz));
            }
        }
        return rows;   // read-only call, so no @Transactional




