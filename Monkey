// src/schema/customer/salesfunnel/validators/customerSalesFunnelValidator.ts

import { FieldRule } from "../../../../utils/commonValidator";

const requiredInteger: FieldRule = {
  type: "integer",
  required: true,
};

// Rejects missing, null, empty and whitespace-only session keys
const requiredSessionKey: FieldRule = {
  type: "string",
  required: true,
};

// GetCustomerSalesFunnel input
export const getCustomerSalesFunnelRules: Record<string, FieldRule> = {
  sessionKey: requiredSessionKey,
};

// GetCustomerSalesFunnelDetails input
export const getCustomerSalesFunnelDetailsRules: Record<string, FieldRule> = {
  salesFunnelId: requiredInteger,
  sessionKey: requiredSessionKey,
};

// GetCustomerSalesFunnelAmenities input
export const getCustomerSalesFunnelAmenitiesRules: Record<string, FieldRule> = {
  salesFunnelId: requiredInteger,
  sessionKey: requiredSessionKey,
};




