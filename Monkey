package hlt.promo.engine.client;

import hlt.promo.engine.exception.HltApiException;
import hlt.promo.engine.exception.PromoLimitExceededException;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.core.ParameterizedTypeReference;
import org.springframework.http.MediaType;
import org.springframework.stereotype.Service;
import org.springframework.web.client.ResourceAccessException;
import org.springframework.web.client.RestClient;
import org.springframework.web.client.RestClientResponseException;

import java.util.List;
import java.util.Map;
import java.util.function.Supplier;

@Service
@RequiredArgsConstructor
@Slf4j
public class PromotionApiClient {

    private static final ParameterizedTypeReference<Map<String, Object>> MAP = new ParameterizedTypeReference<>() {};
    private static final ParameterizedTypeReference<List<Map<String, Object>>> LIST = new ParameterizedTypeReference<>() {};
    private static final String SESSION = "X-Session-Key";

    private final RestClient hltRestClient;

    // ---------------- promotions ----------------
    public Map<String, Object> getPromotionByCode(String sessionKey, String promoCode) {
        return get(sessionKey, "/api/v1/promotions/code/{c}", MAP, promoCode);
    }

    public List<Map<String, Object>> getAllPromotions(String sessionKey) {
        return get(sessionKey, "/api/v1/promotions", LIST);
    }

    public Map<String, Object> createPromotion(String sessionKey, Object request) {
        return send(sessionKey, "POST", "/api/v1/promotions", request, MAP);
    }

    public Map<String, Object> updatePromotion(String sessionKey, Object request) {
        return send(sessionKey, "PUT", "/api/v1/promotions", request, MAP);
    }

    /** Removes promotion + its rule definitions atomically on the API side. Call reloadRules() afterwards. */
    public Map<String, Object> removePromotion(Integer promotionId, String sessionKey) {
        return send(sessionKey, "POST", "/api/v1/promotions/" + promotionId + "/remove", null, MAP);
    }

    // ---------------- system discounts ----------------
    public String getTimezone(String sessionKey, Integer locationId) {
        return execute(() -> hltRestClient.get()
                .uri("/api/v1/locations/{id}/timezone", locationId)
                .header(SESSION, sessionKey)
                .retrieve()
                .body(String.class));
    }

    public List<Map<String, Object>> getAllSystemDiscounts(String sessionKey) {
        return get(sessionKey, "/api/v1/system-discounts", LIST);
    }

    public Map<String, Object> createSystemDiscount(String sessionKey, Object request) {
        return send(sessionKey, "POST", "/api/v1/system-discounts", request, MAP);
    }

    public Map<String, Object> updateSystemDiscount(String sessionKey, Object request) {
        return send(sessionKey, "PUT", "/api/v1/system-discounts", request, MAP);
    }

    public Map<String, Object> approveSystemDiscount(String sessionKey, Integer id, String decision, String rejectionReason) {
        return execute(() -> hltRestClient.put()
                .uri(b -> b.path("/api/v1/system-discounts/{id}/approve")
                        .queryParam("decision", decision)
                        .queryParamIfPresent("rejectionReason", java.util.Optional.ofNullable(rejectionReason))
                        .build(id))
                .header(SESSION, sessionKey)
                .retrieve()
                .body(MAP));
    }

    public Map<String, Object> removeSystemDiscount(Integer id, String sessionKey) {
        return send(sessionKey, "POST", "/api/v1/system-discounts/" + id + "/remove", null, MAP);
    }

    // ---------------- rule definitions ----------------
    public List<Map<String, Object>> getAllRuleDefinitions(String sessionKey) {
        return get(sessionKey, "/api/v1/rule-definitions", LIST);
    }

    public List<Map<String, Object>> getReloadRules(String sessionKey) {
        return get(sessionKey, "/api/v1/rule-definitions/reload", LIST);
    }

    public Map<String, Object> createRuleDefinition(Object rule, String sessionKey) {
        return send(sessionKey, "POST", "/api/v1/rule-definitions", rule, MAP);
    }

    public Map<String, Object> updateRuleDefinition(Object rule, String sessionKey) {
        return send(sessionKey, "PUT", "/api/v1/rule-definitions", rule, MAP);
    }

    /** Returns an empty map when there is no active rule. */
    public Map<String, Object> findActiveRule(String ruleType, Long referenceId, String sessionKey) {
        return get(sessionKey, "/api/v1/rule-definitions/by-reference?ruleType={t}&referenceId={r}", MAP, ruleType, referenceId);
    }

    public Integer deactivateRuleDefinition(Long ruleDefinitionId, String sessionKey) {
        Map<String, Object> res = send(sessionKey, "POST",
                "/api/v1/rule-definitions/" + ruleDefinitionId + "/deactivate", null, MAP);
        return res != null && res.get("result") != null ? ((Number) res.get("result")).intValue() : null;
    }

    // ---------------- history / usage / audit ----------------
    public Map<String, Object> createRuleHistory(Object history, String sessionKey) {
        return send(sessionKey, "POST", "/api/v1/rule-history", history, MAP);
    }

    public void usePromo(String sessionKey, String promoCode, Integer customerId,
                         Integer usageLimit, Integer maxUsagePerCustomer) {
        Map<String, Object> body = new java.util.HashMap<>();
        body.put("promoCode", promoCode);
        body.put("customerId", customerId);
        body.put("usageLimit", usageLimit);
        body.put("maxUsagePerCustomer", maxUsagePerCustomer);
        execute(() -> {
            hltRestClient.post().uri("/api/v1/promo-usage/use")
                    .header(SESSION, sessionKey)
                    .contentType(MediaType.APPLICATION_JSON)
                    .body(body)
                    .retrieve()
                    .toBodilessEntity();
            return null;
        });
    }

    /** Keys: totalUsage, customerUsage */
    public Map<String, Object> getUsageSummary(String sessionKey, String promoCode, Integer customerId) {
        return get(sessionKey, "/api/v1/promo-usage/summary?promoCode={p}&customerId={c}", MAP, promoCode, customerId);
    }

    public Map<String, Object> createDiscountAuditLog(Object log, String sessionKey) {
        return send(sessionKey, "POST", "/api/v1/discount-audit-logs", log, MAP);
    }

    public List<Map<String, Object>> getAuditLogsByCustomer(String sessionKey, String customerId) {
        return get(sessionKey, "/api/v1/discount-audit-logs?customerId={c}", LIST, customerId);
    }

    // ---------------- plumbing ----------------
    private <T> T get(String sessionKey, String uri, ParameterizedTypeReference<T> type, Object... vars) {
        return execute(() -> hltRestClient.get()
                .uri(uri, vars)
                .header(SESSION, sessionKey)
                .retrieve()
                .body(type));
    }

    private <T> T send(String sessionKey, String method, String uri, Object body, ParameterizedTypeReference<T> type) {
        return execute(() -> {
            RestClient.RequestBodySpec spec = hltRestClient.method(org.springframework.http.HttpMethod.valueOf(method))
                    .uri(uri)
                    .header(SESSION, sessionKey)
                    .contentType(MediaType.APPLICATION_JSON);
            if (body != null) {
                spec = spec.body(body);
            }
            return spec.retrieve().body(type);
        });
    }

    /** Maps API HTTP statuses back to the exception types the promo code already expects. */
    private <T> T execute(Supplier<T> operation) {
        try {
            return operation.get();
        } catch (RestClientResponseException ex) {
            int status = ex.getStatusCode().value();
            String message = extractMessage(ex);
            log.error("hlt-api returned HTTP {}: {}", status, message);
            switch (status) {
                case 400 -> throw new IllegalArgumentException(message);
                case 401, 403 -> throw new SecurityException(message);
                case 409 -> throw new PromoLimitExceededException(message);
                default -> throw new HltApiException("hlt-api request failed with HTTP status " + status, ex);
            }
        } catch (ResourceAccessException ex) {
            log.error("Unable to connect to hlt-api");
            throw new HltApiException("Unable to connect to hlt-api", ex);
        }
    }

    @SuppressWarnings("unchecked")
    private String extractMessage(RestClientResponseException ex) {
        try {
            Map<String, Object> body = ex.getResponseBodyAs(Map.class);
            if (body != null && body.get("message") != null) {
                return body.get("message").toString();
            }
        } catch (Exception ignored) {
            // fall through
        }
        return ex.getResponseBodyAsString();
    }
}



