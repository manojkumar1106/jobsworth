@Override
public List<Map<String, Object>> getCustomerSalesFunnelAmenities(TicketRequest req) {
    log.info("Getting customer sales funnel amenities: {}", req.getSalesFunnelId());
    List<Map<String, Object>> amenities =
            customerSalesFunnelDao.getCustomerSalesFunnelAmenities(req);

    for (Map<String, Object> amenity : amenities) {
        convertScheduleDatesToLocal(amenity);
    }
    return amenities;
}

private void convertScheduleDatesToLocal(Map<String, Object> amenity) {
    Object dates = amenity.get("allAmenityScheduleDates");
    Object timezone = amenity.get("amenityTimezone");
    if (dates == null || timezone == null) {
        return; // GA amenities with no schedules come back null
    }
    amenity.put("allAmenityScheduleDates",
            ScheduleTimezoneUtil.datesToLocal(dates, timezone.toString()));
}
