import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../utils/commonValidator";
import { httpClient } from "../../utils/http/httpClient";
import { upsertRentalAmenityRules } from "../../schema/rentalamenities/validators/rentalAmenityValidator";

async function callCustomerRentalAmenityData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/customer/rental-amenities${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      body: method === "GET" ? undefined : request,
    },
    context.logger,
    context
  );
}

//------------Customer Rental Amenity --------------

export async function upsertRentalAmenity(request: any, context: any) {
  return await callCustomerRentalAmenityData(
    "POST",
    "/upsert",
    request,
    context,
    upsertRentalAmenityRules
  );
}



