import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../utils/commonValidator";
import { httpClient } from "../../utils/http/httpClient";
import {
  upsertParkingAmenityRules,
  getParkingAmenityDetailsRules,
} from "../../schema/parkingAmenity/validators/parkingAmenityValidator";

async function callParkingAmenityData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/parking-amenities${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      body: method === "GET" ? undefined : request,
    },
    context.logger,
    context
  );
}

export async function upsertParkingAmenity(request: any, context: any) {
  return await callParkingAmenityData("POST", "/upsert", request, context, upsertParkingAmenityRules);
}

export async function getParkingAmenityDetails(request: any, context: any) {
  return await callParkingAmenityData("POST", "/details", request, context, getParkingAmenityDetailsRules);
}

