package com.hlt.api.promotion.controller;

import com.hlt.api.promotion.service.IPromotionApiService;
import com.hlt.api.promotion.dto.PromoRequest;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/v1/promotions")
@RequiredArgsConstructor
public class PromotionController {

    private final IPromotionApiService service;

    @GetMapping
    public ResponseEntity<List<Map<String, Object>>> getAll(@RequestHeader("X-Session-Key") String sessionKey) {
        return ResponseEntity.ok(service.getAllPromotions(sessionKey));
    }

    /** Always 200. An unknown code returns {} so the caller can treat it as "not found". */
    @GetMapping("/code/{promoCode}")
    public ResponseEntity<Map<String, Object>> getByCode(@RequestHeader("X-Session-Key") String sessionKey,
                                                         @PathVariable String promoCode) {
        Map<String, Object> promo = service.getPromotionByCode(sessionKey, promoCode);
        return ResponseEntity.ok(promo != null ? promo : new HashMap<>());
    }

    @PostMapping
    public ResponseEntity<Map<String, Object>> create(@RequestHeader("X-Session-Key") String sessionKey,
                                                      @RequestBody PromoRequest body) {
        return ResponseEntity.status(HttpStatus.CREATED).body(service.createPromotion(body, sessionKey));
    }

    @PutMapping
    public ResponseEntity<Map<String, Object>> update(@RequestHeader("X-Session-Key") String sessionKey,
                                                      @RequestBody PromoRequest body) {
        return ResponseEntity.ok(service.updatePromotion(body, sessionKey));
    }

    @PostMapping("/{id}/remove")
    public ResponseEntity<Map<String, Object>> remove(@RequestHeader("X-Session-Key") String sessionKey,
                                                      @PathVariable Integer id) {
        return ResponseEntity.ok(service.removePromotion(id, sessionKey));
    }
}


