@Override
public Map<String, Object> getCustomerSalesFunnelDetails(TicketRequest req) {
    log.info("Getting customer sales funnel details: {}", req.getSalesFunnelId());
    Map<String, Object> funnel = customerSalesFunnelDao.getCustomerSalesFunnelDetails(req);
    if (funnel != null) {
        formatCutoffTime(funnel);
        funnel.put("bookingAllowed", salesCutoffService.isBookingAllowed(
                funnel.get("timezone") == null ? null : funnel.get("timezone").toString(),
                funnel.get("salesCutoffLocalTime") == null ? null : funnel.get("salesCutoffLocalTime").toString()));
    }
    return funnel;
}



@Service
public class SalesCutoffService {

    // booking closes this many hours before the cutoff (0 = exactly at cutoff)
    @Value("${sales.booking.buffer-hours:2}")
    private long bufferHours;

    public boolean isBookingAllowed(String timezone, String salesCutoffLocalTime) {
        if (timezone == null || salesCutoffLocalTime == null) {
            return false; // fail closed
        }

        ZoneId zone = ZoneId.of(timezone);
        LocalTime cutoff = LocalTime.parse(salesCutoffLocalTime);

        ZonedDateTime now = ZonedDateTime.now(zone);
        ZonedDateTime deadline = now.toLocalDate()
                .atTime(cutoff)
                .atZone(zone)
                .minusHours(bufferHours);

        return now.isBefore(deadline);
    }
}





Map<String, Object> funnel = customerSalesFunnelDao.getCustomerSalesFunnelDetails(req);
formatCutoffTime(funnel); // or read the cutoff directly

if (!salesCutoffService.isBookingAllowed(
        String.valueOf(funnel.get("timezone")),
        String.valueOf(funnel.get("salesCutoffLocalTime")))) {
    throw new SalesClosedException("Booking cutoff time has passed");
}





protected void validatePromoResultCode(Map<String, Object> out, String procName) {
    Object raw = out.get("p_Result_Code");
    int code = raw != null ? ((Number) raw).intValue() : 0;
    String message = Objects.toString(out.get("p_Log_Details"),
            "DB Error (" + code + ") in " + procName);

    switch (code) {
        case 1:
            return;
        case -2:
        case -3:
            throw new SecurityException(message);
        case -4:
            throw new IllegalArgumentException(message);
        case -5:
            throw new PromoLimitExceededException("Promo usage limit reached (global)");
        case -6:
            throw new PromoLimitExceededException("Promo usage limit reached (per customer)");
        default:
            throw new RuntimeException(message);
    }
}


