import { httpClient } from "../../../utils/http/httpClient";

async function callCustomerPriceTypeData(
  method: string,
  endpoint: string,
  request: any,
  context: any
) {
  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/customer/amenity-price-types${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      body: method === "GET" ? undefined : request,
    },
    context.logger,
    context
  );
}

//------------Customer Amenity Price Type ----------------

export async function getCustomerAmenityPricing(request: any, context: any) {
  return await callCustomerPriceTypeData("POST", "/get", request, context);
}
