import com.hlt.api.dao.BaseDao;

// 2) Add these methods inside the class (after your existing handlers).
//    No @Order and no flag needed: these exception classes are more specific than
//    SecurityException / IllegalArgumentException / Exception, so Spring picks them first.

    @ExceptionHandler(BaseDao.ProcSecurityException.class)
    public ResponseEntity<ApiResponse<String>> handleProcSecurity(BaseDao.ProcSecurityException ex) {
        return procError(-1, ex);
    }

    @ExceptionHandler(BaseDao.ProcInvalidArgumentException.class)
    public ResponseEntity<ApiResponse<String>> handleProcInvalidArgument(BaseDao.ProcInvalidArgumentException ex) {
        return procError(-2, ex);
    }

    @ExceptionHandler(BaseDao.ProcFailureException.class)
    public ResponseEntity<ApiResponse<String>> handleProcFailure(BaseDao.ProcFailureException ex) {
        return procError(ex.getCode(), ex);
    }

    // Result codes from Confluence: -1 Unhandled, -2 Session, -3 Permission, -4 Parameter.
    // The proc's log text is only logged, never returned to the client.
    private ResponseEntity<ApiResponse<String>> procError(int code, Exception ex) {
        HttpStatus status;
        String message;

        switch (code) {
            case -2:
                status = HttpStatus.UNAUTHORIZED;
                message = "Your session has expired. Please sign in again.";
                break;
            case -3:
                status = HttpStatus.FORBIDDEN;
                message = "You do not have permission to perform this action.";
                break;
            case -4:
                status = HttpStatus.BAD_REQUEST;
                message = "Some of the information provided is invalid or missing.";
                break;
            default: // -1 and anything unexpected
                status = HttpStatus.INTERNAL_SERVER_ERROR;
                message = "Something went wrong. Please try again.";
                break;
        }

        if (status.is5xxServerError()) {
            log.error("Proc error, result code {}: {}", code, ex.getMessage());
        } else {
            log.warn("Proc error, result code {}: {}", code, ex.getMessage());
        }
        return new ResponseEntity<>(ApiResponse.error(message), status);
    }


