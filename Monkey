package com.hlt.api.controller;

import com.hlt.api.dtos.request.TicketRequest;
import com.hlt.api.service.IPriceTypeService;
// TODO: adjust this import to wherever ApiResponse lives in your project
import com.hlt.api.dtos.response.ApiResponse;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/v1/price-types")
@Tag(name = "8. Price Type Management", description = "Location Price Types")
public class PriceTypeController {

    @Autowired
    private IPriceTypeService priceTypeService;

    @Operation(summary = "Get Location Price Types")
    @PostMapping("/get")
    public ApiResponse<List<Map<String, Object>>> getLocationPriceType(
            @RequestBody TicketRequest req, @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        List<Map<String, Object>> priceTypes = priceTypeService.getLocationPriceType(req);
        return ApiResponse.success("Price Types Retrieved", priceTypes);
    }

    @Operation(summary = "Create Price Type")
    @PostMapping("/create")
    public ApiResponse<Map<String, Integer>> createPriceType(
            @RequestBody TicketRequest req, @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        Integer newId = priceTypeService.createPriceType(req);
        Map<String, Integer> data = Map.of("priceTypeId", newId);
        return ApiResponse.success("Price Type " + req.getPriceTypeName() + " Created", data);
    }

    @Operation(summary = "Update Price Type")
    @PostMapping("/update")
    public ApiResponse<Map<String, Integer>> updatePriceType(
            @RequestBody TicketRequest req, @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        Integer result = priceTypeService.updatePriceType(req);
        Map<String, Integer> data = Map.of("priceTypeId", result);
        return ApiResponse.success("Price Type " + req.getPriceTypeName() + " Updated", data);
    }
}



