// src/service/amenities/amenityService.ts

import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../utils/commonValidator";
import { httpClient } from "../../utils/http/httpClient";
import {
  getLocationAmenityRules,
  getAmenityDetailRules,
  getAmenityScheduleRules,
  insertAmenityRules,
  upsertAmenityScheduleRules,
  updateAmenityRules,
  removeAmenityRules,
} from "../../schema/amenities/validators/amenityValidator";

async function postAmenityData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/amenity${endpoint}`;

  return await httpClient(
    url,
    {
      method: method,
      body: method === "GET" ? undefined : request,
    },
    context.logger,
    context
  );
}

// ---------- Queries ----------

export async function getAmenityType(request: any, context: any) {
  return await postAmenityData("GET", "/type", null, context);
}

export async function getLocationAmenity(request: any, context: any) {
  return await postAmenityData("POST", "/location", request, context, getLocationAmenityRules);
}

export async function getAmenityDetail(request: any, context: any) {
  return await postAmenityData("POST", "/detail", request, context, getAmenityDetailRules);
}

export async function getAmenitySchedule(request: any, context: any) {
  return await postAmenityData("POST", "/schedule", request, context, getAmenityScheduleRules);
}

// ---------- Mutations ----------

export async function insertAmenity(request: any, context: any) {
  return await postAmenityData("POST", "/insert", request, context, insertAmenityRules);
}

export async function upsertAmenitySchedule(request: any, context: any) {
  return await postAmenityData("POST", "/schedule/upsert", request, context, upsertAmenityScheduleRules);
}

export async function updateAmenity(request: any, context: any) {
  return await postAmenityData("POST", "/update", request, context, updateAmenityRules);
}

export async function removeAmenity(request: any, context: any) {
  return await postAmenityData("DELETE", "/remove", request, context, removeAmenityRules);
}
