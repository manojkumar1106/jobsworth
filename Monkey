// ---- 3) REPLACE the existing upsertAmenitySchedule ------------------------------------
@Override
public void upsertAmenitySchedule(TicketRequest req) {
    // UI sends local times -> convert to UTC before saving (like normalizeCutoffToUtc)
    String timezone = resolveTimezone(req);
    ScheduleTimezoneUtil.schedulesToUtc(req.getSchedules(), timezone);

    JsonNode allDates = req.getAllAmenityScheduleDates();
    if (allDates == null || allDates.isEmpty()) {
        allDates = ScheduleTimezoneUtil.collectDates(req.getSchedules()); // built from schedules so they always match
    } else {
        ScheduleTimezoneUtil.datesToUtc(allDates, timezone);
    }

    amenityDao.upsertAmenitySchedule(req.getSessionKey(), req.getLocationFunctionId(), req.getAmenityId(),
            ScheduleTimezoneUtil.toJson(allDates), ScheduleTimezoneUtil.toJson(req.getSchedules()));
}


// ---- 4) REPLACE the existing getAmenitySchedule ---------------------------------------
@Override
public List<Map<String, Object>> getAmenitySchedule(TicketRequest req) {
    List<List<Map<String, Object>>> resultSets =
            amenityDao.getAmenitySchedule(req.getSessionKey(), req.getLocationFunctionId(), req.getAmenityId());
    List<Map<String, Object>> headerRows = resultSets.get(0);   // result set 1: amenityId, allAmenityScheduleDates
    List<Map<String, Object>> scheduleRows = resultSets.get(1); // result set 2: one row per schedule

    Map<String, Object> response = new LinkedHashMap<>();
    response.put("amenityId", req.getAmenityId());
    response.put("allAmenityScheduleDates", List.of());
    response.put("schedules", List.of());
    if (scheduleRows.isEmpty()) {
        return List.of(response); // nothing to convert, skip the timezone lookup
    }

    // DB stores UTC -> convert back to the location's local time (like addLocalCutoffTime), one lookup per request
    String timezone = resolveTimezone(req);
    if (!headerRows.isEmpty()) {
        response.put("allAmenityScheduleDates", ScheduleTimezoneUtil.toLocalAllDates(headerRows.get(0), timezone));
    }
    response.put("schedules", scheduleRows.stream()
            .map(row -> ScheduleTimezoneUtil.toLocalSchedule(row, timezone))
            .toList());
    return List.of(response); // same wrapping as getSalesFunnelDetails
}


// ---- 5) ADD this private helper -------------------------------------------------------
/** locationId comes from the request body and is used only here; it is never sent to the amenity procs. */
private String resolveTimezone(TicketRequest req) {
    if (req.getLocationId() == null) {
        throw new ValidationException("locationId is required");
    }
    String timezone = salesFunnelDao.getTimezoneByLocation(req);
    TimezoneConverter.validateTimezone(timezone);
    return timezone;
}






