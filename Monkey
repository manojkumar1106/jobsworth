import java.util.List;
import java.util.Map;
// TODO: import ApiResponse and TicketRequest (same as your other controllers)

@RestController
@RequestMapping("/api/v1/parking-amenities")
@RequiredArgsConstructor
public class ParkingAmenityController {

    private final IParkingAmenityService parkingAmenityService;

    // usp_Upsert_Parking_Amenity
    @Operation(summary = "Upsert Parking Amenity")
    @PostMapping("/upsert")
    public ApiResponse<Map<String, Object>> upsertParkingAmenity(@RequestBody TicketRequest req,
                                                                 @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        return ApiResponse.success("Parking amenity saved", parkingAmenityService.upsertParkingAmenity(req));
    }

    // usp_Get_Parking_Amenity_Details
    @Operation(summary = "Get Parking Amenity Details")
    @PostMapping("/details")
    public ApiResponse<List<Map<String, Object>>> getParkingAmenityDetails(@RequestBody TicketRequest req,
                                                                           @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        return ApiResponse.success("Parking Amenity Details", parkingAmenityService.getParkingAmenityDetails(req));
    }
}



