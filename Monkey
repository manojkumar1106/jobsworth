// 1) A logger (put it near the top of the class, next to the @Autowired jdbcTemplate)
    private static final org.slf4j.Logger log = org.slf4j.LoggerFactory.getLogger(BaseDao.class);

// 2) Three small exception classes (paste anywhere inside the class, e.g. at the bottom).
//    They extend the same types BaseDao throws today, so existing catch blocks keep working.
    public static class ProcSecurityException extends SecurityException {            // result code -1
        public ProcSecurityException(String message) { super(message); }
    }

    public static class ProcInvalidArgumentException extends IllegalArgumentException { // result code -2
        public ProcInvalidArgumentException(String message) { super(message); }
    }

    public static class ProcFailureException extends RuntimeException {              // every other non-1 code
        private final int code;
        public ProcFailureException(String message, int code) { super(message); this.code = code; }
        public int getCode() { return code; }
    }

// 3) Replace the existing validateResultCode method with this one
    private void validateResultCode(Map<String, Object> out, String procName) {
        Object rawCode = out.get("p_Result_Code");
        int code = (rawCode instanceof Number) ? ((Number) rawCode).intValue() : 0;
        if (code == 1) {
            return; // success
        }

        // null when the proc has no p_Log_Details (same as before)
        Object rawMessage = out.get("p_Log_Details");
        String message = (rawMessage != null) ? rawMessage.toString() : null;

        log.warn("Proc {} returned result code {}: {}", procName, code, message);

        if (code == -1) throw new ProcSecurityException(message);
        if (code == -2) throw new ProcInvalidArgumentException(message);
        throw new ProcFailureException(message, code);
    }




