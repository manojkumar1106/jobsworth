package hlt.promo.engine.model;

import com.fasterxml.jackson.annotation.JsonAlias;
import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import com.fasterxml.jackson.annotation.JsonProperty;
import jakarta.persistence.*;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

import java.time.LocalDateTime;

/**
 * hlt-api returns camelCase keys (ruleDefinitionId, ruleName, drlContent, isActive ...)
 * and hlt-api's PromoRequest reads camelCase too, so JSON names are the plain field names.
 * @JsonAlias keeps the old DB-style names readable.
 */
@Data
@NoArgsConstructor
@AllArgsConstructor
@JsonIgnoreProperties(ignoreUnknown = true)
@Entity
@Table(name = "Rule_Definitions") // <- keep whatever @Table you already have
public class RuleDefinition {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "Rule_Definition_Id")
    @JsonProperty("id")
    @JsonAlias({"ruleDefinitionId", "Rule_Definition_Id"})
    private Long id;

    // e.g. PROMO_SAVE10, SYSDISCOUNT_LOYALTY
    @Column(name = "Rule_Name")
    @JsonAlias("Rule_Name")
    private String ruleName;

    // PROMOTION or SYSTEM_DISCOUNT
    @Column(name = "Rule_Type")
    @JsonAlias("Rule_Type")
    private String ruleType;

    // FK to promotion.id or system_discount.id
    @Column(name = "Reference_Id")
    @JsonAlias("Reference_Id")
    private Long referenceId;

    @Lob
    @Column(name = "DRL_Content", columnDefinition = "CLOB")
    @JsonAlias({"DRL_Content", "drl_content"})
    private String drlContent;

    @Column(name = "Version")
    @JsonAlias("Version")
    private Integer version = 1;

    @Column(name = "Is_Active")
    @JsonProperty("active")
    @JsonAlias({"isActive", "Is_Active"})
    private boolean active = true;

    // ---- keep your existing definitions of these if they differ ----
    @Column(name = "Created_By")
    @JsonAlias("Created_By")
    private String createdBy;

    @Column(name = "Created_At")
    @JsonAlias("Created_At")
    private LocalDateTime createdAt;

    @Column(name = "Updated_At")
    @JsonAlias("Updated_At")
    private LocalDateTime updatedAt;
}



