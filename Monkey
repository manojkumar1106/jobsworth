@Operation(summary = "Get Location Operation Hours")
@GetMapping("/operation-hours")
public ApiResponse<List<Map<String, Object>>> getLocationOperationHours(@AuthenticationPrincipal Jwt jwt) {
    TicketRequest req = new TicketRequest();
    if (jwt != null) {
        req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
    }
    return ApiResponse.success("Location Operation Hours", locationScheduleService.getLocationOperationHours(req));
}



List<Map<String, Object>> getLocationOperationHours(TicketRequest req);


// client1.usp_Get_Location_Operation_Hours -> 2 result sets (Timezone, then the open windows)
public List<List<Map<String, Object>>> getLocationOperationHours(TicketRequest req) {
    Map<String, Object> params = new HashMap<>();
    params.put("p_Session_Key", req.getSessionKey());
    return executeMultiResultSets("usp_Get_Location_Operation_Hours", params);   // same call as getLocationSchedule
}



@Override
public List<Map<String, Object>> getLocationOperationHours(TicketRequest req) {
    List<List<Map<String, Object>>> resultSets = locationScheduleDao.getLocationOperationHours(req);
    List<Map<String, Object>> header = resultSets.get(0);
    List<Map<String, Object>> rows = resultSets.get(1);

    if (header.isEmpty() || rows.isEmpty()) {
        return List.of();   // no operating hours configured
    }

    String timezone = (String) header.get(0).get("timezone");
    TimezoneConverter.validateTimezone(timezone);

    for (Map<String, Object> row : rows) {
        row.put("startAt", TimezoneConverter.toLocal((LocalDateTime) row.get("startAt"), timezone));
        row.put("endAt", TimezoneConverter.toLocal((LocalDateTime) row.get("endAt"), timezone));
        row.put("timezone", timezone);
    }
    return rows;   // read-only, no @Transactional
}




