package com.hlt.api.service.serviceimpl;

import com.hlt.api.dao.CustomerRentalAmenityDao;
import com.hlt.api.request.CustomerRentalAmenityRequest;
import com.hlt.api.service.ICustomerRentalAmenityService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Slf4j
@Service
@RequiredArgsConstructor
public class CustomerRentalAmenityService implements ICustomerRentalAmenityService {

    private final CustomerRentalAmenityDao customerRentalAmenityDao;

    @Override
    @Transactional
    public void createRentalInquiry(CustomerRentalAmenityRequest req) {
        log.info("Creating Rental Inquiry for amenity: {}, customer: {}",
                req.getAmenityId(), req.getClientCustomerId());

        // The proc does not check this, so guard it here (-4 style parameter error)
        if (req.getEventStartAt() != null && req.getEventEndAt() != null
                && !req.getEventEndAt().isAfter(req.getEventStartAt())) {
            throw new IllegalArgumentException("eventEndAt must be after eventStartAt");
        }

        customerRentalAmenityDao.createRentalInquiry(req);
    }
}




package com.hlt.api.dao;

import com.hlt.api.request.CustomerRentalAmenityRequest;
import org.springframework.stereotype.Repository;

import java.sql.Timestamp;
import java.util.HashMap;
import java.util.Map;

@Repository
public class CustomerRentalAmenityDao extends BaseDao {

    // client1.usp_Create_Rental_Inquiry (TKTS-916)
    // p_Result_Code (OUT) is validated inside BaseDao.executeVoid -> validateResultCode
    public void createRentalInquiry(CustomerRentalAmenityRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());

        // Proc does NULLIF(x, 0) for these two; we send NULL instead of 0 ("FE & BE send NULL not 0")
        params.put("p_Amenity_Id", nullIfZero(req.getAmenityId()));
        params.put("p_Client_Customer_Id", nullIfZero(req.getClientCustomerId()));

        params.put("p_Contact_First_Name", req.getContactFirstName());
        params.put("p_Contact_Last_Name", req.getContactLastName());
        params.put("p_Contact_Email_Address", req.getContactEmailAddress());
        params.put("p_Contact_Phone_Number", req.getContactPhoneNumber());

        params.put("p_Company_Name", req.getCompanyName());
        params.put("p_Company_Address_Line_1", req.getCompanyAddressLine1());
        params.put("p_Company_Address_Line_2", req.getCompanyAddressLine2());
        params.put("p_City", req.getCity());
        params.put("p_State", req.getState());
        params.put("p_Country", req.getCountry());
        params.put("p_Postal_Code", req.getPostalCode());

        params.put("p_Event_Start_At", req.getEventStartAt() == null ? null : Timestamp.valueOf(req.getEventStartAt()));
        params.put("p_Event_End_At", req.getEventEndAt() == null ? null : Timestamp.valueOf(req.getEventEndAt()));
        params.put("p_Is_Event_Date_Flexible", req.getIsEventDateFlexible());
        params.put("p_Total_Attendees", req.getTotalAttendees());
        params.put("p_Event_Title", req.getEventTitle());
        params.put("p_Event_Description", req.getEventDescription());
        params.put("p_Event_Set_Up_Description", req.getEventSetUpDescription());
        params.put("p_Is_Audio_Visual_Services_Required", req.getIsAudioVisualServicesRequired());
        params.put("p_Additional_Information", req.getAdditionalInformation());
        params.put("p_Referred_By", req.getReferredBy());

        executeVoid("usp_Create_Rental_Inquiry", params);
    }

    private Integer nullIfZero(Integer value) {
        return (value == null || value == 0) ? null : value;
    }
}



