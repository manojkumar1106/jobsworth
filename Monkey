input CreateAmenityPriceType {
  amenityId: Int!
  priceTypes: [String!]!
}


private List<String> priceTypes;


@Override
public Integer createAmenityPriceType(TicketRequest req) {
    List<String> items = req.getPriceTypes();

    if (items == null || items.isEmpty() || items.size() > 15) {
        throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Provide 1 to 15 price types");
    }

    String priceTypeList = items.stream().map(item -> {
        String[] parts = item.split(",");
        if (parts.length != 2 || parts[0].trim().isEmpty()) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST,
                    "Each price type must be 'name,price': " + item);
        }
        try {
            BigDecimal price = new BigDecimal(parts[1].trim()).setScale(2, RoundingMode.HALF_UP);
            if (price.signum() < 0) throw new NumberFormatException();
            return parts[0].replace("|", "").trim() + "," + price.toPlainString();
        } catch (NumberFormatException e) {
            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid price in: " + item);
        }
    }).collect(Collectors.joining("|"));

    if (priceTypeList.length() > 1000) {
        throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Price type list too long");
    }

    return amenityPriceTypeDao.createAmenityPriceType(req, priceTypeList);
}
