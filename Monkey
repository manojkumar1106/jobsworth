@Repository
public class CustomerSalesFunnelDao extends BaseDao {

    public List<Map<String, Object>> getCustomerSalesFunnel(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        return executeList("usp_Get_Customer_Sales_Funnel", params);
    }

    public Map<String, Object> getCustomerSalesFunnelDetails(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Sales_Funnel_Id", req.getSalesFunnelId());
        return executeSingle("usp_Get_Customer_Sales_Funnel_Details", params);
    }
}



public interface ICustomerSalesFunnelService {
    List<Map<String, Object>> getCustomerSalesFunnel(TicketRequest req);
    Map<String, Object> getCustomerSalesFunnelDetails(TicketRequest req);
}


@Service
@Slf4j
public class CustomerSalesFunnelService implements ICustomerSalesFunnelService {

    @Autowired
    private CustomerSalesFunnelDao customerSalesFunnelDao;

    @Override
    public List<Map<String, Object>> getCustomerSalesFunnel(TicketRequest req) {
        log.info("Getting customer sales funnel");
        return customerSalesFunnelDao.getCustomerSalesFunnel(req);
    }

    @Override
    public Map<String, Object> getCustomerSalesFunnelDetails(TicketRequest req) {
        log.info("Getting customer sales funnel details: {}", req.getSalesFunnelId());
        Map<String, Object> funnel = customerSalesFunnelDao.getCustomerSalesFunnelDetails(req);
        if (funnel != null) {
            formatCutoffTime(funnel);
        }
        return funnel;
    }

    // same conversion as the client SalesFunnelService
    private void formatCutoffTime(Map<String, Object> funnel) {
        Object value = funnel.remove("todayCutoffTimeUtc");
        if (value != null) {
            funnel.put("salesCutoffLocalTime", LocalTime.parse(value.toString()).toString());
        }
    }
}




@RestController
@RequestMapping("/api/v1/customer/funnels")
@Tag(name = "Customer Sales Funnel", description = "Sales funnels for customer web")
public class CustomerSalesFunnelController {

    @Autowired
    private ICustomerSalesFunnelService customerSalesFunnelService;

    @Operation(summary = "Get Customer Sales Funnel")
    @PostMapping("/get")
    public ApiResponse<List<Map<String, Object>>> getCustomerSalesFunnel(
            @RequestBody TicketRequest req,
            @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        return ApiResponse.success("Customer Sales Funnel Retrieved",
                customerSalesFunnelService.getCustomerSalesFunnel(req));
    }

    @Operation(summary = "Get Customer Sales Funnel Details")
    @PostMapping("/details")
    public ApiResponse<Map<String, Object>> getCustomerSalesFunnelDetails(
            @RequestBody TicketRequest req,
            @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        return ApiResponse.success("Customer Sales Funnel Details Retrieved",
                customerSalesFunnelService.getCustomerSalesFunnelDetails(req));
    }
}


import { httpClient } from "../../../utils/http/httpClient";

async function callCustomerFunnelData(
  method: string,
  endpoint: string,
  request: any,
  context: any
) {
  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/customer/funnels${endpoint}`;
  return await httpClient(
    url,
    { method, body: request ?? {} },
    context.logger,
    context
  );
}

export async function getCustomerSalesFunnel(request: any, context: any) {
  return await callCustomerFunnelData("POST", "/get", request, context);
}

export async function getCustomerSalesFunnelDetails(request: any, context: any) {
  return await callCustomerFunnelData("POST", "/details", request, context);
}



