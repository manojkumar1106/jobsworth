package com.hlt.api.controller;

import com.hlt.api.request.CustomerRentalAmenityRequest;
import com.hlt.api.service.ICustomerRentalAmenityService;
import io.swagger.v3.oas.annotations.Operation;
import lombok.RequiredArgsConstructor;
import org.springframework.security.core.annotation.AuthenticationPrincipal;
import org.springframework.security.oauth2.jwt.Jwt;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
// TODO: import ApiResponse (same as your other controllers)

@RestController
@RequestMapping("/api/v1/customer/rental-inquiries")
@RequiredArgsConstructor
public class CustomerRentalAmenityController {

    private final ICustomerRentalAmenityService customerRentalAmenityService;

    @Operation(summary = "Customer submits a rental inquiry")
    @PostMapping("/create")
    public ApiResponse<Void> createRentalInquiry(@RequestBody CustomerRentalAmenityRequest req,
                                                 @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        customerRentalAmenityService.createRentalInquiry(req);
        return ApiResponse.success("Rental Inquiry Submitted", null);
    }
}




package com.hlt.api.service;

