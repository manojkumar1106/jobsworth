} else {
    // hlt-api PUT /rule-definitions/update does not persist drlContent,
    // so deactivate the old row and create a new active row with the new DRL
    Integer deactivated = promoEngineApiClient.deactivateRuleDefinition(rule.getId(), sessionKey);
    if (deactivated == null || deactivated != 1) {
        throw new RuntimeException("Could not deactivate old rule id=" + rule.getId());
    }
    rule.setId(null);
    ruleDefinition = promoEngineApiClient.createRuleDefinition(rule, sessionKey);
}
