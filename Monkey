export const customerSalesFunnelTypeDefs = `
  type CustomerScheduleDate {
    startDateTime: String
    endDateTime: String
  }

  type CustomerFunnelAmenity {
    funnelOrder: Int
    amenityId: Int!
    amenityName: String
    amenityDescription: String
    amenityTypeId: Int
    amenityTypeName: String
    amenityTimezone: String
    allAmenityScheduleDates: [CustomerScheduleDate]
    pricing: [CustomerAmenityPriceType]
  }

  type CustomerSalesFunnelDetails {
    salesFunnelId: Int
    urlSlug: String
    isDateRequired: Boolean
    salesCutoffLocalTime: String
  }

  type CustomerSalesFunnel {
    salesFunnelId: Int!
    salesFunnelName: String
    details: CustomerSalesFunnelDetails
    amenities: [CustomerFunnelAmenity]
  }

  input GetCustomerSalesFunnelDetails { salesFunnelId: Int! }
  input GetCustomerSalesFunnelAmenities { salesFunnelId: Int! }

  type Query {
    getCustomerSalesFunnel: [CustomerSalesFunnel]
    getCustomerSalesFunnelById(request: GetCustomerSalesFunnelDetails!): CustomerSalesFunnel
    getCustomerSalesFunnelDetails(request: GetCustomerSalesFunnelDetails!): CustomerSalesFunnelDetails
    getCustomerSalesFunnelAmenities(request: GetCustomerSalesFunnelAmenities!): [CustomerFunnelAmenity]
  }
`;




import {
  getCustomerSalesFunnel,
  getCustomerSalesFunnelDetails,
  getCustomerSalesFunnelAmenities,
} from "../../../service/customer/salesfunnel/customerSalesFunnelService";
import { getCustomerAmenityPricing } from "../../../service/customer/pricetypes/priceTypeService";

const unwrap = (res: any) => res?.data ?? null;

const loadFunnels = async (ctx: any) =>
  unwrap(await getCustomerSalesFunnel({}, ctx)) ?? [];
const loadDetails = async (salesFunnelId: number, ctx: any) =>
  unwrap(await getCustomerSalesFunnelDetails({ salesFunnelId }, ctx));
const loadAmenities = async (salesFunnelId: number, ctx: any) =>
  unwrap(await getCustomerSalesFunnelAmenities({ salesFunnelId }, ctx)) ?? [];
const loadPricing = async (amenityId: number, ctx: any) =>
  unwrap(await getCustomerAmenityPricing({ amenityId }, ctx)) ?? [];

export const customerSalesFunnelResolvers = {
  Query: {
    getCustomerSalesFunnel: (_: any, __: any, ctx: any) => loadFunnels(ctx),
    getCustomerSalesFunnelById: (_: any, { request }: any) => ({
      salesFunnelId: request.salesFunnelId,
    }),
    getCustomerSalesFunnelDetails: (_: any, { request }: any, ctx: any) =>
      loadDetails(request.salesFunnelId, ctx),
    getCustomerSalesFunnelAmenities: (_: any, { request }: any, ctx: any) =>
      loadAmenities(request.salesFunnelId, ctx),
  },

  CustomerSalesFunnel: {
    salesFunnelName: async (p: any, _: any, ctx: any) => {
      if (p.salesFunnelName !== undefined) return p.salesFunnelName;
      const list = await loadFunnels(ctx);
      return list.find((f: any) => f.salesFunnelId === p.salesFunnelId)?.salesFunnelName ?? null;
    },
    details: (p: any, _: any, ctx: any) => loadDetails(p.salesFunnelId, ctx),
    amenities: (p: any, _: any, ctx: any) => loadAmenities(p.salesFunnelId, ctx),
  },

  CustomerFunnelAmenity: {
    pricing: (p: any, _: any, ctx: any) => loadPricing(p.amenityId, ctx),
  },
};



@Override
public List<Map<String, Object>> getCustomerSalesFunnelAmenities(TicketRequest req) {
    List<Map<String, Object>> amenities =
            customerSalesFunnelDao.getCustomerSalesFunnelAmenities(req);
    for (Map<String, Object> amenity : amenities) {
        Object dates = amenity.get("allAmenityScheduleDates");
        if (dates == null) continue;
        amenity.put("allAmenityScheduleDates",
                ScheduleTimezoneUtil.datesToLocal(dates,
                        String.valueOf(amenity.get("amenityTimezone"))));
    }
    return amenities;
}


