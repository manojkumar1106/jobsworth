@Slf4j
@Service
@RequiredArgsConstructor
public class LocationScheduleService implements ILocationScheduleService {

    private final LocationScheduleDao locationScheduleDao;
    private final ObjectMapper objectMapper;   // use your existing ObjectMapper bean

    @Override
    public List<Map<String, Object>> getLocationScheduleTypes(TicketRequest req) {
        log.info("Getting location schedule types for locationFunctionId: {}", req.getLocationFunctionId());
        return locationScheduleDao.getLocationScheduleTypes(req);   // read-only, no @Transactional
    }

    @Override
    @Transactional
    public void upsertLocationSchedule(TicketRequest req) {
        log.info("Upserting location schedule for locationFunctionId: {}", req.getLocationFunctionId());

        if (req.getLocationScheduleJson() == null || !req.getLocationScheduleJson().isArray()) {
            throw new IllegalArgumentException("locationScheduleJson must be an array");
        }
        if (req.getAllScheduleDatesJson() == null) {
            throw new IllegalArgumentException("allScheduleDatesJson is required");
        }

        // The proc takes both JSON params as strings
        locationScheduleDao.upsertLocationSchedule(req,
                toJson(req.getAllScheduleDatesJson()),
                toJson(req.getLocationScheduleJson()));
    }

    private String toJson(Object value) {
        try {
            return objectMapper.writeValueAsString(value);
        } catch (JsonProcessingException e) {
            throw new IllegalArgumentException("Invalid JSON in request");
        }
    }
}






