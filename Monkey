// Amenity Schedule
private Integer locationId;                 // skip if it already exists; used only for the timezone lookup
private JsonNode schedules;                 // full desired set of schedules, local times
private JsonNode allAmenityScheduleDates;   // optional; built from schedules when missing

/*
 * Upsert body (all times LOCAL to the location):
 * {
 *   "amenityId": 10,
 *   "locationId": 3,
 *   "locationFunctionId": 7,
 *   "schedules": [
 *     {
 *       "id": null,                     // null = new, number = update; schedules not sent are removed
 *       "name": "Morning hrs",
 *       "scheduleJson": {
 *         "rule": { ...UI recurrence settings, stored as is... },
 *         "rruleText": "DTSTART:20261001T110000\nRRULE:INTERVAL=1;FREQ=DAILY;UNTIL=20261003T235900"
 *       },
 *       "datesJson": [
 *         { "startDateTime": "2026-10-01T11:00:00", "endDateTime": "2026-10-01T12:00:00" }
 *       ]
 *     }
 *   ]
 * }
 *
 * Get body: { "amenityId": 10, "locationId": 3, "locationFunctionId": 7 }
 * Get response data: [ { "amenityId": 10, "allAmenityScheduleDates": [...], "schedules": [ same shape as above, local ] } ]
 */






package com.hlt.api.util;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ArrayNode;
import com.fasterxml.jackson.databind.node.ObjectNode;
import com.hlt.api.exception.ValidationException; // use the same ValidationException TimezoneConverter uses

import java.time.LocalDateTime;
import java.time.ZoneOffset;
import java.time.format.DateTimeFormatter;
import java.time.temporal.ChronoUnit;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * NEW FILE. Timezone conversion for amenity schedule JSON, kept out of AmenityService.
 * All zone math goes through TimezoneConverter, so DST handling matches the sales funnel.
 *
 *   save : "2026-10-01T11:00:00"       (local) -> "2026-10-01T16:00:00.000Z" (UTC)
 *   read : "2026-10-01T16:00:00.000Z"  (UTC)   -> "2026-10-01T11:00:00"      (local)
 *   rrule: DTSTART / UNTIL inside rruleText are converted the same way.
 *   rule : UI recurrence settings are local and are never converted.
 */
public final class ScheduleTimezoneUtil {

    private static final ObjectMapper MAPPER = new ObjectMapper();
    private static final DateTimeFormatter UTC_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'");
    private static final DateTimeFormatter RRULE_FORMAT = DateTimeFormatter.ofPattern("yyyyMMdd'T'HHmmss");
    private static final Pattern RRULE_DATE = Pattern.compile("(DTSTART:|UNTIL=)(\\d{8}T\\d{6})(Z?)");

    // JSON field names (same in request and response)
    private static final String SCHEDULE_JSON = "scheduleJson";
    private static final String RRULE_TEXT = "rruleText";
    private static final String DATES_JSON = "datesJson";
    private static final String START = "startDateTime";
    private static final String END = "endDateTime";

    // Proc column names after BaseDao camel-casing (matched ignoring case, e.g. RRule_Text -> rRuleText)
    private static final String COL_ALL_DATES = "allAmenityScheduleDates";
    private static final String COL_SCHEDULE_ID = "amenityScheduleId";
    private static final String COL_SCHEDULE_NAME = "scheduleName";
    private static final String COL_RULE = "ruleJson";
    private static final String COL_RRULE = "rruleText";
    private static final String COL_DATES = "datesJson";

    private ScheduleTimezoneUtil() {
    }

    // ================================================================ save (local -> UTC)

    /** Converts every schedule's rruleText and datesJson to UTC, in place. */
    public static void schedulesToUtc(JsonNode schedules, String timezone) {
        if (schedules == null || !schedules.isArray()) {
            return;
        }
        for (JsonNode schedule : schedules) {
            if (schedule.get(SCHEDULE_JSON) instanceof ObjectNode def && def.hasNonNull(RRULE_TEXT)) {
                def.put(RRULE_TEXT, convertRrule(def.get(RRULE_TEXT).asText(), timezone, true));
            }
            convertDates(schedule.get(DATES_JSON), timezone, true);
        }
    }

    /** Converts a [{startDateTime, endDateTime}] array to UTC, in place. */
    public static void datesToUtc(JsonNode dates, String timezone) {
        convertDates(dates, timezone, true);
    }

    /** All schedules' dates in one sorted array (call after schedulesToUtc; UTC strings sort correctly). */
    public static ArrayNode collectDates(JsonNode schedules) {
        List<JsonNode> all = new ArrayList<>();
        if (schedules != null && schedules.isArray()) {
            for (JsonNode schedule : schedules) {
                JsonNode dates = schedule.get(DATES_JSON);
                if (dates != null && dates.isArray()) {
                    dates.forEach(all::add);
                }
            }
        }
        all.sort(Comparator.comparing(d -> d.path(START).asText()));
        return MAPPER.createArrayNode().addAll(all);
    }

    public static String toJson(JsonNode node) {
        return node == null ? null : node.toString();
    }

    // ================================================================ read (UTC -> local)

    /** Result set 1 (header row) -> local allAmenityScheduleDates array. */
    public static JsonNode toLocalAllDates(Map<String, Object> headerRow, String timezone) {
        return toLocalDates(column(headerRow, COL_ALL_DATES), timezone);
    }

    /** Result set 2 (one schedule row) -> same shape the UI sends on upsert, in local time. */
    public static Map<String, Object> toLocalSchedule(Map<String, Object> row, String timezone) {
        Object rrule = column(row, COL_RRULE);

        Map<String, Object> scheduleJson = new LinkedHashMap<>();
        scheduleJson.put("rule", parse(column(row, COL_RULE)));
        scheduleJson.put(RRULE_TEXT, rrule == null ? null : convertRrule(rrule.toString(), timezone, false));

        Map<String, Object> schedule = new LinkedHashMap<>();
        schedule.put("id", column(row, COL_SCHEDULE_ID));
        schedule.put("name", column(row, COL_SCHEDULE_NAME));
        schedule.put(SCHEDULE_JSON, scheduleJson);
        schedule.put(DATES_JSON, toLocalDates(column(row, COL_DATES), timezone));
        return schedule;
    }

    private static JsonNode toLocalDates(Object datesJson, String timezone) {
        JsonNode dates = datesJson == null ? MAPPER.createArrayNode() : parse(datesJson);
        convertDates(dates, timezone, false);
        return dates;
    }

    // ================================================================ internals

    private static void convertDates(JsonNode dates, String timezone, boolean toUtc) {
        if (dates == null || !dates.isArray()) {
            return;
        }
        for (JsonNode node : dates) {
            ObjectNode date = (ObjectNode) node;
            for (String field : new String[]{START, END}) {
                if (date.hasNonNull(field)) {
                    String value = date.get(field).asText();
                    date.put(field, toUtc ? toUtc(value, timezone) : toLocal(value, timezone));
                }
            }
        }
    }

    private static String toUtc(String local, String timezone) {
        if (local.endsWith("Z")) {
            return local; // already UTC, don't convert twice
        }
        LocalDateTime localDateTime = LocalDateTime.parse(local);
        requireValidLocalTime(localDateTime, timezone);
        return TimezoneConverter.toUtc(localDateTime, timezone).format(UTC_FORMAT);
    }

    private static String toLocal(String utc, String timezone) {
        LocalDateTime utcDateTime = LocalDateTime.parse(utc.replace("Z", ""));
        LocalDateTime local = TimezoneConverter.toLocal(utcDateTime, timezone).truncatedTo(ChronoUnit.SECONDS);
        return DateTimeFormatter.ISO_LOCAL_DATE_TIME.format(local);
    }

    /** Rewrites DTSTART / UNTIL. Date-only UNTIL (UNTIL=20261003) is left unchanged. */
    private static String convertRrule(String rrule, String timezone, boolean toUtc) {
        if (rrule == null || rrule.isBlank()) {
            return rrule;
        }
        Matcher matcher = RRULE_DATE.matcher(rrule);
        StringBuilder out = new StringBuilder();
        while (matcher.find()) {
            String prefix = matcher.group(1);
            LocalDateTime value = LocalDateTime.parse(matcher.group(2), RRULE_FORMAT);
            boolean isUtc = !matcher.group(3).isEmpty();

            String converted = matcher.group(2) + matcher.group(3);
            if (toUtc && !isUtc) {
                requireValidLocalTime(value, timezone);
                converted = TimezoneConverter.toUtc(value, timezone)
                        .withOffsetSameInstant(ZoneOffset.UTC).format(RRULE_FORMAT) + "Z";
            } else if (!toUtc && isUtc) {
                converted = TimezoneConverter.toLocal(value, timezone).format(RRULE_FORMAT);
            }
            matcher.appendReplacement(out, Matcher.quoteReplacement(prefix + converted));
        }
        matcher.appendTail(out);
        return out.toString();
    }

    /** A local time inside the spring-forward gap (e.g. 2:30 AM) doesn't exist; reject it instead of shifting it. */
    private static void requireValidLocalTime(LocalDateTime local, String timezone) {
        if (TimezoneConverter.isInDstGap(local, timezone)) {
            throw new ValidationException("The time " + local + " does not exist in " + timezone
                    + " because of daylight saving. Please choose a different time.");
        }
    }

    private static Object column(Map<String, Object> row, String name) {
        for (Map.Entry<String, Object> entry : row.entrySet()) {
            if (entry.getKey().equalsIgnoreCase(name)) {
                return entry.getValue();
            }
        }
        return null;
    }

    private static JsonNode parse(Object json) {
        if (json == null) {
            return null;
        }
        try {
            return MAPPER.readTree(json.toString());
        } catch (JsonProcessingException e) {
            throw new IllegalStateException("Stored schedule JSON is invalid", e);
        }
    }
}
