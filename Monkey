package com.hlt.api.dao;

import org.springframework.stereotype.Repository;
import java.util.HashMap;
import java.util.Map;
// TODO: import TicketRequest

@Repository
public class RentalAmenityDao extends BaseDao {

    // usp_Upsert_Rental_Amenity (TKTS-915)
    // BaseDao.executeVoid validates p_Result_Code (-2 session, -3 permission, -4 parameter, other != 1 unhandled)
    public void upsertRentalAmenity(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Rental_Amenity_Id", req.getRentalAmenityId());                 // null/0 => create
        params.put("p_Amenity_Id", req.getAmenityId());
        params.put("p_Production_Location_Id", req.getProductionLocationId());       // NULL allowed
        params.put("p_Square_Footage", req.getSquareFootage());
        params.put("p_Max_Capacity_Standing", req.getMaxCapacityStanding());
        params.put("p_Max_Capacity_Sitting", req.getMaxCapacitySitting());
        params.put("p_Max_Capacity_Round_Table", req.getMaxCapacityRoundTable());
        params.put("p_Is_General_Admission_Included", req.getIsGeneralAdmissionIncluded()); // BIT
        executeVoid("usp_Upsert_Rental_Amenity", params);
    }
}



