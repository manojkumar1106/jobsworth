package hlt.promo.engine.service;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import hlt.promo.engine.client.PromotionApiClient;
import hlt.promo.engine.dto.ApiResponse;
import hlt.promo.engine.dto.CreatePromotionRequest;
import hlt.promo.engine.exception.ValidationException;
import hlt.promo.engine.model.Promotion;
import hlt.promo.engine.model.PromotionStatus;
import hlt.promo.engine.util.TimezoneConverter;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.sql.Timestamp;
import java.time.LocalDateTime;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

@Service
@RequiredArgsConstructor
@Slf4j
public class PromotionServiceNew {

    private final PromotionApiClient promotionApiClient;
    private final DroolsRuleService droolsRuleService;
    private final DroolsEngineService droolsEngineService;

    @jakarta.transaction.Transactional // no-op now the DB call is remote; keep only if you still have local side-effects to roll back
    public void createPromotion(CreatePromotionRequest request) {

        if (!request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        Map<String, Object> existing = promotionApiClient.getPromotionByCode(
                request.getSessionKey(), request.getPromoCode());
        if (existing != null && !existing.isEmpty()) {
            throw new ValidationException("Promo code '" + request.getPromoCode() + "' already exists");
        }

        String timezone = promotionApiClient.getTimezone(
                request.getSessionKey(), request.getLocationId().intValue());

        request.setStartDate(TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
        request.setEndDate(TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());

        Map<String, Object> promotion = promotionApiClient.createPromotion(request.getSessionKey(), request);

        Promotion promotion1 = new Promotion();
        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.registerModule(new JavaTimeModule());
        Promotion promotionObj = objectMapper.convertValue(promotion, Promotion.class);

        log.info("Promotion created location={} amenity={} promoCode={}",
                request.getLocationId(), request.getAmenityId(), request.getPromoCode());

        if (PromotionStatus.PUBLISHED.name().equals(request.getPromoStatus())) {
            droolsRuleService.generatePromotionRule(promotionObj, "ADMIN", request.getSessionKey());
        }
    }

    @jakarta.transaction.Transactional
    public void updatePromotion(CreatePromotionRequest request) {

        // Everything else is optional - only validate ordering if both dates were sent.
        if (request.getStartDate() != null && request.getEndDate() != null
                && !request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        // Only need timezone conversion if a date is actually being updated
        if (request.getStartDate() != null || request.getEndDate() != null) {
            if (request.getLocationId() == null) {
                throw new ValidationException("locationId is required to resolve timezone when updating start/end date");
            }
            String timezone = promotionApiClient.getTimezone(
                    request.getSessionKey(), request.getLocationId().intValue());

            if (request.getStartDate() != null) {
                request.setStartDate(TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
            }
            if (request.getEndDate() != null) {
                request.setEndDate(TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());
            }
        }

        Map<String, Object> promotion = promotionApiClient.updatePromotion(request.getSessionKey(), request);

        ObjectMapper objectMapper = new ObjectMapper();
        objectMapper.registerModule(new JavaTimeModule());
        Promotion promotionObj = objectMapper.convertValue(promotion, Promotion.class);

        log.info("Promotion updated promotionId={} location={} amenity={} promoCode={}",
                request.getPromotionId(), request.getLocationId(), request.getAmenityId(), request.getPromoCode());

        if (PromotionStatus.PUBLISHED.name().equals(request.getPromoStatus())) {
            droolsRuleService.generatePromotionRule(promotionObj, "ADMIN", request.getSessionKey());
        } else if (PromotionStatus.INACTIVE.name().equals(request.getPromoStatus())) {
            droolsRuleService.deactivateRuleDefinition("PROMOTION", request.getPromotionId(), null, request.getSessionKey());
        }
    }

    public List<Map<String, Object>> getAllPromotions(String sessionKey) {
        log.info("Fetching promotions for session: {}", sessionKey);
        List<Map<String, Object>> promotions = promotionApiClient.getAllPromotions(sessionKey);

        Map<Long, String> timezoneCache = new HashMap<>();
        for (Map<String, Object> promo : promotions) {
            Object locationIdObj = promo.get("locationId");
            if (locationIdObj == null) continue;
            Long locationId = ((Number) locationIdObj).longValue();

            String timezone = timezoneCache.computeIfAbsent(locationId,
                    id -> promotionApiClient.getTimezone(sessionKey, id.intValue()));

            if (promo.get("startDate") != null) {
                promo.put("startDate",
                        TimezoneConverter.toLocal(asLocalDateTime(promo.get("startDate")), timezone));
            }
            if (promo.get("endDate") != null) {
                promo.put("endDate",
                        TimezoneConverter.toLocal(asLocalDateTime(promo.get("endDate")), timezone));
            }
        }
        return promotions;
    }

    public Map<String, Object> getPromotionByCode(String sessionKey, String promoCode) {
        log.info("Fetching promotion by code: {}", promoCode);
        Map<String, Object> promo = promotionApiClient.getPromotionByCode(sessionKey, promoCode);

        if (promo != null && promo.get("locationId") != null) {
            String timezone = promotionApiClient.getTimezone(
                    sessionKey, ((Number) promo.get("locationId")).intValue());

            if (promo.get("startDate") != null) {
                promo.put("startDate", TimezoneConverter.toLocal(asLocalDateTime(promo.get("startDate")), timezone));
            }
            if (promo.get("endDate") != null) {
                promo.put("endDate", TimezoneConverter.toLocal(asLocalDateTime(promo.get("endDate")), timezone));
            }
        }
        return promo;
    }

    /** Handles Timestamp (legacy) and ISO String (over HTTP from hlt-api). */
    private LocalDateTime asLocalDateTime(Object value) {
        if (value == null) return null;
        if (value instanceof LocalDateTime) return (LocalDateTime) value;
        if (value instanceof Timestamp) return ((Timestamp) value).toLocalDateTime();
        if (value instanceof String) return LocalDateTime.parse((String) value);
        return null;
    }

    @jakarta.transaction.Transactional
    public ApiResponse<String> removePromotion(Integer promotionId, String sessionKey) {

        // API side removes the promotion row and its rule definitions atomically.
        Map<String, Object> result = promotionApiClient.removePromotion(promotionId, sessionKey);
        log.info("Promotion {} removed. Rule rows affected: {}", promotionId, result.get("ruleResult"));

        droolsEngineService.reloadRules();
        log.info("Rules reloaded after removing promotion id={}", promotionId);

        return ApiResponse.success("Promotion removed", null);
    }
}



