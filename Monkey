@Operation(summary = "Get Rental Amenities")
@PostMapping("/list")
public ApiResponse<List<Map<String, Object>>> getRentalAmenities(@RequestBody TicketRequest req,
                                                                 @AuthenticationPrincipal Jwt jwt) {
    if (jwt != null) {
        req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
    }
    return ApiResponse.success("Rental Amenities", rentalAmenityService.getRentalAmenities(req));
}


