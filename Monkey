// src/service/physicaladdress/physicalAddressService.ts

import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../utils/commonValidator";
import { httpClient } from "../../utils/http/httpClient";
import {
  createPhysicalAddressRules,
  updatePhysicalAddressRules,
  getPhysicalAddressRules,
} from "../../schema/physicaladdress/validators/physicalAddressValidator";

async function callAddressData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/physicaladdress${endpoint}`;

  return await httpClient(
    url,
    {
      method: method,
      body: request,
    },
    context.logger,
    context
  );
}

export async function createPhysicalAddress(request: any, context: any) {
  return await callAddressData("POST", "/create", request, context, createPhysicalAddressRules);
}

export async function updatePhysicalAddress(request: any, context: any) {
  return await callAddressData("PUT", "/update", request, context, updatePhysicalAddressRules);
}

export async function getPhysicalAddress(request: any, context: any) {
  return await callAddressData("POST", "/getbylocation", request, context, getPhysicalAddressRules);
}
