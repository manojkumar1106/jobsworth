export const priceTypeTypeDefs = `
  input CreatePriceType {
    locationFunctionId: Int!
    priceTypeName: String!
    priceTypeDescription: String
    basePrice: Float!
  }

  input UpdatePriceType {
    locationFunctionId: Int!
    priceTypeId: Int!
    priceTypeName: String!
    priceTypeDescription: String
    basePrice: Float!
  }

  input DeletePriceType {
    priceTypeId: Int!
  }

  input GetLocationPriceType {
    locationFunctionId: Int!
  }

  type Mutation {
    createPriceType(request: CreatePriceType): SessionResponse
    updatePriceType(request: UpdatePriceType): SessionResponse
    deletePriceType(request: DeletePriceType): SessionResponse
  }

  type Query {
    getLocationPriceType(request: GetLocationPriceType): SessionResponse
  }
`;



import {
  createPriceType,
  updatePriceType,
  deletePriceType,
  getLocationPriceType,
} from "../../service/pricetype/priceTypeService";

export const priceTypeResolvers = {
  Mutation: {
    createPriceType: async (_: any, { request }: any, ctx: any) => {
      ctx.logger.info("Create Price Type", { request });
      return await createPriceType(request, ctx);
    },
    updatePriceType: async (_: any, { request }: any, ctx: any) => {
      ctx.logger.info("Update Price Type", { request });
      return await updatePriceType(request, ctx);
    },
    deletePriceType: async (_: any, { request }: any, ctx: any) => {
      ctx.logger.info("Delete Price Type", { request });
      return await deletePriceType(request, ctx);
    },
  },
  Query: {
    getLocationPriceType: async (_: any, { request }: any, ctx: any) => {
      ctx.logger.info("Get Location Price Type", { request });
      return await getLocationPriceType(request, ctx);
    },
  },
};


import { httpClient } from "../../utils/http/httpClient";

async function callPriceTypeData(method: string, endpoint: string, request: any, context: any) {
  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/price-types${endpoint}`;
  return await httpClient(
    url,
    {
      method: method,
      body: request,
    },
    context.logger,
    context
  );
}

export async function createPriceType(request: any, context: any) {
  return await callPriceTypeData("POST", "/create", request, context);
}

export async function updatePriceType(request: any, context: any) {
  return await callPriceTypeData("POST", "/update", request, context);
}

export async function deletePriceType(request: any, context: any) {
  return await callPriceTypeData("DELETE", "/delete", request, context);
}

export async function getLocationPriceType(request: any, context: any) {
  return await callPriceTypeData("POST", "/get", request, context);
}

