// src/schema/salesfunnel/validators/salesFunnelValidator.ts

import { FieldRule } from "../../../utils/commonValidator";

// Local shorthand so the same integer rule is not repeated for every ID
const requiredInteger: FieldRule = {
  type: "integer",
  required: true,
};

// Fields shared by create and update
const salesFunnelBaseRules: Record<string, FieldRule> = {
  locationId: requiredInteger,

  salesFunnelName: {
    type: "string",
    required: true,
    maxLength: 100,
  },

  urlSlug: {
    type: "string",
    required: true,
  },

  isActive: {
    type: "boolean",
    required: true,
  },

  isDateRequired: {
    type: "boolean",
    required: true,
  },

  salesCutoffLocalTime: {
    type: "string",
    required: false,
    pattern: /^(?:[01]\d|2[0-3]):[0-5]\d:[0-5]\d$/,
    patternMessage: "salesCutoffLocalTime must be in HH:mm:ss format",
  },

  isWebEnabled: {
    type: "boolean",
    required: true,
  },

  isPosEnabled: {
    type: "boolean",
    required: true,
  },

  amenityIds: {
    type: "integerArray",
    required: false,
  },
};

// CreateSalesFunnel input: base fields + locationFunctionId
export const createSalesFunnelRules: Record<string, FieldRule> = {
  ...salesFunnelBaseRules,
  locationFunctionId: requiredInteger,
};

// UpdateSalesFunnel input: base fields + salesFunnelId
export const updateSalesFunnelRules: Record<string, FieldRule> = {
  ...salesFunnelBaseRules,
  salesFunnelId: requiredInteger,
};

// DeleteSalesFunnel input
export const deleteSalesFunnelRules: Record<string, FieldRule> = {
  salesFunnelId: requiredInteger,
};

// GetFunnelAmenities input
export const getFunnelAmenitiesRules: Record<string, FieldRule> = {
  locationFunctionId: requiredInteger,
};

// GetLocationSalesFunnel input
export const getLocationSalesFunnelRules: Record<string, FieldRule> = {
  locationId: requiredInteger,
  locationFunctionId: requiredInteger,
};

// GetSalesFunnelDetails input
export const getSalesFunnelDetailsRules: Record<string, FieldRule> = {
  locationId: requiredInteger,
  salesFunnelId: requiredInteger,
};




// src/service/salesfunnel/salesFunnelService.ts

import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../utils/commonValidator";
import { httpClient } from "../../utils/http/httpClient";
import {
  createSalesFunnelRules,
  updateSalesFunnelRules,
  deleteSalesFunnelRules,
  getFunnelAmenitiesRules,
  getLocationSalesFunnelRules,
  getSalesFunnelDetailsRules,
} from "../../schema/salesfunnel/validators/salesFunnelValidator";

async function callFunnelData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/funnels${endpoint}`;

  return await httpClient(
    url,
    {
      method: method,
      body: request,
    },
    context.logger,
    context
  );
}

export async function createSalesFunnel(request: any, context: any) {
  return await callFunnelData("POST", "/create", request, context, createSalesFunnelRules);
}

export async function updateSalesFunnel(request: any, context: any) {
  return await callFunnelData("POST", "/update", request, context, updateSalesFunnelRules);
}

export async function deleteSalesFunnel(request: any, context: any) {
  return await callFunnelData("DELETE", "/delete", request, context, deleteSalesFunnelRules);
}

export async function getFunnelAmenities(request: any, context: any) {
  return await callFunnelData("POST", "/amenities", request, context, getFunnelAmenitiesRules);
}

export async function getSalesFunnel(request: any, context: any) {
  return await callFunnelData("POST", "/get", request, context, getLocationSalesFunnelRules);
}

export async function getSalesFunnelDetails(request: any, context: any) {
  return await callFunnelData("POST", "/details", request, context, getSalesFunnelDetailsRules);
}
