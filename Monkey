Map<String, Object> promotion = promotionApiClient.updatePromotion(request.getSessionKey(), request);

if (promotion == null || promotion.isEmpty()) {
    // the update proc returned no row - read the promotion back
    promotion = promotionApiClient.getPromotionByCode(request.getSessionKey(), request.getPromoCode());
}
if (promotion == null || promotion.isEmpty()) {
    throw new ValidationException("Promotion not found after update, id=" + request.getPromotionId());
}

ObjectMapper objectMapper = new ObjectMapper();
objectMapper.registerModule(new JavaTimeModule());
Promotion promotionObj = objectMapper.convertValue(promotion, Promotion.class);
