private List<AmenityPriceTypeItem> priceTypes;

public static class AmenityPriceTypeItem {
    private String amenityPriceTypeName;
    private java.math.BigDecimal amenityBasePrice;

    public String getAmenityPriceTypeName() { return amenityPriceTypeName; }
    public void setAmenityPriceTypeName(String v) { this.amenityPriceTypeName = v; }
    public java.math.BigDecimal getAmenityBasePrice() { return amenityBasePrice; }
    public void setAmenityBasePrice(java.math.BigDecimal v) { this.amenityBasePrice = v; }
}


@Override
public Integer createAmenityPriceType(TicketRequest req) {
    List<TicketRequest.AmenityPriceTypeItem> list = req.getPriceTypes();

    if (list == null || list.isEmpty() || list.size() > 15) {
        throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Provide 1 to 15 price types");
    }

    String priceTypeList = list.stream()
        .map(p -> p.getAmenityPriceTypeName().replaceAll("[,|]", "").trim()
                + "," + p.getAmenityBasePrice().setScale(2, RoundingMode.HALF_UP).toPlainString())
        .collect(Collectors.joining("|"));

    return amenityPriceTypeDao.createAmenityPriceType(req, priceTypeList);
}
