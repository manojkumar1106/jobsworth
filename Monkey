@Override
public List<Map<String, Object>> getRentalAmenities(TicketRequest req) {
    List<Map<String, Object>> flatRows = rentalAmenityDao.getRentalAmenities(req);

    Map<Object, List<Map<String, Object>>> rowsByLocation = flatRows.stream()
            .collect(Collectors.groupingBy(r -> r.get("locationId"), LinkedHashMap::new, Collectors.toList()));

    List<Map<String, Object>> response = new ArrayList<>();
    rowsByLocation.forEach((locationId, rows) -> {
        Map<String, Object> group = new LinkedHashMap<>();
        group.put("locationId", locationId);
        group.put("locationName", rows.get(0).get("locationName"));
        group.put("amenities", rows.stream()
                .map(r -> Map.of("amenityId", r.get("amenityId"), "amenityName", r.get("amenityName")))
                .toList());
        response.add(group);
    });
    return response;
}
