@RestController
@RequestMapping("/api/v1/customer/rental-amenities")
@RequiredArgsConstructor
public class RentalAmenityController {

    private final IRentalAmenityService rentalAmenityService;

    @Operation(summary = "Create / Update Rental Amenity")
    @PostMapping("/upsert")
    public ApiResponse<Void> upsertRentalAmenity(@RequestBody TicketRequest req,
                                                 @AuthenticationPrincipal Jwt jwt) {
        if (jwt != null) {
            req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
        }
        rentalAmenityService.upsertRentalAmenity(req);
        return ApiResponse.success("Rental Amenity Saved", null);
    }
}




