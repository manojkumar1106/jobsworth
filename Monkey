package hlt.promo.engine.rules;

import hlt.promo.engine.dto.Cart;
import hlt.promo.engine.dto.CartItem;
import hlt.promo.engine.dto.DiscountResult;

rule "PROMO_AUTO_109"
    salience 60
    no-loop true
when
    $result : DiscountResult(
        promoStackLocked == false,
        isRuleAlreadyFired("PROMO_AUTO_109") == false
    )
    $cart : Cart(
        cartTotal > 0,
        currentDateTime != null,
        currentDateTime >= java.time.LocalDateTime.of(2026, 10, 28, 18, 25, 0),
        currentDateTime != null,
        currentDateTime <= java.time.LocalDateTime.of(2026, 11, 5, 22, 25, 0),
        userType != null,
        userType == "MEMBER"
    )
then
    double discount = Math.min(5.0, $cart.getCartTotal());
    $result.addPromoDiscount("PROMO_AUTO_109", "AUTOMATIC PROMOTION", discount);
    $result.setPromoStackLocked(true);
    update($result);
end



Part	Meaning
salience	Derived from Priority through convertPriority. Higher salience fires first. Priority 3 produced salience 60 in the example. [CONFIRM] the full mapping.
no-loop true	The rule cannot re-trigger itself when it calls update.
promoStackLocked == false	A non-stackable rule that already fired locks later promotions out.
isRuleAlreadyFired(name)	Prevents the same rule from applying twice.
Date window	Start and end are converted to UTC and written as literals. The cart's currentDateTime is compared with them.
userType	Added only for Members ("MEMBER") or Non-Members. No condition for All Users.
then block	Flat: Math.min(amount, cartTotal). Percentage: cartTotal * pct / 100. Full cart or amenity scope changes which total is used.
setPromoStackLocked(true)	Present for non-stackable promotions.
