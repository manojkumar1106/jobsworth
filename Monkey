@Repository
public class PriceTypeDao extends BaseDao {

    public Integer createPriceType(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Location_Function_Id", req.getLocationFunctionId());
        params.put("p_Price_Type_Name", req.getPriceTypeName());
        params.put("p_Price_Type_Description", req.getPriceTypeDescription());
        params.put("p_Base_Price", req.getBasePrice());
        return executeAndReturnId("usp_Create_Price_Type", "Price_Type_Id", params);
    }

    public Integer updatePriceType(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Location_Function_Id", req.getLocationFunctionId());
        params.put("p_Price_Type_Id", req.getPriceTypeId());
        params.put("p_Price_Type_Name", req.getPriceTypeName());
        params.put("p_Price_Type_Description", req.getPriceTypeDescription());
        params.put("p_Base_Price", req.getBasePrice());
        return executeAndReturnId("usp_Update_Price_Type", "Price_Type_Id", params);
    }

    public List<Map<String, Object>> getLocationPriceType(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Location_Function_Id", req.getLocationFunctionId());
        return executeList("usp_Get_Location_Price_Type", params);
    }
}



