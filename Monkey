public CreateSystemDiscountResponse createSystemDiscount(CreateSystemDiscountRequest request) {

        if (!request.getStartDate().isBefore(request.getEndDate())) {
            throw new ValidationException("Start date must be before end date");
        }

        String timezone = promoEngineApiClient.getTimezone(
                request.getSessionKey(), request.getLocationId().intValue());

        request.setStartDate(TimezoneConverter.toUtc(request.getStartDate(), timezone).toLocalDateTime());
        request.setEndDate(TimezoneConverter.toUtc(request.getEndDate(), timezone).toLocalDateTime());

        Map<String, Object> systemDiscount = promoEngineApiClient.createSystemDiscount(request.getSessionKey(), request);
        if (systemDiscount == null || systemDiscount.isEmpty()) {
            throw new IllegalArgumentException("System discount was saved but no row came back");
        }

        SystemDiscount sdObj = mapper().convertValue(systemDiscount, SystemDiscount.class);

        log.info("Created system discount id={} location={} amenity={}",
                sdObj.getId(), request.getLocationId(), request.getAmenityId());

        boolean needsApproval = Boolean.TRUE.equals(request.getManagerApprovalRequired());
        boolean isDraft = "DRAFT".equalsIgnoreCase(request.getSystemDiscountStatus());

        if (isDraft) {
            // DRAFT -> saved only, no Drools rule
            log.info("Created system discount id={} status=DRAFT. No Drools.", sdObj.getId());
            return new CreateSystemDiscountResponse(sdObj.getId(), "DRAFT");
        }

        if (needsApproval) {
            // TRUE -> PENDING, no Drools
            log.info("Created system discount id={} status=PENDING_APPROVAL. No Drools.", sdObj.getId());
            return new CreateSystemDiscountResponse(sdObj.getId(), "PENDING_APPROVAL");
        }

        // FALSE and not draft -> PUBLISHED, generate Drools
        droolsRuleService.generateSystemDiscountRule(sdObj, "ADMIN", request.getSessionKey());
        log.info("Created system discount id={} status=PUBLISHED. Drools generated.", sdObj.getId());
        return new CreateSystemDiscountResponse(sdObj.getId(), "PUBLISHED");
    }
