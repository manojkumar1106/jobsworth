package com.hlt.api.promotion.dao;

import org.springframework.stereotype.Repository;

import java.util.HashMap;
import java.util.Map;

@Repository
public class PromoUsageDao extends PromoEngineBaseDao {

    // usePromo/getUsageSummary take explicit scalar args already, not a body map, so no key-casing risk here.
    public void usePromo(String sessionKey, String promoCode, Integer customerId,
                         Integer usageLimit, Integer maxUsagePerCustomer) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", sessionKey);
        params.put("p_Promo_Code", promoCode);
        params.put("p_Customer_Id", customerId);
        params.put("p_Usage_Limit", usageLimit);
        params.put("p_Max_Usage_Per_Customer", maxUsagePerCustomer);
        executeVoid("usp_Use_Promo", params);
    }

    public Map<String, Object> getUsageSummary(String promoCode, Integer customerId) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Promo_Code", promoCode);
        params.put("p_Customer_Id", customerId);
        Map<String, Object> out = call("usp_Get_Promo_Usage_Summary").execute(params);
        validatePromoResultCode(out, "usp_Get_Promo_Usage_Summary");

        Map<String, Object> result = new HashMap<>();
        result.put("totalUsage", ((Number) out.get("p_Total_Usage")).intValue());
        result.put("customerUsage", ((Number) out.get("p_Customer_Usage")).intValue());
        return result;
    }
}
