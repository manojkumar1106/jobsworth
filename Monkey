@Operation(summary = "Get Rental Amenity Details")
@PostMapping("/details/get")
public ApiResponse<Map<String, Object>> getRentalAmenityDetails(@RequestBody TicketRequest req,
                                                                @AuthenticationPrincipal Jwt jwt) {
    if (jwt != null) {
        req.setSessionKey(jwt.getClaims().get("origin_jti").toString());
    }
    return ApiResponse.success("Rental Amenity Details", rentalAmenityService.getRentalAmenityDetails(req));
}


