}



@Slf4j
@Service
@RequiredArgsConstructor
public class CustomerParkingAmenityService implements ICustomerParkingAmenityService {

    private final CustomerParkingAmenityDao customerParkingAmenityDao;

    @Override
    public List<Map<String, Object>> getLocationParkingDetails(TicketRequest req) {
        String tz = req.getTimezone();
        TimezoneConverter.validateTimezone(tz);

        List<List<Map<String, Object>>> resultSets = customerParkingAmenityDao.getLocationParkingDetails(req);
        List<Map<String, Object>> parkingRows  = resultSets.get(0);
        List<Map<String, Object>> scheduleRows = resultSets.get(1);
        List<Map<String, Object>> priceRows    = resultSets.get(2);

        // schedules: group by amenityId, UTC -> local
        Map<Object, List<Map<String, Object>>> schedulesByAmenity = new HashMap<>();
        for (Map<String, Object> row : scheduleRows) {
            if (row.get("amenityScheduleId") == null) continue;          // amenity without schedule
            Map<String, Object> schedule = ScheduleTimezoneUtil.scheduleToLocal(row, tz);
            if (row.get("allScheduleDates") != null) {
                schedule.put("allScheduleDates", ScheduleTimezoneUtil.datesToLocal(row.get("allScheduleDates"), tz));
            }
            schedulesByAmenity.computeIfAbsent(row.get("amenityId"), k -> new ArrayList<>()).add(schedule);
        }

        // price types: group by amenityId (no dates, no conversion)
        Map<Object, List<Map<String, Object>>> pricesByAmenity = new HashMap<>();
        for (Map<String, Object> row : priceRows) {
            if (row.get("amenityPriceTypeId") == null) continue;         // amenity without price type
            pricesByAmenity.computeIfAbsent(row.get("amenityId"), k -> new ArrayList<>()).add(row);
        }

        // one object per parking amenity
        List<Map<String, Object>> response = new ArrayList<>();
        for (Map<String, Object> parking : parkingRows) {
            Map<String, Object> item = new LinkedHashMap<>(parking);
            item.put("schedules",  schedulesByAmenity.getOrDefault(parking.get("amenityId"), new ArrayList<>()));
            item.put("priceTypes", pricesByAmenity.getOrDefault(parking.get("amenityId"), new ArrayList<>()));
            response.add(item);
        }
        return response;      // read-only, so no @Transactional
    }
}

