package com.hlt.api.promotion.controller;

import com.hlt.api.promotion.service.IPromotionApiService;
import com.hlt.api.promotion.dto.PromoRequest;
import lombok.RequiredArgsConstructor;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.List;
import java.util.Map;

/** Timezone, rule history, promo usage and discount audit endpoints. */
@RestController
@RequestMapping("/api/v1")
@RequiredArgsConstructor
public class PromoSupportController {

    private final IPromotionApiService service;

    @GetMapping("/locations/{locationId}/timezone")
    public ResponseEntity<String> timezone(@RequestHeader("X-Session-Key") String sessionKey,
                                           @PathVariable Integer locationId) {
        String tz = service.getTimezone(sessionKey, locationId);
        return tz != null ? ResponseEntity.ok(tz) : ResponseEntity.notFound().build();
    }

    @PostMapping("/rule-history")
    public ResponseEntity<Map<String, Object>> ruleHistory(@RequestHeader("X-Session-Key") String sessionKey,
                                                           @RequestBody PromoRequest body) {
        return ResponseEntity.status(HttpStatus.CREATED).body(service.createRuleHistory(body, sessionKey));
    }

    @PostMapping("/promo-usage/use")
    public ResponseEntity<Void> usePromo(@RequestHeader("X-Session-Key") String sessionKey,
                                         @RequestBody PromoRequest body) {
        service.usePromo(sessionKey, body);
        return ResponseEntity.noContent().build();
    }

    @GetMapping("/promo-usage/summary")
    public ResponseEntity<Map<String, Object>> usageSummary(@RequestParam String promoCode,
                                                            @RequestParam Integer customerId) {
        return ResponseEntity.ok(service.getUsageSummary(promoCode, customerId));
    }

    @PostMapping("/discount-audit-logs")
    public ResponseEntity<Map<String, Object>> createAudit(@RequestHeader("X-Session-Key") String sessionKey,
                                                           @RequestBody PromoRequest body) {
        return ResponseEntity.status(HttpStatus.CREATED).body(service.createDiscountAuditLog(body, sessionKey));
    }

    @GetMapping("/discount-audit-logs")
    public ResponseEntity<List<Map<String, Object>>> auditByCustomer(@RequestHeader("X-Session-Key") String sessionKey,
                                                                     @RequestParam String customerId) {
        return ResponseEntity.ok(service.getAuditLogsByCustomer(sessionKey, customerId));
    }
}



package com.hlt.api.promotion.service;

