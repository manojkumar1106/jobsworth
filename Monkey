package com.hlt.api.service.serviceimpl;

import com.hlt.api.dao.ParkingAmenityDao;
import com.hlt.api.service.IParkingAmenityService;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
// TODO: import TicketRequest

@Slf4j
@Service
@RequiredArgsConstructor
public class ParkingAmenityService implements IParkingAmenityService {

    private final ParkingAmenityDao parkingAmenityDao;

    @Override
    @Transactional
    public Map<String, Object> upsertParkingAmenity(TicketRequest req) {
        log.info("Upserting parking amenity for amenityId: {}", req.getAmenityId());

        // The proc returns the new Parking_Amenity_Id only on insert; on update it returns no rows.
        List<Map<String, Object>> rows = parkingAmenityDao.upsertParkingAmenity(req);
        Object parkingAmenityId = rows.isEmpty()
                ? req.getParkingAmenityId()
                : rows.get(0).values().iterator().next();

        Map<String, Object> result = new LinkedHashMap<>();
        result.put("parkingAmenityId", parkingAmenityId);
        return result;
    }

    @Override
    public List<Map<String, Object>> getParkingAmenityDetails(TicketRequest req) {
        log.info("Getting parking amenity details for amenityId: {}", req.getAmenityId());
        // Empty list when parking is not configured yet (the proc does not return an error). No dates, read-only.
        return parkingAmenityDao.getParkingAmenityDetails(req);
    }
}



package com.hlt.api.dao;

import org.springframework.stereotype.Repository;

import java.util.HashMap;
import java.util.List;
import java.util.Map;
// TODO: import TicketRequest

@Repository
public class ParkingAmenityDao extends BaseDao {

    // client1.usp_Upsert_Parking_Amenity
    // Returns one row (the new Parking_Amenity_Id) when inserting, no rows when updating.
    // p_Result_Code (OUT): 1 ok, -2 session, -3 permission, -4 parameter
    //   (null amenity / is onsite, amenity not in location function, unknown parking id, parking already configured)
    // The proc already turns 0 into NULL for the ids, so null or 0 both work.
    public List<Map<String, Object>> upsertParkingAmenity(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Location_Function_Id", req.getLocationFunctionId());
        params.put("p_Amenity_Id", req.getAmenityId());
        params.put("p_Parking_Amenity_Id", req.getParkingAmenityId());
        params.put("p_Is_Onsite", req.getIsOnsite());
        params.put("p_Parking_URL", req.getParkingUrl());
        return executeList("usp_Upsert_Parking_Amenity", params);   // placeholder: use your BaseDao list method
    }

    // client1.usp_Get_Parking_Amenity_Details
    // Result set: Parking_Amenity_Id, Is_Onsite, Parking_URL (no rows if not configured)
    public List<Map<String, Object>> getParkingAmenityDetails(TicketRequest req) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", req.getSessionKey());
        params.put("p_Amenity_Id", req.getAmenityId());
        return executeList("usp_Get_Parking_Amenity_Details", params);   // placeholder: use your BaseDao list method
    }
}




