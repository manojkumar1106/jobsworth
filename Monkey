@Override
public List<Map<String, Object>> getSalesFunnel(TicketRequest req) {
    log.info("Fetching Sales Funnels for locationFunctionId: {}", req.getLocationFunctionId());

    List<Map<String, Object>> rows = salesFunnelDao.getSalesFunnel(req);
    if (rows == null || rows.isEmpty()) {
        throw new IllegalArgumentException(
                "Sales funnel not found for locationFunctionId=" + req.getLocationFunctionId());
    }

    String timezone = salesFunnelDao.getTimezoneByLocation(req);
    TimezoneConverter.validateTimezone(timezone);

    List<Map<String, Object>> result = new ArrayList<>();
    for (Map<String, Object> row : rows) {
        Map<String, Object> funnel = new LinkedHashMap<>(row);

        Object utcValue = funnel.get("todayCutoffTimeUtc");
        if (utcValue != null) {
            LocalTime utcTime = LocalTime.parse(utcValue.toString());
            LocalDateTime utcDateTime = LocalDate.now(ZoneId.of("UTC")).atTime(utcTime);
            LocalDateTime localDateTime = TimezoneConverter.toLocal(utcDateTime, timezone);
            funnel.put("salesCutoffLocalTime", localDateTime.toLocalTime().toString());
        }

        funnel.remove("todayCutoffTimeUtc");
        result.add(funnel);
    }
    return result;
}
