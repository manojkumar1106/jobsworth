// src/schema/rentals/validators/rentalAmenityValidator.ts
import { FieldRule } from "../../../utils/commonValidator";

const requiredInteger: FieldRule = {
  type: "integer",
  required: true,
};

const optionalInteger: FieldRule = {
  type: "integer",
  required: false,
};

// UpsertRentalAmenity input
export const upsertRentalAmenityRules: Record<string, FieldRule> = {
  rentalAmenityId: optionalInteger,        // Int (nullable): absent for new, present for existing
  amenityId: requiredInteger,              // Int!
  locationFunctionId: requiredInteger,     // Int!
  productionLocationId: optionalInteger,   // Int (nullable): NULL if location has no production function/configuration
  squareFootage: requiredInteger,          // Int!
  maxCapacityStanding: requiredInteger,    // Int!
  maxCapacitySitting: requiredInteger,     // Int!
  maxCapacityRoundTable: requiredInteger,  // Int!
  isGeneralAdmissionIncluded: {
    type: "boolean",                       // Boolean!
    required: true,
  },
};
