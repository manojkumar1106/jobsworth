// src/schema/location/validators/locationValidator.ts

import { FieldRule } from "../../../utils/commonValidator";

// Local shorthand so the same rules are not repeated in every input
const requiredInteger: FieldRule = {
  type: "integer",
  required: true,
};

// "type" is a required string in every location input
const requiredType: FieldRule = {
  type: "string",
  required: true,
  maxLength: 50,
};

// AddLocation input (used by addLocation and addClientLocation)
export const addLocationRules: Record<string, FieldRule> = {
  type: requiredType,

  locationName: {
    type: "string",
    required: true,
    maxLength: 100,
  },

  parentLocationId: {
    type: "integer",
    required: false,
  },
};

// DeleteLocation input (used by removeLocation, updatePlan and all the get queries)
export const deleteLocationRules: Record<string, FieldRule> = {
  type: requiredType,
  locationId: requiredInteger,

  clientPlanId: {
    type: "integer",
    required: false,
  },
};

// PaymentProvider input (updatePaymentProvider)
export const paymentProviderRules: Record<string, FieldRule> = {
  type: requiredType,
  locationId: requiredInteger,
  paymentProviderId: requiredInteger,
};

// LocationFunction input (upsertLocationFunction)
export const locationFunctionRules: Record<string, FieldRule> = {
  type: requiredType,
  locationId: requiredInteger,
  functionTypeId: requiredInteger,

  isEnabled: {
    type: "boolean",
    required: false,
  },
};

// ClientBilling input (updateClientBilling)
export const clientBillingRules: Record<string, FieldRule> = {
  type: requiredType,
  locationId: requiredInteger,
  merchantId: requiredInteger,
};

// MoveLocation input (moveLocation)
export const moveLocationRules: Record<string, FieldRule> = {
  type: requiredType,
  locationId: requiredInteger,
  parentLocationId: requiredInteger,
};






// src/service/location/locationService.ts

import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../utils/commonValidator";
import { httpClient } from "../../utils/http/httpClient";
import {
  addLocationRules,
  deleteLocationRules,
  paymentProviderRules,
  locationFunctionRules,
  clientBillingRules,
  moveLocationRules,
} from "../../schema/location/validators/locationValidator";

async function postLocationData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/venue${endpoint}`;

  return await httpClient(
    url,
    {
      method: method,
      body: method === "GET" ? undefined : request,
    },
    context.logger,
    context
  );
}

// ---------- Mutations ----------

export async function addLocation(request: any, context: any) {
  return await postLocationData("POST", "/location", request, context, addLocationRules);
}

export async function addClientLocation(request: any, context: any) {
  return await postLocationData("POST", "/clientlocation", request, context, addLocationRules);
}

export async function removeLocation(request: any, context: any) {
  return await postLocationData("DELETE", "/location", request, context, deleteLocationRules);
}

export async function moveLocation(request: any, context: any) {
  return await postLocationData("POST", "/location/move", request, context, moveLocationRules);
}

export async function updatePlan(request: any, context: any) {
  return await postLocationData("POST", "/plan/update", request, context, deleteLocationRules);
}

export async function updateClientBilling(request: any, context: any) {
  return await postLocationData("POST", "/billing/update", request, context, clientBillingRules);
}

export async function updatePaymentProvider(request: any, context: any) {
  return await postLocationData("POST", "/paymentprovider/update", request, context, paymentProviderRules);
}

export async function upsertLocationFunction(request: any, context: any) {
  return await postLocationData("POST", "/insert/locationfunction", request, context, locationFunctionRules);
}

// ---------- Queries ----------

export async function getLocationDescendents(request: any, context: any) {
  return await postLocationData("POST", "/location/descendents", request, context, deleteLocationRules);
}

export async function getLocationFunctions(request: any, context: any) {
  return await postLocationData("POST", "/location/functions", request, context, deleteLocationRules);
}

export async function getLocationPlan(request: any, context: any) {
  return await postLocationData("POST", "/clientlocation/plan", request, context, deleteLocationRules);
}

export async function getClientPlan(request: any, context: any) {
  return await postLocationData("POST", "/client/plan", request, context, deleteLocationRules);
}

export async function getClientLocationBilling(request: any, context: any) {
  return await postLocationData("POST", "/locationbilling", request, context, deleteLocationRules);
}

export async function getClientPaymentProvider(request: any, context: any) {
  return await postLocationData("POST", "/paymentprovider", request, context, deleteLocationRules);
}
