List<RuleDefinition> activeRules = ruleDefinitionList.stream()
        .filter(RuleDefinition::isActive)
        .filter(r -> {
            boolean ok = r.getRuleName() != null
                    && r.getDrlContent() != null && !r.getDrlContent().isBlank();
            if (!ok) log.warn("Skipping rule id={} name={} - empty DRL/name, regenerate it",
                    r.getId(), r.getRuleName());
            return ok;
        })
        .collect(Collectors.toList());
