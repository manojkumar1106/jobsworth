if (promotion == null || promotion.isEmpty()) {
    String code = request.getPromoCode();
    if (code != null && !code.isBlank()) {
        promotion = promoEngineApiClient.getPromotionByCode(request.getSessionKey(), code);
    } else {
        promotion = promoEngineApiClient.getAllPromotions(request.getSessionKey()).stream()
                .filter(p -> p.get("Promotion_Id") != null
                        && ((Number) p.get("Promotion_Id")).longValue() == request.getPromotionId().longValue())
                .findFirst()
                .orElse(null);
    }
}
