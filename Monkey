// src/service/customer/salesfunnel/salesFunnelService.ts

import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../../utils/commonValidator";
import { httpClient } from "../../../utils/http/httpClient";
import {
  getCustomerSalesFunnelRules,
  getCustomerSalesFunnelDetailsRules,
  getCustomerSalesFunnelAmenitiesRules,
} from "../../../schema/customer/salesfunnel/validators/customerSalesFunnelValidator";

async function callCustomerFunnelData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  let url = `${baseUrl}/api/v1/customer/funnels${endpoint}`;

  if (method === "GET") {
    const queryParams = new URLSearchParams({
      sessionKey: request.sessionKey,
    }).toString();
    url = `${url}?${queryParams}`;
  }

  return await httpClient(
    url,
    {
      method: method,
      body: method === "GET" ? undefined : request,
    },
    context.logger,
    context
  );
}

export async function getCustomerSalesFunnel(request: any, context: any) {
  return await callCustomerFunnelData("GET", "/get", request, context, getCustomerSalesFunnelRules);
}

export async function getCustomerSalesFunnelDetails(request: any, context: any) {
  return await callCustomerFunnelData("POST", "/details", request, context, getCustomerSalesFunnelDetailsRules);
}

export async function getCustomerSalesFunnelAmenities(request: any, context: any) {
  return await callCustomerFunnelData("POST", "/amenities", request, context, getCustomerSalesFunnelAmenitiesRules);
}





