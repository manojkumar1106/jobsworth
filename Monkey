package com.hlt.api.promotion.dao;

import com.hlt.api.promotion.exception.PromoLimitExceededException;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.jdbc.core.simple.SimpleJdbcCall;

import java.sql.Connection;
import java.sql.Timestamp;
import java.time.LocalDateTime;
import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/** Same behaviour as the promo service BaseDao. If hlt-api already has an equivalent, extend that instead. */
public abstract class PromotionBaseDao {

    @Autowired
    protected JdbcTemplate jdbcTemplate;

    protected SimpleJdbcCall call(String procName) {
        String schemaName = jdbcTemplate.execute((Connection conn) -> conn.getCatalog());
        return new SimpleJdbcCall(jdbcTemplate)
                .withCatalogName(schemaName)
                .withProcedureName(procName);
    }

    protected void executeVoid(String procName, Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        validateResultCode(out, procName);
    }

    protected Integer executeReturnId(String procName, String outParamName, Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        validateResultCode(out, procName);
        Object value = out.get(outParamName);
        return value != null ? ((Number) value).intValue() : null;
    }

    protected String executeReturnType(String procName, String outParamName, Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        validateResultCode(out, procName);
        Object value = out.get(outParamName);
        return value != null ? value.toString() : null;
    }

    protected Map<String, Object> executeSingle(String procName, Map<String, Object> params) {
        List<Map<String, Object>> rows = executeList(procName, params);
        return rows.isEmpty() ? null : rows.get(0);
    }

    @SuppressWarnings("unchecked")
    protected List<Map<String, Object>> executeList(String procName, Map<String, Object> params) {
        Map<String, Object> out = call(procName).execute(params);
        validateResultCode(out, procName);
        List<Map<String, Object>> rows = (List<Map<String, Object>>) out.get("#result-set-1");
        if (rows == null) return Collections.emptyList();
        // Timestamp -> LocalDateTime so JSON carries plain ISO strings (no timezone shifting)
        for (Map<String, Object> row : rows) {
            row.replaceAll((k, v) -> v instanceof Timestamp ts ? ts.toLocalDateTime() : v);
        }
        return rows;
    }

    /** Builds proc params from a JSON body using {procParam, jsonKey} pairs. Missing keys become null. */
    protected Map<String, Object> buildParams(String sessionKey, Map<String, Object> body, String[][] mapping) {
        Map<String, Object> params = new HashMap<>();
        params.put("p_Session_Key", sessionKey);
        for (String[] m : mapping) {
            Object v = body != null ? body.get(m[1]) : null;
            if (v instanceof String s && m[0].endsWith("_Date")) {
                v = Timestamp.valueOf(LocalDateTime.parse(s));
            }
            params.put(m[0], v);
        }
        return params;
    }

    protected void validateResultCode(Map<String, Object> out, String procName) {
        Object raw = out.get("p_Result_Code");
        int code = raw != null ? ((Number) raw).intValue() : 0;
        switch (code) {
            case 1:
                return;
            case -2:
                throw new SecurityException("Invalid session in " + procName);
            case -3:
                throw new SecurityException("Permission denied in " + procName);
            case -4:
                throw new IllegalArgumentException("Validation failed in " + procName);
            case -5:
                throw new PromoLimitExceededException("Promo usage limit reached (global)");
            case -6:
                throw new PromoLimitExceededException("Promo usage limit reached (per customer)");
            default:
                throw new RuntimeException("DB Error (" + code + ") in " + procName);
        }
    }
