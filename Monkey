package hlt.promo.engine.service;

import hlt.promo.engine.client.AuthClient;
import hlt.promo.engine.client.PromoEngineApiClient;
import hlt.promo.engine.model.EngineConfig;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;

import java.util.List;

@Slf4j
@Service
@RequiredArgsConstructor
public class EngineConfigService {

    private final PromoEngineApiClient promoEngineApiClient;
    private final AuthClient authClient;

    // Get max promos per cart from DB
    // Default fallback = 2 if not found
    public int getMaxPromosPerCart() {
        try {
            EngineConfig c = promoEngineApiClient.getEngineConfig(
                    authClient.createSession(), EngineConfig.MAX_PROMOS_PER_CART);
            return c.getConfigValue() != null ? Integer.parseInt(c.getConfigValue().trim()) : 2;
        } catch (Exception e) {
            log.warn("Could not read {} - using 2: {}", EngineConfig.MAX_PROMOS_PER_CART, e.getMessage());
            return 2;
        }
    }

    // Get all config entries
    public List<EngineConfig> getAll() {
        return promoEngineApiClient.getAllEngineConfig(authClient.createSession());
    }

    // Get config by key
    public EngineConfig getByKey(String key) {
        EngineConfig config = promoEngineApiClient.getEngineConfig(authClient.createSession(), key);
        if (config.getConfigKey() == null) {
            throw new RuntimeException("Config not found: " + key);
        }
        return config;
    }

    // Update config value
    public EngineConfig update(String key, String value, String updatedBy) {
        EngineConfig saved = promoEngineApiClient.updateEngineConfig(
                authClient.createSession(), key, value, updatedBy);
        log.info("Config updated: {}={} by {}", key, value, updatedBy);
        return saved;
    }
}


// ---- add inside PromoEngineApiClient (imports: hlt.promo.engine.model.EngineConfig) ----

private static final ParameterizedTypeReference<EngineConfig> CONFIG = new ParameterizedTypeReference<>() {};
private static final ParameterizedTypeReference<List<EngineConfig>> CONFIG_LIST = new ParameterizedTypeReference<>() {};

// ---------------- engine config ----------------
public List<EngineConfig> getAllEngineConfig(String sessionKey) {
    return get(sessionKey, "/api/v1/engine-config", CONFIG_LIST);
}

/** Returns an EngineConfig with a null configKey when the key does not exist. */
public EngineConfig getEngineConfig(String sessionKey, String key) {
    return get(sessionKey, "/api/v1/engine-config/{k}", CONFIG, key);
}

public EngineConfig updateEngineConfig(String sessionKey, String key, String value, String updatedBy) {
    String by = updatedBy != null ? updatedBy : "ADMIN";
    return execute(() -> hltRestClient.put()
            .uri(b -> b.path("/api/v1/engine-config/{k}")
                    .queryParam("value", "{v}")
                    .queryParam("updatedBy", "{u}")
                    .build(key, value, by))
            .header(SESSION, sessionKey)
            .retrieve()
            .body(CONFIG));
}

