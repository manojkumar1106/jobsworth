@Transactional
public ApiResponse<String> removePromotion(Integer promotionId, String sessionKey) {

    Map<String, Object> promoResponse = promoEngineApiClient.removePromotion(promotionId, sessionKey);
    Integer promoResult = promoResponse != null && promoResponse.get("result") != null
            ? ((Number) promoResponse.get("result")).intValue() : null;

    if (promoResult == null || promoResult == 0) {
        throw new IllegalArgumentException("Promotion not found for id=" + promotionId);
    }

    Integer ruleResult = promoEngineApiClient.removeRuleDefinitionByReference("PROMOTION", promotionId, sessionKey);
    log.info("Promotion {} removed. Rule rows affected: {}", promotionId, ruleResult);

    droolsEngineService.reloadRules();
    log.info("Rules reloaded after removing promotion id={}", promotionId);

    return ApiResponse.success("Promotion removed", null);
}
