// src/service/pricetypes/priceTypeService.ts

import { GraphQLError } from "graphql";
import { FieldRule, validateRequest } from "../../utils/commonValidator";
import { httpClient } from "../../utils/http/httpClient";
import {
  upsertAmenityPriceTypeRules,
  getAmenityPricingRules,
} from "../../schema/pricetypes/validators/priceTypeValidator";

async function callPriceTypeData(
  method: string,
  endpoint: string,
  request: any,
  context: any,
  validationRules?: Record<string, FieldRule>
) {
  if (validationRules) {
    const errors = validateRequest(request, validationRules);

    if (errors.length > 0) {
      throw new GraphQLError(`Validation Failed: ${errors.join(", ")}`, {
        extensions: {
          code: "BAD_USER_INPUT",
          errors,
        },
      });
    }
  }

  const baseUrl = process.env.SPRINGBOOT_BASE_ENDPOINT;
  const url = `${baseUrl}/api/v1/amenity-price-types${endpoint}`;

  return await httpClient(
    url,
    {
      method: method,
      body: method === "GET" ? undefined : request,
    },
    context.logger,
    context
  );
}

//------------Amenity Price Type ---------------

export async function getAmenityPricing(request: any, context: any) {
  return await callPriceTypeData("POST", "/get", request, context, getAmenityPricingRules);
}

export async function getDefaultPriceType(request: any, context: any) {
  return await callPriceTypeData("GET", "/default", request, context);
}

export async function upsertAmenityPriceType(request: any, context: any) {
  return await callPriceTypeData("POST", "/upsert", request, context, upsertAmenityPriceTypeRules);
}


